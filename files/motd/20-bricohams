#!/bin/bash
# BricoHams v4.5 · estado de la estación al entrar por SSH (lo lanza pam_motd con
# /etc/update-motd.d; lo instala «bricohams-banner instalar»). Rápido: sin red ni apt.
# Pruebas: BH_RAIZ=/carpeta y BH_SIN_SYSTEMD=1.
R=${BH_RAIZ:-}
ENV=$R/etc/bricohams/bricohams.env
RUN=$R/run/bricohams
RAKJ=$R/run/bricohams-rak/rak-aprs.json
o=$'\e[38;5;208m'; v=$'\e[32m'; r=$'\e[31m'; a=$'\e[33m'; g=$'\e[90m'; b=$'\e[1m'; n=$'\e[0m'
[ -n "${BH_SIN_COLOR:-}" ] && { o=""; v=""; r=""; a=""; g=""; b=""; n=""; }

envv() { [ -r "$ENV" ] && sed -n "s/^[[:space:]]*$1=[\"']\{0,1\}\([^\"'#]*\).*/\1/p" "$ENV" | head -1 | sed 's/[[:space:]]*$//'; }
jget() {  # jget fichero clave.subclave
    [ -r "$1" ] && python3 -c 'import json,sys
d=json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."):
    d=d.get(k) if isinstance(d,dict) else None
print("" if d is None else d)' "$1" "$2" 2>/dev/null
}
punto() {  # punto nombre estado
    case "$2" in
        active|running|ok) printf '%s●%s %s  ' "$v" "$n" "$1" ;;
        inactive|exited|failed|dead|activating) printf '%s●%s %s  ' "$r" "$n" "$1" ;;
        *) printf '%s○%s %s  ' "$g" "$n" "$1" ;;
    esac
}
servicio() {
    [ -n "${BH_SIN_SYSTEMD:-}" ] && { echo "?"; return; }
    systemctl is-enabled "$1" >/dev/null 2>&1 || { echo "no"; return; }
    systemctl is-active "$1" 2>/dev/null
}

CALL=$(envv CALLSIGN); CALL=${CALL:-BricoHams}
DOM=$(envv SSL_DOMAIN)
BACK=$(envv OWRX_BACKEND); BACK=${BACK:-native}
KITV=$(sed -n 's/^## \[\{0,1\}v\{0,1\}\([0-9][0-9.]*\).*/\1/p' "$R/opt/bricohams/kit/CHANGELOG.md" 2>/dev/null | head -1)

printf '%s' "$o"
cat <<'EOF'
  ___     _        _  _
 | _ )_ _(_)__ ___| || |__ _ _ __  ___
 | _ \ '_| / _/ _ \ __ / _` | '  \(_-<
 |___/_| |_\__\___/_||_\__,_|_|_|_/__/
EOF
printf '%s %s%s · %s%s\n\n' "$n" "$b" "$CALL" "${DOM:-SDR BricoHams}" "$n${KITV:+ · kit v$KITV}"

# ---- sistema
up=$(awk '{d=int($1/86400); h=int($1%86400/3600); m=int($1%3600/60); if(d) printf "%dd %dh", d, h; else printf "%dh %dm", h, m}' "$R/proc/uptime" 2>/dev/null)
carga=$(cut -d' ' -f1-3 "$R/proc/loadavg" 2>/dev/null)
tcpu=$(awk '{printf "%.0f", $1/1000}' "$R/sys/class/thermal/thermal_zone0/temp" 2>/dev/null)
mem=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{if(t) printf "%d", (t-a)*100/t}' "$R/proc/meminfo" 2>/dev/null)
disco=$(df -P "${R:-/}" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')
ip=$( [ -z "$R" ] && hostname -I 2>/dev/null | awk '{print $1}')
tcol=$v; [ "${tcpu:-0}" -ge 70 ] && tcol=$a; [ "${tcpu:-0}" -ge 80 ] && tcol=$r
printf ' %sSistema%s   activo %s · carga %s · CPU %s%s °C%s · RAM %s %% · disco %s %%%s\n' "$b" "$n" "${up:-?}" \
    "${carga:-?}" "$tcol" "${tcpu:-?}" "$n" "${mem:-?}" "${disco:-?}" "${ip:+ · LAN $ip}"

# ---- caja
tc=$(jget "$RUN/caja.json" t_caja); [ -n "$tc" ] || tc=$(jget "$RAKJ" t_caja)
fan=$(jget "$RUN/caja.json" ciclo)
hc=$(jget "$RAKJ" rak.h)
if [ -n "$tc$fan" ]; then
    printf ' %sCaja%s      interior %s °C%s%s\n' "$b" "$n" "${tc:-?}" "${hc:+ · humedad $hc %}" "${fan:+ · ventiladores $fan %}"
fi

# ---- servicios
if [ "$BACK" = docker ]; then
    cont=$(envv OWRX_DOCKER_CONTAINER); cont=${cont:-owrx-mbe}
    st=$( [ -z "${BH_SIN_SYSTEMD:-}" ] && docker inspect -f '{{.State.Status}}' "$cont" 2>/dev/null); owrx=$(punto "OpenWebRX+ (Docker)" "${st:-no}")
else
    owrx=$(punto OpenWebRX+ "$(servicio openwebrx)")
fi
printf ' %sServicios%s %s%s%s%s\n' "$b" "$n" "$owrx" "$(punto nginx "$(servicio nginx)")" "$(punto ADS-B "$(servicio readsb)")" \
    "$(punto Meshtastic-868 "$(servicio meshtasticd)")"
printf '           %s%s%s%s%s\n' "$(punto Mesh-mapa "$(servicio bricohams-mesh-owrx)")" "$(punto iGate-RAK "$(servicio bricohams-rak-aprs)")" "$(punto meteo "$(servicio bricohams-meteo.timer)")" \
    "$(punto fail2ban "$(servicio fail2ban)")" "$(punto cortafuegos "$(servicio bricohams-cortafuegos)")"

# ---- receptores y dispositivos
if command -v bricohams-dispositivos >/dev/null 2>&1 || [ -n "${BH_DISP_JSON:-}" ]; then
    j=${BH_DISP_JSON:-$(timeout 3 bricohams-dispositivos json 2>/dev/null)}
    [ -n "$j" ] && python3 -c '
import json,sys
d=json.loads(sys.argv[1]); v,r,a,g,b,n=sys.argv[2:8]
sdr=[x for x in d["usb"] if x["tipo"] in ("rtlsdr","sdrplay")]
otros=[x for x in d["usb"] if x["tipo"] in ("rak","rak-dfu","lilygo","pico","rs485","camara")]
print(" %sEquipos%s   %s" % (b,n, " · ".join("%s%s%s %s" % (v,"●",n,x.get("rol","?").split(" (")[0]) for x in sdr) or "%sninguno%s" % (r,n)))
if otros: print("           %s" % " · ".join("%s●%s %s" % (v,n,x["descripcion"].split(" (")[0]) for x in otros))
for f in d["faltan"]:
    print("           %s%s %s%s" % ((g,"○",f["que"]+" · en camino",n) if f["pendiente"] else (a,"!",f["que"]+" · no aparece",n)))
' "$j" "$v" "$r" "$a" "$g" "$b" "$n" 2>/dev/null
fi

# ---- LoRa APRS (RAK4631)
if [ -r "$RAKJ" ]; then
    rx=$(jget "$RAKJ" rak.rx)
    ultimo=$(python3 -c 'import json,sys
o=json.load(open(sys.argv[1])).get("oidos") or []
print("%s %s (%s dBm)" % (o[0]["hora"], o[0]["de"], o[0]["rssi"]) if o else "")' "$RAKJ" 2>/dev/null)
    is=$(jget "$RAKJ" aprsis.conectado)
    printf ' %sLoRa APRS%s %s paquetes%s · APRS-IS %s\n' "$b" "$n" "${rx:-0}" "${ultimo:+ · último $ultimo}" \
        "$( [ "$is" = True ] && printf '%sconectado%s' "$v" "$n" || printf '%ssin conexión%s' "$a" "$n")"
fi

# ---- seguridad
seg=()
[ -e "$R/var/backups/bricohams-blindaje/pendiente" ] && seg+=("${r}blindaje SIN CONFIRMAR: sudo bricohams-blindaje confirmar${n}")
[ -e "$R/var/run/reboot-required" ] && seg+=("${a}hay que reiniciar (actualizaciones)${n}")
if [ -z "${BH_SIN_SYSTEMD:-}" ] && command -v fail2ban-client >/dev/null 2>&1; then
    ban=$(timeout 2 fail2ban-client status sshd 2>/dev/null | sed -n 's/.*Currently banned:[[:space:]]*//p')
    [ -n "$ban" ] && seg+=("fail2ban: $ban IP bloqueadas")
fi
nota=$(cat "$R/var/lib/bricohams/blindaje-nota" 2>/dev/null)
[ -n "$nota" ] && seg+=("auditoría: $nota")
[ ${#seg[@]} -gt 0 ] && printf ' %sSeguridad%s %s\n' "$b" "$n" "$(IFS='|'; echo "${seg[*]}" | sed 's/|/ · /g')"

printf '\n %sAyuda%s     bricohams-servicios · sudo bricohams-check · sudo bricohams-dispositivos\n' "$g" "$n"
printf '           sudo bricohams-rak-aprs prueba · sudo bricohams-blindaje auditar%s\n\n' "$n"
