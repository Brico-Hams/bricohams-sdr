--font-ui:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;--font-head:Montserrat,Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;--plate:transparent}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#111518;--surface:#1C2329;--text:#F6F8FA;
--text-muted:#BAC4CC;--border:#38434C;--link:#FFA06A;--focus:#FFC18F;--ok:#7BD88F;--plate:#FFFFFF}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#111518;--surface:#1C2329;--text:#F6F8FA;--text-muted:#BAC4CC;--border:#38434C;--link:#FFA06A;--focus:#FFC18F;--ok:#7BD88F;--plate:#FFFFFF}
body{font:16px/1.5 var(--font-ui);background:var(--bg);color:var(--text);margin:0;padding:24px 16px}
a{color:var(--link)}:focus-visible{outline:3px solid var(--focus);outline-offset:3px}
main{max-width:900px;margin:auto}h1{margin:.2em 0;color:var(--text);font-family:var(--font-head);font-weight:800}p.s{color:var(--text-muted);margin-top:0}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.logo{display:inline-block;background:var(--plate);border-radius:10px;padding:6px 10px;line-height:0}.logo img{height:48px;width:auto}
.tema{font:inherit;font-size:.9em;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:4px 8px}
.g{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;margin-top:18px}
a.c{display:block;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px 16px;text-decoration:none;color:var(--text);
border-left:5px solid var(--brand-orange)}a.c:hover{border-color:var(--brand-orange)}
a.c b{display:block;font-size:1.08em}a.c span{color:var(--text-muted);font-size:.92em}.lan{border-left-color:var(--text-muted)!important}.gh{border-left-color:var(--ok)!important}
footer{margin-top:24px;color:var(--text-muted);font-size:.9em}</style></head><body><main>
