<script>(function(){var s=document.getElementById('bh-tema');if(!s)return;var t='system';try{t=localStorage.getItem('bh_theme')||'system'}catch(e){}
s.value=t==='light'||t==='dark'?t:'system';s.addEventListener('change',function(){var v=s.value;
if(v==='light'||v==='dark'){document.documentElement.setAttribute('data-theme',v);try{localStorage.setItem('bh_theme',v)}catch(e){}}
else{document.documentElement.removeAttribute('data-theme');try{localStorage.removeItem('bh_theme')}catch(e){}}})})();</script>
<script>
(function(){
var nav=navigator,ua=nav.userAgent||'',$=function(i){return document.getElementById(i)};
function navegador(){var m=[[/Edg(?:e|A|iOS)?\/([\d.]+)/,'Edge'],[/OPR\/([\d.]+)/,'Opera'],[/(?:Firefox|FxiOS)\/([\d.]+)/,'Firefox'],
[/(?:Chrome|CriOS)\/([\d.]+)/,'Chrome'],[/Version\/([\d.]+).*Safari/,'Safari']];
for(var i=0;i<m.length;i++){var r=m[i][0].exec(ua);if(r)return m[i][1]+' '+r[1].split('.')[0]}return 'Desconocido'}
function sistema(){var p=(nav.userAgentData&&nav.userAgentData.platform)||'',t=ua;
if(/Android/.test(t))return 'Android';if(/iPhone|iPad|iPod/.test(t))return 'iOS';
if(/Windows/.test(t)||p==='Windows')return 'Windows';if(/Mac OS X|Macintosh/.test(t)||p==='macOS')return 'macOS';
if(/CrOS/.test(t))return 'ChromeOS';if(/Linux|X11/.test(t)||p==='Linux')return 'Linux';return p||'Desconocido'}
$('bh-c-nav').textContent=navegador();$('bh-c-so').textContent=sistema();
$('bh-c-idi').textContent=(nav.languages&&nav.languages[0])||nav.language||'Desconocido';
var f=new Intl.NumberFormat(nav.language||'es');
function pintar(d){$('bh-v-total').textContent=f.format(d.total);$('bh-v-hoy').textContent=f.format(d.hoy)}
function fallo(){$('bh-v-total').textContent='No disponible';$('bh-v-hoy').textContent='No disponible'}
var contada=false;try{contada=sessionStorage.getItem('bh_visita')==='1'}catch(e){}
fetch('/bricohams/api/visitas',{method:contada?'GET':'POST',headers:{'Content-Type':'application/json'},body:contada?undefined:'{}',cache:'no-store',credentials:'same-origin'})
.then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(d){pintar(d);try{sessionStorage.setItem('bh_visita','1')}catch(e){}}).catch(fallo);
fetch('/bricohams/api/mi-ip',{cache:'no-store',credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;return r.json()})
.then(function(d){$('bh-c-ip').textContent=d.ip||'No disponible';$('bh-c-id').textContent=(typeof d.identidad==='string'&&d.identidad)||'Sin identificar'})
.catch(function(){$('bh-c-ip').textContent='No disponible';$('bh-c-id').textContent='Sin identificar'});
})();
</script></body></html>
