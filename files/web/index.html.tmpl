<dt>Navegador</dt><dd id="bh-c-nav">…</dd><dt>Sistema</dt><dd id="bh-c-so">…</dd><dt>Idioma</dt><dd id="bh-c-idi">…</dd><dt>Tu IP</dt><dd id="bh-c-ip">…</dd><dt>Identidad</dt><dd id="bh-c-id">…</dd></dl></section>
</div>
<div class="g">
