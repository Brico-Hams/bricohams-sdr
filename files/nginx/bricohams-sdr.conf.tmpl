# =====================================================================
#  nginx · BricoHams SDR · EA5KAO (v4) — lo genera install.sh (paso «web»)
#  https://__DOMINIO__/            OpenWebRX+ (127.0.0.1:8073, con websockets)
#  https://__DOMINIO__/tar1090/    mapa de aviones (lighttpd movido a 127.0.0.1:8504)
#  https://__DOMINIO__/camara/     vídeo HLS de MediaMTX (127.0.0.1:8888)
#  https://__DOMINIO__/bricohams/  portal de servicios, privacidad y API de los plugins
#  En el router SOLO se abren 80 y 443 hacia la Pi (no el 8073).
# =====================================================================
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__ _;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMINIO__ _;
    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:5m;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    client_max_body_size 4m;
    access_log /var/log/nginx/bricohams-sdr.access.log;

    location / {
        proxy_pass http://127.0.0.1:8073;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;    # OpenWebRX+ toma la IP del oyente de aquí
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        proxy_buffering off;
    }
    location /tar1090/ {
        proxy_pass http://127.0.0.1:8504/tar1090/;
        proxy_set_header Host $host;
    }
    location /camara/ {
        proxy_pass http://127.0.0.1:8888/;
        proxy_set_header Host $host;
        proxy_buffering off;
    }
    location = /bricohams { return 301 /bricohams/; }
    location /bricohams/api/ {
        proxy_pass http://127.0.0.1:8075;
        proxy_set_header X-Forwarded-For $remote_addr;
        limit_except GET { deny all; }
    }
    location /bricohams/ {
        alias /var/www/bricohams/;
        index index.html;
    }
}
