# =====================================================================
#  nginx · BricoHams SDR · EA5KAO (v4.2) — lo genera install.sh (paso «web»)
#  según SSL_MODO de bricohams.env:
#    admin (por defecto)  el receptor público va por HTTP; /login, /settings y el
#                         resto de páginas de administración se fuerzan a HTTPS
#    todo                 todo por HTTPS (HTTP redirige)
#    no                   todo por HTTP, sin certificado
#  Las rutas están en /etc/nginx/snippets/bricohams-sdr-rutas.conf.
#  En el router se abren 80 (y 443 si SSL_MODO no es «no») hacia la Pi.
#  Las líneas «#@X@» las activa o borra install.sh; no las edites aquí.
# =====================================================================
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
# v4.4 · como mucho 12 intentos de /login por minuto y IP (fuerza bruta de la contraseña de admin)
limit_req_zone $binary_remote_addr zone=bh_login:10m rate=12r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__ _;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
#@ADMIN@    # páginas de administración (rutas de OpenWebRX+ con AuthorizationMixin): siempre HTTPS
#@ADMIN@    location ~ ^/(login|logout|pwchange|settings|imageupload|clients|services|ban|unban|broadcast|files/delete)(/|$) {
#@ADMIN@        return 301 https://$host$request_uri;
#@ADMIN@    }
#@TODO@    location / { return 301 https://$host$request_uri; }
#@HTTP@    include /etc/nginx/snippets/bricohams-sdr-rutas.conf;
}

#@SSL>
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMINIO__ _;
    server_tokens off;
    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:5m;
#@TODO@    add_header Strict-Transport-Security "max-age=15552000" always;
    # la cookie de sesión del admin solo viaja por HTTPS (nunca por el HTTP público)
    proxy_cookie_flags owrx-session secure httponly samesite=lax;
    include /etc/nginx/snippets/bricohams-sdr-rutas.conf;
}
