[Unit]
Description=BricoHams - puente USB Meshtastic 433 para mapa y web
After=network-online.target
Before=bricohams-mesh-owrx.service

[Service]
ExecStart=/opt/pipx/venvs/meshtastic/bin/python /usr/local/bin/bricohams-mesh-puente servicio
DynamicUser=yes
SupplementaryGroups=dialout
LoadCredential=env:/etc/bricohams/bricohams.env
RuntimeDirectory=bricohams-mesh-puente
Environment=MESH_RUN_DIR=/run/bricohams-mesh-puente
RuntimeDirectoryMode=0755
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
