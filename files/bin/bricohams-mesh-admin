def html_mensajes_rak(d):
    m = (d or {}).get('mensajes')
    if m is None:
        return '<p class="text-muted">La pasarela no contesta en su API local: sin mensajes.</p>'
    if not m:
        return '<p class="text-muted">Ningún mensaje todavía.</p>'
    filas = ''.join('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>' % (
        e(x.get('hora')), e(x.get('de')), e(x.get('a')), e(x.get('texto')),
        e(x.get('via')) + (' · <b>ack</b>' if x.get('ack') else ''))
        for x in m[:30])
    return '<table class="table table-sm"><tr><th>Hora</th><th>De</th><th>A</th><th>Texto</th><th>Vía</th></tr>%s</table>' % filas


def html_posiciones_rak(d):
    pos = (d or {}).get('posiciones') or {}
    if not pos:
        return '<p class="text-muted">Nada todavía (las posiciones salen también en el mapa de OpenWebRX+).</p>'
    orden = sorted(pos.items(), key=lambda kv: -(kv[1].get('t') or 0))[:40]
    filas = ''.join('<tr><td>%s</td><td>%s</td><td>%.4f, %.4f</td><td>%s</td></tr>' % (
        e(k), e(v.get('hora')), v.get('lat', 0), v.get('lon', 0), e(v.get('comentario', '')))
        for k, v in orden)
    return '<table class="table table-sm"><tr><th>Estación</th><th>Hora</th><th>Posición</th><th>Comentario</th></tr>%s</table>' % filas


def html_trabajo():
    if not TRABAJO.titulo:
        return ''
    return '<div class="card mb-4"><div class="card-header"><b>%s</b> · %s</div><pre class="card-body mb-0" style="max-height:20em;overflow:auto">%s</pre></div>' % (
        e(TRABAJO.titulo), 'en marcha…' if TRABAJO.activo else 'terminado ' + e(hora(TRABAJO.fin)), e('\n'.join(TRABAJO.log)))


def host_seguro(h):
    """Nombre/IP de la cabecera Host sin puerto, solo si es un nombre válido (para los enlaces a :8445)."""
    h = (h or '').strip()
    if h.count(':') == 1:
        h = h.rsplit(':', 1)[0]
    elif h.startswith('[') and ']:' in h:
        h = h[:h.index(']') + 1]
    return h if re.match(r'^(\[[0-9A-Fa-f:]+\]|[A-Za-z0-9.-]{1,253})$', h) else ''


def cabecera(titulo, ruta):
    """Cabecera común de los paneles TAK y Monitorización (v5.0), con enlaces entre paneles."""
    refresco = '<meta http-equiv="refresh" content="5;url=%s">' % ruta if TRABAJO.activo else ''
    enlaces = ' · '.join('<a href="%s">%s</a>' % (r, n) for r, n in (
        (BASE, 'Meshtastic'), (APRS, 'APRS (RAK)'), (TAK, 'TAK'), (MONITOR, 'Monitorización')) if r != ruta)
    return """<!DOCTYPE html><html lang="es"><head><meta charset="utf-8">%s
<meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex">
<title>%s · administración BricoHams</title>
<link rel="stylesheet" href="/static/css/bootstrap.min.css"><link rel="stylesheet" href="/static/css/admin.css"></head>
<body><div class="container-fluid"><div class="row"><div class="col-12">
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/settings">Settings</a></li>
<li class="breadcrumb-item active">%s</li></ol></nav><p class="small">Otros paneles: %s</p>""" % (refresco, e(titulo), e(titulo), enlaces)


def tabla_unidades(unidades, ruta, grupo, oculto):
    filas = []
    for u in unidades:
        cargada, activa, txt = estado_unidad(u)
        if not cargada and u in UNIDADES_OPCIONALES:
            continue
        botones = ''
        if cargada:
            otro = ('parar', 'Parar', 'danger') if activa else ('arrancar', 'Arrancar', 'success')
            botones = ''.join('<button class="btn btn-sm btn-%s me-1" name="accion" value="%s-%s-%s">%s</button>' % (
                c, grupo, v, u, n) for v, n, c in (('reiniciar', 'Reiniciar', 'secondary'), otro))
        clase = 'text-success' if activa else ('text-danger' if cargada else 'text-muted')
        filas.append('<tr><th>%s</th><td class="%s">%s</td><td><form method="post" action="%s" class="m-0">%s%s</form></td></tr>' % (
            e(u), clase, e(txt), ruta, oculto, botones))
    return '<table class="table table-sm"><tr><th>Servicio</th><th>Estado</th><th></th></tr>%s</table>' % ''.join(filas)


def avisos(aviso, error):
    return ''.join(['<div class="alert alert-success">%s</div>' % e(aviso) if aviso else '',
                    '<div class="alert alert-danger">%s</div>' % e(error) if error else '', html_trabajo()])


def tarjeta_credenciales_tak(oculto, mostrar):
    """Las claves solo viajan en la respuesta a «Mostrar credenciales» (POST con CSRF, no-store)."""
    pares = leer_acceso_tak()
    if not pares:
        return ('<div class="card mb-4"><div class="card-header"><b>Credenciales TAK</b></div><div class="card-body">'
                '<p class="mb-0">No hay credenciales en <code>%s</code>.</p></div></div>' % e(TAK_ACCESO))
    filas = ''.join('<tr><td><code>%s</code></td><td>%s</td><td>%s</td></tr>' % (
        e(u), 'administrador' if i == 0 else 'usuario',
        '<code>%s</code>' % e(c) if mostrar else '••••••••') for i, (u, c) in enumerate(pares))
    opciones = ''.join('<option value="%s">%s</option>' % (e(u), e(u)) for u, _ in pares)
    return """<div class="card mb-4"><div class="card-header"><b>Credenciales TAK (web :8445 y alta de certificados)</b></div><div class="card-body">
<table class="table table-sm"><thead><tr><th>Usuario</th><th>Rol</th><th>Clave</th></tr></thead><tbody>%(filas)s</tbody></table>
<form method="post" action="%(ruta)s" class="mb-3">%(oculto)s<button class="btn btn-outline-primary btn-sm" name="accion" value="tak-credenciales">Mostrar credenciales</button>
<span class="small text-muted">Se guardan en <code>%(fichero)s</code> (root, 600). No las compartas.</span></form>
<form method="post" action="%(ruta)s" autocomplete="off">%(oculto)s
<div class="row g-2 align-items-end">
<div class="col-md-3"><label class="form-label small">Usuario</label><select class="form-select form-select-sm" name="usuario">%(opciones)s</select></div>
<div class="col-md-3"><label class="form-label small">Clave nueva</label><input class="form-control form-control-sm" type="password" name="clave" minlength="12" maxlength="128" autocomplete="new-password"></div>
<div class="col-md-3"><label class="form-label small">Repite la clave</label><input class="form-control form-control-sm" type="password" name="clave2" minlength="12" maxlength="128" autocomplete="new-password"></div>
<div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" name="generar" value="yes" id="tak-generar"><label class="form-check-label small" for="tak-generar">Generar una aleatoria</label></div>
<button class="btn btn-warning btn-sm" name="accion" value="tak-clave">Cambiar clave</button></div></div>
<p class="small text-muted mt-2 mb-0">12–128 caracteres ASCII visibles, sin espacios. Tras cambiarla, vuelve a iniciar sesión en ATAK/iTAK/WinTAK.</p>
</form></div></div>""" % {'filas': filas, 'ruta': TAK, 'oculto': oculto, 'fichero': e(TAK_ACCESO), 'opciones': opciones}


def pagina_tak(sesion, aviso='', error='', host='', mostrar=False):
    """Control del servidor TAK local (OpenTAKServer): estado, arrancar/parar/reiniciar y registro."""
    oculto = '<input type="hidden" name="csrf" value="%s">' % token(sesion)
    h = e(host_seguro(host)) or '&lt;IP-de-la-estación&gt;'
    if estado_unidad('bricohams-tak')[0]:
        cuerpo = """<div class="row"><div class="col-lg-7"><div class="card mb-4"><div class="card-header"><b>Servicios</b></div><div class="card-body">
%(tabla)s
<form method="post" action="%(ruta)s">%(oculto)s
<button class="btn btn-success" name="accion" value="tak-arrancar">Arrancar todo</button>
<button class="btn btn-secondary" name="accion" value="tak-reiniciar">Reiniciar todo</button>
<button class="btn btn-danger" name="accion" value="tak-parar">Parar todo</button></form>
</div></div></div>
<div class="col-lg-5"><div class="card mb-4"><div class="card-header"><b>Accesos (solo LAN / VPN)</b></div><div class="card-body">
<p><a class="btn btn-primary" href="https://%(h)s:8445/" target="_blank" rel="noopener">Abrir la web de OpenTAKServer</a></p>
<ul class="mb-2"><li>Web de administración: <code>https://%(h)s:8445/</code></li>
<li>CoT SSL (ATAK / iTAK / WinTAK): <code>%(h)s:8089</code></li>
<li>Alta de certificados: <code>%(h)s:8446</code> y <code>%(h)s:8447</code></li></ul>
<p class="small text-muted mb-0">Usuarios y claves: tarjeta «Credenciales TAK» (o <code>sudo cat /etc/bricohams/tak-access.txt</code>).
Los contactos TAK salen en el mapa de OpenWebRX+ (capa TAK).</p>
</div></div></div></div>
<div class="row"><div class="col-12">%(cred)s</div></div>
<div class="row"><div class="col-12"><div class="card mb-4"><div class="card-header"><b>Registro · bricohams-tak</b></div>
<pre class="card-body mb-0 small" style="max-height:30em;overflow:auto">%(log)s</pre></div></div></div>""" % {
            'tabla': tabla_unidades(TAK_UNIDADES, TAK, 'tak', oculto), 'ruta': TAK, 'oculto': oculto, 'h': h,
            'log': e(registro('bricohams-tak')), 'cred': tarjeta_credenciales_tak(oculto, mostrar)}
    else:
        cuerpo = ('<div class="alert alert-warning">El servidor TAK no está instalado. Pon <code>TAK=yes</code> en '
                  'bricohams.env y ejecuta <code>sudo ./install.sh --solo tak</code>.</div>')
    return (cabecera('Servidor TAK', TAK) + '<h1>Servidor TAK local</h1>' + avisos(aviso, error)
            + '</div></div>' + cuerpo + '</div></body></html>')


def pagina_monitor(sesion, aviso='', error='', host=''):
    """Solo el panel de Grafana (Prometheus + node_exporter) y el estado de sus servicios."""
    oculto = '<input type="hidden" name="csrf" value="%s">' % token(sesion)
    if estado_unidad('grafana-server')[0]:
        cuerpo = """<div class="row"><div class="col-12">
<iframe src="%(gf)s" title="Grafana · BricoHams" style="width:100%%;height:78vh;border:0"></iframe>
<p class="small"><a href="%(gf)s" target="_blank" rel="noopener">Abrir el panel a pantalla completa</a></p>
<details class="mb-4"><summary>Servicios de monitorización</summary>%(tabla)s
<form method="post" action="%(ruta)s">%(oculto)s<button class="btn btn-secondary" name="accion" value="mon-reiniciar">Reiniciar todo</button></form>
</details></div></div>""" % {'gf': e(GRAFANA), 'tabla': tabla_unidades(MON_UNIDADES, MONITOR, 'mon', oculto),
                              'ruta': MONITOR, 'oculto': oculto}
    else:
        cuerpo = ('<div class="alert alert-warning">La monitorización no está instalada. Pon <code>MONITORIZACION=yes</code> '
                  'en bricohams.env y ejecuta <code>sudo ./install.sh --solo monitorizacion</code>.</div>')
    return cabecera('Monitorización', MONITOR) + avisos(aviso, error) + '</div></div>' + cuerpo + '</div></body></html>'


PAGINAS = {BASE: pagina, APRS: pagina_aprs, TAK: pagina_tak, MONITOR: pagina_monitor}
# acciones que acepta cada página; la de Meshtastic no puede tocar TAK ni monitorización
ACCIONES = {APRS: re.compile(r'^(reiniciarrak|rakbaliza|rakmensaje)$'), TAK: re.compile(r'^tak-'), MONITOR: re.compile(r'^mon-'),
            BASE: re.compile(r'^(?!tak-|mon-)')}


def posiciones_tak():
    """Consulta local de solo lectura bajo la identidad PostgreSQL del servicio TAK."""
    sql = """
        SELECT COALESCE(json_agg(n), '[]'::json) FROM (
            SELECT DISTINCT ON (p.device_uid)
                p.device_uid AS uid, COALESCE(e.callsign, p.device_uid) AS callsign,
                p.latitude AS lat, p.longitude AS lon,
                EXTRACT(EPOCH FROM p.timestamp AT TIME ZONE 'UTC') * 1000 AS timestamp
            FROM points p JOIN euds e ON e.uid = p.device_uid
            JOIN cot c ON c.id = p.cot_id
            WHERE p.latitude BETWEEN -90 AND 90 AND p.longitude BETWEEN -180 AND 180
                AND c.stale > (CURRENT_TIMESTAMP AT TIME ZONE 'UTC')
            ORDER BY p.device_uid, p.timestamp DESC, p.id DESC LIMIT 1000
        ) n
    """
    r = subprocess.run(['runuser', '-u', 'opentakserver', '--', 'psql', '-X', '-q', '-A', '-t',
                        '--set=ON_ERROR_STOP=1', '--host=/var/run/postgresql',
                        '--dbname=bricohams_tak', '--command', sql],
                       capture_output=True, text=True, timeout=5,
                       env={**os.environ, 'PGOPTIONS': '-c statement_timeout=3000 -c default_transaction_read_only=on'})
    if r.returncode:
        raise RuntimeError('PostgreSQL TAK no disponible')
    datos = json.loads(r.stdout)
    if not isinstance(datos, list):
        raise ValueError('respuesta TAK no valida')
    return {'nodes': datos}


class Manejador(http.server.BaseHTTPRequestHandler):
    server_version = 'bricohams-mesh-admin'
    sys_version = ''

    def log_message(self, fmt, *a):
        pass

    def _enviar(self, codigo, cuerpo=b'', tipo='text/html; charset=utf-8', cabeceras=()):
        self.send_response(codigo)
        self.send_header('Content-Type', tipo)
        self.send_header('Content-Length', str(len(cuerpo)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Robots-Tag', 'noindex')
        self.send_header('Content-Security-Policy', "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; form-action 'self'; frame-ancestors 'self'")
        for k, v in cabeceras:
            self.send_header(k, v)
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(cuerpo)

    def _sesion(self):
        s = sesion_owrx(self.headers.get('Cookie'))
        return s if autorizado(s) else None

    def _ruta(self):
        return urlsplit(self.path).path.rstrip('/')

    def do_GET(self):
        ruta = self._ruta()
        if ruta == AUTH:
            # auth_request de nginx para el cliente web de Meshtastic (:8443): 204 admin, 401 el resto
            ok = autorizado_cache(sesion_owrx(self.headers.get('Cookie')))
            return self._enviar(204 if ok else 401, tipo='text/plain; charset=utf-8')
        if ruta == TAK_POSICIONES:
            if not self._sesion():
                return self._enviar(401, b'{"error":"sesion de administrador necesaria"}', 'application/json')
            try:
                datos = posiciones_tak()
            except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as e:
                print('mapa TAK: %s' % e, file=sys.stderr, flush=True)
                return self._enviar(503, b'{"error":"TAK no disponible"}', 'application/json')
            return self._enviar(200, json.dumps(datos).encode(), 'application/json')
        if ruta not in PAGINAS and ruta != '/settings/bricohams':
            return self._enviar(404, b'no encontrado', 'text/plain; charset=utf-8')
        s = self._sesion()
        if not s:
            destino = ruta if ruta in PAGINAS else BASE
            return self._enviar(302, cabeceras=[('Location', '/login?ref=' + destino.lstrip('/'))])
        if ruta not in PAGINAS:
            return self._enviar(302, cabeceras=[('Location', BASE)])
        return self._enviar(200, self._pagina(ruta, s).encode('utf-8'))

    def _pagina(self, ruta, s, aviso='', error='', mostrar=False):
        if ruta == TAK:
            return pagina_tak(s, aviso, error, host=self.headers.get('Host', ''), mostrar=mostrar)
        if ruta == MONITOR:
            return PAGINAS[ruta](s, aviso, error, host=self.headers.get('Host', ''))
        return PAGINAS[ruta](s, aviso, error)

    do_HEAD = do_GET

    def _mismo_origen(self):
        host = (self.headers.get('Host') or '').split(':')[0].lower()
        for cab in ('Origin', 'Referer'):
            v = self.headers.get(cab)
            if v:
                return (urlsplit(v).hostname or '').lower() == host and bool(host)
        return False

    def do_POST(self):
        ruta = self._ruta()
        if ruta not in PAGINAS:
            return self._enviar(404, b'no encontrado', 'text/plain; charset=utf-8')
        s = self._sesion()
        if not s:
            return self._enviar(403, b'sesion de administrador necesaria', 'text/plain; charset=utf-8')
        try:
            largo = int(self.headers.get('Content-Length', '0'))
        except ValueError:
            largo = 0
        if largo <= 0 or largo > 16384:
            return self._enviar(400, b'peticion no valida', 'text/plain; charset=utf-8')
        campos = {k: v[0] for k, v in parse_qs(self.rfile.read(largo).decode('utf-8', 'replace')).items()}
        if not (self._mismo_origen() and hmac.compare_digest(campos.get('csrf', ''), token(s))):
            return self._enviar(403, b'origen no valido', 'text/plain; charset=utf-8')
        aviso = error = ''
        mostrar = False
        try:
            if not ACCIONES[ruta].match(campos.get('accion', '')):
                raise ValueError('acción desconocida')
            if ruta == TAK and campos.get('accion') == 'tak-credenciales':
                mostrar = True
                aviso = 'Credenciales visibles solo en esta respuesta; recarga la página para ocultarlas.'
            else:
                aviso = accion(campos)
        except (ValueError, OSError) as x:
            error = str(x)
        return self._enviar(200, self._pagina(ruta, s, aviso, error, mostrar).encode('utf-8'))


class Servidor(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def main(a):
    if len(a) >= 4 and a[1] == 'leer':
        try:
            print(json.dumps(leer_nodo(a[2], a[3]), ensure_ascii=False))
        except Exception as x:
            print(json.dumps({'ok': False, 'error': tapar(str(x))[:300]}, ensure_ascii=False))
        return 0
    if len(a) >= 2 and a[1] == 'servicio':
        Servidor(('127.0.0.1', PUERTO), Manejador).serve_forever()
        return 0
    print(open(__file__, encoding='utf-8').read().split('# =====')[1].replace('\n#  ', '\n').strip('#=\n '))
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
