def br_tamano(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return '?'
    for u in ('B', 'KB', 'MB', 'GB'):
        if n < 1024:
            return '%.1f %s' % (n, u) if u != 'B' else '%d B' % n
        n /= 1024
    return '%.1f TB' % n


def br_timer():
    try:
        r = subprocess.run(['systemctl', 'show', '-p', 'LoadState,ActiveState,NextElapseUSecRealtime', '--',
                            BR_UNIDAD + '.timer'], capture_output=True, text=True, timeout=10)
        d = dict(l.split('=', 1) for l in r.stdout.splitlines() if '=' in l)
    except (OSError, subprocess.TimeoutExpired):
        d = {}
    if d.get('LoadState') != 'loaded':
        return 'no instalado'
    if d.get('ActiveState') != 'active':
        return 'desactivada'
    return 'activa · próxima: %s' % (d.get('NextElapseUSecRealtime') or '?')


def tarjeta_backup_remoto(oculto):
    c = leer_json(BR_CONF)
    st = leer_json(BR_ESTADO)
    hay = leer_json(BR_SECRETO) if c else {}
    p = c.get('protocolo', 'cifs')
    filas = []
    for orden in BR_ORDENES:
        r = st.get(orden)
        if isinstance(r, dict):
            ok = r.get('ok')
            txt, clase = ('en marcha…', 'text-muted') if ok is None else (('correcto', 'text-success') if ok else ('error', 'text-danger'))
            filas.append('<tr><th>%s</th><td>%s</td><td class="%s">%s</td><td><small>%s</small></td></tr>' % (
                e(orden), e(r.get('fecha', '')), clase, txt, e(tapar(str(r.get('mensaje', '')))[:300])))
    resumen = ''
    if st.get('ultima_copia'):
        resumen = ('<p class="mb-1">Última copia: <code>%s</code> · %s · %s<br><small>SHA-256 %s</small></p>' % (
            e(st['ultima_copia']), e(st.get('ultima_fecha', '')), br_tamano(st.get('ultimo_tamano')),
            e(st.get('ultima_suma', ''))))
    huella = ''
    if p == 'sftp':
        if st.get('huella_pendiente'):
            huella = ('<div class="alert alert-warning">Huella del servidor SFTP pendiente de confirmar. '
                      'Compárala con la del servidor antes de aceptarla:<pre class="mb-2">%s</pre>'
                      '<form method="post" action="%s" class="m-0">%s<button class="btn btn-sm btn-warning" '
                      'name="accion" value="seg-confirmar">Confirmar huella</button></form></div>' % (
                          e(st['huella_pendiente']), SEGURIDAD, oculto))
        elif st.get('huella'):
            huella = '<p class="small">Huella SFTP confirmada: <code>%s</code></p>' % e(st['huella'])

    def sel(nombre, opciones, valor):
        return '<select class="form-select" name="%s" id="br-%s">%s</select>' % (nombre, nombre, ''.join(
            '<option value="%s"%s>%s</option>' % (e(k), ' selected' if k == valor else '', e(v)) for k, v in opciones))

    def txt(nombre, valor, ph='', tipo='text'):
        return '<input class="form-control" type="%s" name="%s" id="br-%s" value="%s" placeholder="%s" autocomplete="off">' % (
            tipo, nombre, nombre, e(valor), e(ph))

    usuario = c.get('usuario', '')
    if c.get('dominio'):
        usuario = '%s\\%s' % (c['dominio'], usuario)
    guardada = ('<span class="text-success">guardada</span>' if hay.get('password') else '<span class="text-muted">sin guardar</span>')
    tok = ('<span class="text-success">guardado</span>' if hay.get('token') else '<span class="text-muted">sin guardar</span>')
    destino_ph = '\\\\192.168.1.254\\fw\\backup' if p != 'nfs' else 'nas.local:/export/backup'
    v = {
        'ruta': SEGURIDAD, 'oculto': oculto, 'timer': e(br_timer()), 'resumen': resumen, 'huella': huella,
        'tabla': ('<table class="table table-sm"><tr><th>Orden</th><th>Fecha</th><th>Estado</th><th>Mensaje</th></tr>%s</table>' % ''.join(filas))
        if filas else '<p class="text-muted">Todavía no se ha ejecutado ninguna orden.</p>',
        'protocolo': sel('protocolo', list(BR_PROTOCOLOS.items()), p),
        'destino': txt('destino', c.get('destino', ''), destino_ph),
        'servidor': txt('servidor', c.get('servidor', ''), 'sftp.ejemplo.org'),
        'puerto': txt('puerto', str(c.get('puerto', 22)), '22', 'number'),
        'carpeta': txt('ruta', c.get('ruta', 'bricohams-backup'), 'bricohams-backup'),
        'usuario': txt('usuario', usuario, 'usuario o DOMINIO\\usuario'),
        'smb': sel('smb_version', [('3.1.1', 'SMB 3.1.1'), ('3.0', 'SMB 3.0'), ('2.1', 'SMB 2.1')], c.get('smb_version', '3.0')),
        'nfs': sel('nfs_version', [('4.2', 'NFS 4.2'), ('4.1', 'NFS 4.1'), ('4', 'NFS 4'), ('3', 'NFS 3')], c.get('nfs_version', '4')),
        'drive_id': txt('drive_id', c.get('drive_id', ''), 'b!abc… o 0123ABCD'),
        'drive_type': sel('drive_type', [('personal', 'Personal'), ('business', 'Empresa / OneDrive for Business'),
                                         ('documentLibrary', 'Biblioteca SharePoint')], c.get('drive_type', 'personal')),
        'retencion': txt('retencion', str(c.get('retencion', 14)), '14', 'number'),
        'prog': ' checked' if c.get('programado') else '',
        'secr': ' checked' if c.get('incluir_secretos') else '',
        'guardada': guardada, 'tok': tok,
        'registro': e(registro('%s@copiar' % BR_UNIDAD, 30)),
    }
    return """<div class="card mb-4"><div class="card-header"><b>Backup remoto</b> · copia programada: %(timer)s</div>
<div class="card-body">%(resumen)s%(huella)s%(tabla)s
<form method="post" action="%(ruta)s" class="mb-3">%(oculto)s
<button class="btn btn-sm btn-secondary me-1" name="accion" value="seg-probar">Probar conexión</button>
<button class="btn btn-sm btn-primary me-1" name="accion" value="seg-copiar">Copiar ahora</button>
<button class="btn btn-sm btn-secondary me-1" name="accion" value="seg-verificar">Verificar última copia</button>
<button class="btn btn-sm btn-secondary me-1" name="accion" value="seg-huella">Obtener huella SFTP</button></form>
<form method="post" action="%(ruta)s" autocomplete="off">%(oculto)s
<div class="row g-2">
<div class="col-md-4"><label class="form-label" for="br-protocolo">Protocolo</label>%(protocolo)s</div>
<div class="col-md-8"><label class="form-label" for="br-destino">Destino SMB (UNC) o NFS (servidor:/export)</label>%(destino)s</div>
<div class="col-md-4"><label class="form-label" for="br-usuario">Usuario (SMB / SFTP)</label>%(usuario)s</div>
<div class="col-md-4"><label class="form-label" for="br-password">Contraseña (%(guardada)s)</label>
<input class="form-control" type="password" name="password" id="br-password" autocomplete="new-password" placeholder="vacío = no cambiar"></div>
<div class="col-md-4"><label class="form-label" for="br-password2">Repetir contraseña</label>
<input class="form-control" type="password" name="password2" id="br-password2" autocomplete="new-password"></div>
<div class="col-md-3"><label class="form-label" for="br-smb_version">Versión SMB</label>%(smb)s</div>
<div class="col-md-3"><label class="form-label" for="br-nfs_version">Versión NFS</label>%(nfs)s</div>
<div class="col-md-4"><label class="form-label" for="br-servidor">Servidor SFTP</label>%(servidor)s</div>
<div class="col-md-2"><label class="form-label" for="br-puerto">Puerto SFTP</label>%(puerto)s</div>
<div class="col-md-4"><label class="form-label" for="br-ruta">Carpeta remota (SFTP / Drive / OneDrive)</label>%(carpeta)s</div>
<div class="col-md-4"><label class="form-label" for="br-drive_id">OneDrive: drive_id</label>%(drive_id)s</div>
<div class="col-md-4"><label class="form-label" for="br-drive_type">OneDrive: tipo</label>%(drive_type)s</div>
<div class="col-12"><label class="form-label" for="br-token">Token OAuth de Google Drive / OneDrive (%(tok)s)</label>
<textarea class="form-control font-monospace" name="token" id="br-token" rows="2" placeholder='{"access_token":"…","refresh_token":"…"} · vacío = no cambiar'></textarea></div>
<div class="col-md-3"><label class="form-label" for="br-retencion">Copias a conservar</label>%(retencion)s</div>
<div class="col-md-9 pt-4">
<div class="form-check"><input class="form-check-input" type="checkbox" name="programado" value="yes" id="br-prog"%(prog)s>
<label class="form-check-label" for="br-prog">Copia diaria automática (05:15, tras la copia local)</label></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="incluir_secretos" value="yes" id="br-secr"%(secr)s>
<label class="form-check-label" for="br-secr">Incluir secretos (bricohams.env, claves TLS…) — solo si el destino es de confianza</label></div></div>
</div>
<button class="btn btn-primary mt-3" name="accion" value="seg-guardar">Guardar configuración</button>
<button class="btn btn-outline-danger mt-3 ms-2" name="accion" value="seg-olvidar">Borrar configuración y credenciales</button>
</form>
<details class="mt-3"><summary>Ayuda por protocolo</summary><ul class="small mt-2">
<li><b>SMB / CIFS</b>: destino <code>\\\\servidor\\recurso\\carpeta</code>, usuario (o <code>DOMINIO\\usuario</code>) y contraseña. Se monta solo durante la copia.</li>
<li><b>NFS</b>: destino <code>servidor:/export/ruta</code>; sin usuario (el servidor autoriza por IP).</li>
<li><b>SFTP</b>: servidor, puerto, usuario y contraseña; antes de copiar pulsa «Obtener huella» y confirma la huella del servidor. No vale para servidores solo SCP.</li>
<li><b>Google Drive / OneDrive</b>: en un PC con navegador ejecuta <code>rclone authorize "drive"</code> u <code>rclone authorize "onedrive"</code> y pega aquí el JSON del token. Para OneDrive indica también el <code>drive_id</code>.</li>
</ul><p class="small mb-0">Las contraseñas y tokens se guardan solo en el servidor (esta página nunca los devuelve al navegador).</p></details>
<details class="mt-2"><summary>Registro de la última copia</summary><pre class="small">%(registro)s</pre></details>
</div></div>""" % v


def boton_seg(oculto, accion, texto, clase='btn-outline-secondary', campos=None):
    extra = ''.join('<input type="hidden" name="%s" value="%s">' % (e(k), e(v)) for k, v in (campos or {}).items())
    return ('<form method="post" action="%s" class="d-inline m-0">%s%s<button class="btn btn-sm %s" name="accion" '
            'value="%s">%s</button></form>' % (SEGURIDAD, oculto, extra, clase, accion, e(texto)))


def tarjeta_bloqueo(oculto):
    d = bloqueo_leer()
    st = leer_json(os.path.join(BLOQUEO_VAR, 'estado.json'))
    tabla = st.get('tabla') if isinstance(st.get('tabla'), dict) else None
    zonas = st.get('zonas') if isinstance(st.get('zonas'), dict) else {}
    contadores = ('<span class="text-success">activo</span> · paquetes descartados: %s' % ', '.join(
        '%s %s' % (e(k), e(str(v))) for k, v in tabla.items()) if tabla is not None
        else '<span class="text-muted">sin aplicar todavía</span>')
    filas_ip = ''.join('<tr><td><code>%s</code></td><td>%s</td><td>%s</td><td>%s</td></tr>' % (
        e(x['red']), e(x['nota']), e(x['fecha']), boton_seg(oculto, 'seg-desbloquearip', 'Quitar', 'btn-outline-danger',
                                                         {'red': x['red']})) for x in d['ips'])
    filas_pais = ''.join('<tr><td><b>%s</b></td><td>%s</td><td>%s</td></tr>' % (
        e(cc.upper()), e(time.strftime('%Y-%m-%d', time.localtime(zonas[cc]))) if isinstance(zonas.get(cc), (int, float)) and zonas[cc] > 0
        else '<span class="text-warning">sin descargar</span>',
        boton_seg(oculto, 'seg-desbloquearpais', 'Quitar', 'btn-outline-danger', {'pais': cc})) for cc in d['paises'])
    baneos = []
    for jaula, ips in sorted((st.get('baneados') or {}).items()) if isinstance(st.get('baneados'), dict) else []:
        for ip in (ips if isinstance(ips, list) else [])[:200]:
            baneos.append('<tr><td>%s</td><td><code>%s</code></td><td>%s</td></tr>' % (
                e(jaula), e(str(ip)), boton_seg(oculto, 'seg-desbanear', 'Liberar', 'btn-outline-warning', {'ip': str(ip)})))
    return """<div class="card mb-4"><div class="card-header"><b>Bloqueo por IP y por país</b> · %s
<span class="float-end">%s</span></div>
<div class="card-body">
<p class="small text-muted">Las IP de la LAN, loopback y rangos reservados nunca se bloquean. Estado a %s.</p>
<h6>IP y redes bloqueadas (%d)</h6>
%s
<form method="post" action="%s" class="row g-2 mb-4" autocomplete="off">%s
<div class="col-md-5"><input class="form-control form-control-sm" name="red" maxlength="400" placeholder="203.0.113.7, 198.51.100.0/24…" spellcheck="false"></div>
<div class="col-md-4"><input class="form-control form-control-sm" name="nota" maxlength="80" placeholder="Motivo (opcional)"></div>
<div class="col-md-3"><button class="btn btn-sm btn-danger w-100" name="accion" value="seg-bloquearip">Bloquear IP / red</button></div></form>
<h6>Países bloqueados (%d)</h6>
<p class="small text-muted">Bloquea todo el tráfico entrante desde las redes asignadas a cada país (listas de ipdeny.com, se renuevan cada semana). Cuidado: no bloquees el país desde el que administras.</p>
%s
<form method="post" action="%s" class="row g-2 mb-4" autocomplete="off">%s
<div class="col-md-9"><input class="form-control form-control-sm" name="paises" maxlength="200" placeholder="Códigos ISO: cn, ru, kp…" spellcheck="false"></div>
<div class="col-md-3"><button class="btn btn-sm btn-danger w-100" name="accion" value="seg-bloquearpais">Bloquear país</button></div></form>
<h6>Baneadas por fail2ban (intentos de inicio de sesión)</h6>
%s
</div></div>""" % (
        contadores, boton_seg(oculto, 'seg-refrescar', 'Actualizar estado'),
        e(time.strftime('%Y-%m-%d %H:%M', time.localtime(st['fecha'])))
        if isinstance(st.get('fecha'), (int, float)) and st['fecha'] > 0 else '—', len(d['ips']),
        '<table class="table table-sm"><tr><th>Red</th><th>Motivo</th><th>Fecha</th><th></th></tr>%s</table>' % filas_ip
        if filas_ip else '<p class="text-muted">Ninguna.</p>', SEGURIDAD, oculto, len(d['paises']),
        '<table class="table table-sm"><tr><th>País</th><th>Lista descargada</th><th></th></tr>%s</table>' % filas_pais
        if filas_pais else '<p class="text-muted">Ninguno.</p>', SEGURIDAD, oculto,
        '<table class="table table-sm"><tr><th>Jaula</th><th>IP</th><th></th></tr>%s</table>' % ''.join(baneos)
        if baneos else '<p class="text-muted">Ninguna IP baneada ahora mismo.</p>')


def tarjeta_cortafuegos(oculto):
    filas = []
    for u in FW_UNIDADES:
        cargada, activa, texto = estado_unidad(u)
        if not cargada:
            clase, texto = 'text-muted', 'no instalado'
        else:
            clase = 'text-success' if activa else 'text-danger'
        filas.append('<tr><th>%s</th><td class="%s">%s</td></tr>' % (e(u), clase, e(texto)))
    return """<div class="card mb-4"><div class="card-header"><b>Cortafuegos y nginx</b>
<span class="float-end">%s</span></div><div class="card-body">
<table class="table table-sm">%s</table>
<p class="small text-muted mb-0">«Recargar» reinicia el cortafuegos nftables y fail2ban, recarga nginx (sin cortar sesiones) y vuelve a aplicar el bloqueo por IP/país.</p>
<details class="mt-2"><summary>Registro del cortafuegos</summary><pre class="small">%s</pre></details>
<details class="mt-2"><summary>Registro de fail2ban</summary><pre class="small">%s</pre></details>
</div></div>""" % (boton_seg(oculto, 'seg-recargarfw', 'Recargar cortafuegos', 'btn-warning'), ''.join(filas),
                   e(registro('bricohams-cortafuegos', 20)), e(registro('fail2ban', 20)))


def tarjeta_usuarios(oculto):
    lista = owrx_usuarios()
    activos = sum(1 for _, si in lista if si)
    filas = []
    for u, si in lista:
        ultimo = si and activos == 1
        acciones = (boton_seg(oculto, 'seg-usuariodesactivar', 'Desactivar', 'btn-outline-warning', {'usuario': u})
                    if si and not ultimo else '' if si else
                    boton_seg(oculto, 'seg-usuarioactivar', 'Activar', 'btn-outline-success', {'usuario': u}))
        filas.append('<tr><td><b>%s</b></td><td class="%s">%s</td><td>%s</td></tr>' % (
            e(u), 'text-success' if si else 'text-muted', 'activo' if si else 'desactivado', acciones))
    opciones = ''.join('<option value="%s">%s</option>' % (e(u), e(u)) for u, _ in lista)
    clave = ('<div class="col-md-3"><input class="form-control form-control-sm" type="password" name="clave" minlength="12" '
             'maxlength="128" autocomplete="new-password" placeholder="Clave (12+)"></div>'
             '<div class="col-md-3"><input class="form-control form-control-sm" type="password" name="clave2" minlength="12" '
             'maxlength="128" autocomplete="new-password" placeholder="Repite la clave"></div>')
    return """<div class="card mb-4"><div class="card-header"><b>Usuarios de la web (OpenWebRX)</b></div><div class="card-body">
%s
<h6 class="mt-3">Crear usuario</h6>
<form method="post" action="%s" class="row g-2 mb-3" autocomplete="off">%s
<div class="col-md-4"><input class="form-control form-control-sm" name="usuario" maxlength="32" pattern="[A-Za-z0-9._-]{1,32}" placeholder="Usuario" autocomplete="off"></div>
%s<div class="col-md-2"><button class="btn btn-sm btn-primary w-100" name="accion" value="seg-usuarionuevo">Crear</button></div></form>
<h6>Cambiar clave</h6>
<form method="post" action="%s" class="row g-2 mb-3" autocomplete="off">%s
<div class="col-md-4"><select class="form-select form-select-sm" name="usuario">%s</select></div>
%s<div class="col-md-2"><button class="btn btn-sm btn-secondary w-100" name="accion" value="seg-usuarioclave">Cambiar</button></div></form>
<h6>Borrar usuario</h6>
<form method="post" action="%s" class="row g-2" autocomplete="off">%s
<div class="col-md-4"><select class="form-select form-select-sm" name="usuario">%s</select></div>
<div class="col-md-6"><input class="form-control form-control-sm" name="confirmar" maxlength="32" placeholder="Escribe el nombre para confirmar" autocomplete="off"></div>
<div class="col-md-2"><button class="btn btn-sm btn-danger w-100" name="accion" value="seg-usuarioborrar">Borrar</button></div></form>
<p class="small text-muted mt-3 mb-0">Nunca se muestran las claves. No se puede borrar ni desactivar el último usuario activo.</p>
</div></div>""" % (
        '<table class="table table-sm"><tr><th>Usuario</th><th>Estado</th><th></th></tr>%s</table>' % ''.join(filas)
        if filas else '<p class="text-warning">No se ha podido leer la lista de usuarios (%s).</p>' % e(owrx_usuarios_ruta()),
        SEGURIDAD, oculto, clave, SEGURIDAD, oculto, opciones, clave, SEGURIDAD, oculto, opciones)


def pagina_seguridad(sesion, aviso='', error=''):
    oculto = '<input type="hidden" name="csrf" value="%s">' % token(sesion)
    return (cabecera('Seguridad', SEGURIDAD) + '<h1>Seguridad</h1>' + avisos(aviso, error) + '</div></div>'
            + tarjeta_bloqueo(oculto) + tarjeta_cortafuegos(oculto) + tarjeta_usuarios(oculto)
            + tarjeta_backup_remoto(oculto) + '</div></body></html>')


def pagina_mapflights(s, aviso='', error=''):
    """Integración adicional ADS-B: diagnóstico privado, sin exponer UUID ni ejecutar cambios."""
    try:
        with open(ENV_ETC, encoding='utf-8') as f:
            f.read()
        env = leer_env()
    except OSError as x:
        error = 'No se puede leer la configuración de la integración: %s' % x
        env = {}
    habilitado = env.get('MAPFLIGHTS_FEED', 'no').lower() in ('yes', 'si', 'sí', 'true', '1')
    uuid = env.get('MAPFLIGHTS_UUID', '').strip().replace('-', '')
    uuid_ok = bool(re.fullmatch(r'[0-9a-fA-F]{32}', uuid))
    filas = []
    for unidad in ('readsb', 'rbfeeder', 'bricohams-mapflights-mlat'):
        _, _, estado = estado_unidad(unidad)
        filas.append('<tr><th>%s</th><td>%s</td></tr>' % (e(unidad), e(estado)))
    return (cabecera('map.flights', MAPFLIGHTS) + '<h1>map.flights · integración ADS-B</h1>'
            + avisos(aviso, error)
            + '<p>Destino adicional a RadarBox. El envío lo realiza readsb, no el navegador; '
              'continúa aunque cierres esta página.</p>'
            + '<h2>Configuración guardada</h2><ul><li>Envío solicitado: <b>%s</b></li>'
              '<li>UUID: %s (valor privado, no se muestra)</li></ul>' % (
                  'activado' if habilitado else 'desactivado',
                  'formato válido' if uuid_ok else 'ausente o formato no válido')
            + '<table class="table"><tr><th>Servicio</th><th>Estado local</th></tr>%s</table>' % ''.join(filas)
            + '<p>Un servicio activo no confirma que map.flights esté recibiendo posiciones. '
              'La configuración guardada tampoco confirma que se haya aplicado el conector.</p>'
            + '<h2>Activar con seguridad</h2><ol>'
              '<li>Crear y verificar una copia de los archivos, configuración y datos afectados; '
              'guardar su ubicación y el procedimiento de restauración. Si falla, detenerse.</li>'
              '<li>En el <code>bricohams.env</code> del kit, establecer '
              '<code>MAPFLIGHTS_FEED="yes"</code> y el UUID propio en '
              '<code>MAPFLIGHTS_UUID</code>. No usar la clave <code>mf_feed_</code>.</li>'
              '<li>Conservar <code>RADARBOX_KEY</code>. Aplicar desde la carpeta del kit:</li></ol>'
              '<pre>sudo bash install.sh --solo adsb\nsudo bricohams-check</pre>'
              '<p>Aplicar ADS-B reinicia brevemente readsb y rbfeeder. No elimina RadarBox. '
              'MLAT map.flights es independiente y usa el mismo UUID; no reinyecta resultados.</p>'
            + '<h2>Comprobar ambos destinos</h2><pre>'
              'systemctl status readsb rbfeeder --no-pager\n'
              'systemctl status bricohams-mapflights-mlat --no-pager</pre>'
              '<p>El servicio MLAT solo se espera si está habilitado. Revisar su journal '
              'localmente (puede contener el UUID) y confirmar posiciones en ambos portales.</p>'
              '<p>Destinos predeterminados: <code>feed.map.flights:30004</code> (Beast), '
              '<code>mlat.map.flights:31090</code> (MLAT).</p>'
              '<p><a href="https://map.flights/es/stations/build" rel="noreferrer noopener">'
              'Procedimiento oficial de map.flights</a></p>'
            + '<h2>Desactivar solo map.flights</h2><p>Con copia verificada, cambiar '
              '<code>MAPFLIGHTS_FEED="no"</code> en el kit y repetir el paso ADS-B. '
              'Para recuperar el estado anterior, seguir la restauración de la copia.</p>'
              '<p>Panel de solo lectura: no guarda claves, no reinicia servicios y no '
              'envía datos a terceros desde el navegador.</p></div></div></div></body></html>')


PAGINAS = {BASE: pagina, APRS: pagina_aprs, TAK: pagina_tak, MONITOR: pagina_monitor,
           SEGURIDAD: pagina_seguridad, MAPFLIGHTS: pagina_mapflights}
# acciones que acepta cada página; la de Meshtastic no puede tocar TAK, monitorización ni seguridad
ACCIONES = {APRS: re.compile(r'^reiniciarrak$'), TAK: re.compile(r'^tak-'), MONITOR: re.compile(r'^mon-'),
            SEGURIDAD: re.compile(r'^seg-[a-z]+$'), BASE: re.compile(r'^(?!tak-|mon-|seg-)')}


def posiciones_tak():
    """Consulta local de solo lectura bajo la identidad PostgreSQL del servicio TAK."""
    sql = """
        SELECT COALESCE(json_agg(n), '[]'::json) FROM (
            SELECT DISTINCT ON (p.device_uid)
                p.device_uid AS uid, COALESCE(e.callsign, p.device_uid) AS callsign,
                p.latitude AS lat, p.longitude AS lon,
                EXTRACT(EPOCH FROM p.timestamp AT TIME ZONE 'UTC') * 1000 AS timestamp
            FROM points p JOIN euds e ON e.uid = p.device_uid
            JOIN cot c ON c.id = p.cot_id
            WHERE p.latitude BETWEEN -90 AND 90 AND p.longitude BETWEEN -180 AND 180
                AND c.stale > (CURRENT_TIMESTAMP AT TIME ZONE 'UTC')
            ORDER BY p.device_uid, p.timestamp DESC, p.id DESC LIMIT 1000
        ) n
    """
    r = subprocess.run(['runuser', '-u', 'opentakserver', '--', 'psql', '-X', '-q', '-A', '-t',
                        '--set=ON_ERROR_STOP=1', '--host=/var/run/postgresql',
                        '--dbname=bricohams_tak', '--command', sql],
                       capture_output=True, text=True, timeout=5,
                       env={**os.environ, 'PGOPTIONS': '-c statement_timeout=3000 -c default_transaction_read_only=on'})
    if r.returncode:
        raise RuntimeError('PostgreSQL TAK no disponible')
    datos = json.loads(r.stdout)
    if not isinstance(datos, list):
        raise ValueError('respuesta TAK no valida')
    return {'nodes': datos}


class Manejador(http.server.BaseHTTPRequestHandler):
    server_version = 'bricohams-mesh-admin'
    sys_version = ''

    def log_message(self, fmt, *a):
        pass

    def _enviar(self, codigo, cuerpo=b'', tipo='text/html; charset=utf-8', cabeceras=()):
        self.send_response(codigo)
        self.send_header('Content-Type', tipo)
        self.send_header('Content-Length', str(len(cuerpo)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Robots-Tag', 'noindex')
        self.send_header('Content-Security-Policy', "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; form-action 'self'; frame-ancestors 'self'")
        for k, v in cabeceras:
            self.send_header(k, v)
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(cuerpo)

    def _sesion(self):
        s = sesion_owrx(self.headers.get('Cookie'))
        return s if autorizado(s) else None

    def _ruta(self):
        return urlsplit(self.path).path.rstrip('/')

    def do_GET(self):
        ruta = self._ruta()
        if ruta == AUTH:
            # auth_request de nginx para el cliente web de Meshtastic (:8443): 204 admin, 401 el resto
            ok = autorizado_cache(sesion_owrx(self.headers.get('Cookie')))
            return self._enviar(204 if ok else 401, tipo='text/plain; charset=utf-8')
        if ruta == TAK_POSICIONES:
            if not self._sesion():
                return self._enviar(401, b'{"error":"sesion de administrador necesaria"}', 'application/json')
            try:
                datos = posiciones_tak()
            except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as e:
                print('mapa TAK: %s' % e, file=sys.stderr, flush=True)
                return self._enviar(503, b'{"error":"TAK no disponible"}', 'application/json')
            return self._enviar(200, json.dumps(datos).encode(), 'application/json')
        if ruta not in PAGINAS and ruta != '/settings/bricohams':
            return self._enviar(404, b'no encontrado', 'text/plain; charset=utf-8')
        s = self._sesion()
        if not s:
            destino = ruta if ruta in PAGINAS else BASE
            return self._enviar(302, cabeceras=[('Location', '/login?ref=' + destino.lstrip('/'))])
        if ruta not in PAGINAS:
            return self._enviar(302, cabeceras=[('Location', BASE)])
        return self._enviar(200, self._pagina(ruta, s).encode('utf-8'))

    def _pagina(self, ruta, s, aviso='', error='', mostrar=False):
        if ruta == TAK:
            return pagina_tak(s, aviso, error, host=self.headers.get('Host', ''), mostrar=mostrar)
        if ruta == MONITOR:
            return PAGINAS[ruta](s, aviso, error, host=self.headers.get('Host', ''))
        return PAGINAS[ruta](s, aviso, error)

    do_HEAD = do_GET

    def _mismo_origen(self):
        host = (self.headers.get('Host') or '').split(':')[0].lower()
        for cab in ('Origin', 'Referer'):
            v = self.headers.get(cab)
            if v:
                return (urlsplit(v).hostname or '').lower() == host and bool(host)
        return False

    def do_POST(self):
        ruta = self._ruta()
        if ruta == MAPFLIGHTS:
            if not self._sesion():
                return self._enviar(403, b'sesion de administrador necesaria', 'text/plain; charset=utf-8')
            return self._enviar(405, b'panel de solo lectura', 'text/plain; charset=utf-8',
                                [('Allow', 'GET, HEAD')])
        if ruta not in PAGINAS:
            return self._enviar(404, b'no encontrado', 'text/plain; charset=utf-8')
        s = self._sesion()
        if not s:
            return self._enviar(403, b'sesion de administrador necesaria', 'text/plain; charset=utf-8')
        try:
            largo = int(self.headers.get('Content-Length', '0'))
        except ValueError:
            largo = 0
        if largo <= 0 or largo > 16384:
            return self._enviar(400, b'peticion no valida', 'text/plain; charset=utf-8')
        campos = {k: v[0] for k, v in parse_qs(self.rfile.read(largo).decode('utf-8', 'replace')).items()}
        if not (self._mismo_origen() and hmac.compare_digest(campos.get('csrf', ''), token(s))):
            return self._enviar(403, b'origen no valido', 'text/plain; charset=utf-8')
        aviso = error = ''
        mostrar = False
        try:
            if not ACCIONES[ruta].match(campos.get('accion', '')):
                raise ValueError('acción desconocida')
            if ruta == TAK and campos.get('accion') == 'tak-credenciales':
                mostrar = True
                aviso = 'Credenciales visibles solo en esta respuesta; recarga la página para ocultarlas.'
            else:
                aviso = accion(campos)
        except (ValueError, OSError) as x:
            error = str(x)
        return self._enviar(200, self._pagina(ruta, s, aviso, error, mostrar).encode('utf-8'))


class Servidor(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def main(a):
    if len(a) >= 4 and a[1] == 'leer':
        try:
            print(json.dumps(leer_nodo(a[2], a[3]), ensure_ascii=False))
        except Exception as x:
            print(json.dumps({'ok': False, 'error': tapar(str(x))[:300]}, ensure_ascii=False))
        return 0
    if len(a) >= 2 and a[1] == 'servicio':
        Servidor(('127.0.0.1', PUERTO), Manejador).serve_forever()
        return 0
    print(open(__file__, encoding='utf-8').read().split('# =====')[1].replace('\n#  ', '\n').strip('#=\n '))
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
