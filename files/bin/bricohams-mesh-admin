        priv = ''
        if n == '868':
            priv = '<p class="small">Canal privado: %s</p>' % (
                e(env.get('MESH868_PRIVATE_NAME', 'BricoHams')) + ' configurado (clave en bricohams.env)'
                if env.get('MESH868_PRIVATE_PSK') else 'no')
        partes.append('''
