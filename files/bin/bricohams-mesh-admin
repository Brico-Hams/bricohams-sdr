# ---------------------------------------------------------------- bricohams.env
def leer_env(ruta=None):
    """{CLAVE: valor} con las mismas reglas que bricohams-mesh-owrx (sin ejecutar nada)."""
    d = {}
    try:
        for l in open(ruta or ENV_ETC, encoding='utf-8'):
            m = re.match(r'^\s*(?:export\s+)?([A-Z][A-Z0-9_]*)=(.*)$', l)
            if not m:
                continue
            v = m.group(2).strip()
            fin = v.find(v[0], 1) if v[:1] in ('"', "'") else -1
            v = v[1:fin] if fin > 0 else re.sub(r'\s+#.*$', '', v)
            d[m.group(1)] = v
    except OSError:
        pass
    return d


def valor_seguro(v):
    if PROHIBIDOS.search(v):
        raise ValueError('el valor lleva comillas, «$», «\\» o saltos de línea')
    return v


def escribir_env(ruta, cambios, comilla='"'):
    """Cambia o añade CLAVE=valor conservando el resto (y los comentarios de la línea).
    Se escribe en el sitio: mismo dueño y permisos (bricohams.env es 600: lleva claves)."""
    for v in cambios.values():
        valor_seguro(v)
    with open(ruta, 'r+', encoding='utf-8') as f:
        lineas = f.read().splitlines(True)
        hechos = set()
        for i, l in enumerate(lineas):
            m = re.match(r'^(\s*(?:export\s+)?)([A-Z][A-Z0-9_]*)=(.*?)(\r?\n)?$', l)
            if not m or m.group(2) not in cambios:
                continue
            v, q, resto = m.group(3), comilla, ''
            if v[:1] in ('"', "'"):
                q = v[0]
                fin = v.find(q, 1)
                resto = v[fin + 1:] if fin > 0 else ''
            else:
                c = re.search(r'\s+#.*$', v)
                resto = c.group(0) if c else ''
            lineas[i] = '%s%s=%s%s%s%s%s' % (m.group(1), m.group(2), q, cambios[m.group(2)], q, resto, m.group(4) or '\n')
            hechos.add(m.group(2))
        if lineas and not lineas[-1].endswith('\n'):
            lineas[-1] += '\n'
        for k, v in cambios.items():
            if k not in hechos:
                lineas.append('%s=%s%s%s\n' % (k, comilla, v, comilla))
        f.seek(0)
        f.write(''.join(lineas))
        f.truncate()


def guardar(cambios):
    """bricohams.env del kit (manda en la próxima instalación) y la copia de /etc (la leen los servicios)."""
    if ENV_KIT and os.path.isfile(ENV_KIT):
        escribir_env(ENV_KIT, cambios, '"')
    escribir_env(ENV_ETC, cambios, "'")


def si(v, d='no'):
    return (v or d).strip().lower() in ('1', 'yes', 'si', 'sí', 'true', 'on')


# ---------------------------------------------------------------- URL de canales (sin claves)
def _mesh_url():
    for ruta in (os.environ.get('MESH_URL_CLI', '/usr/local/bin/bricohams-mesh-url'),
                 os.path.join(os.path.dirname(os.path.abspath(__file__)), 'bricohams-mesh-url')):
        if os.path.isfile(ruta):
            cargador = importlib.machinery.SourceFileLoader('bricohams_mesh_url', ruta)
            spec = importlib.util.spec_from_loader('bricohams_mesh_url', cargador)
            mod = importlib.util.module_from_spec(spec)
            cargador.exec_module(mod)
            return mod
    return None


def resumen_url(url):
    """(canales, radio) de una URL de Meshtastic: nombres y TIPO de clave, nunca la clave."""
    mod = _mesh_url()
    if not url or mod is None:
        return [], {}
    return mod.leer(url)


def validar_url(url, region):
    if not URL_RE.match(url):
        raise ValueError('la URL debe ser https://meshtastic.org/e/#…')
    try:
        canales, radio = resumen_url(url)
    except Exception:
        raise ValueError('la URL de Meshtastic no se puede leer (¿mal copiada?)')
    if not canales:
        raise ValueError('la URL no trae canales')
    if radio.get('region') not in (None, '', region):
        raise ValueError('la URL es de %s y este nodo es %s' % (radio.get('region'), region))
    return url


def validar_nombres(largo, corto):
    largo, corto = largo.strip(), corto.strip()
    if not largo or len(largo.encode('utf-8')) > 39:
        raise ValueError('nombre largo: de 1 a 39 bytes')
    if not corto or len(corto) > 4:
        raise ValueError('nombre corto: de 1 a 4 caracteres')
    return valor_seguro(largo), valor_seguro(corto)


# ---------------------------------------------------------------- lectura del nodo (subproceso)
def _enum(msg, campo):
    try:
        v = getattr(msg, campo)
        return msg.DESCRIPTOR.fields_by_name[campo].enum_type.values_by_number[v].name
    except Exception:
        return None


def leer_nodo(tipo, destino):
    """Estado del nodo en un dict apto para la web: sin PSK ni URL."""
    import meshtastic.serial_interface
    import meshtastic.tcp_interface
    if tipo == 'serie':
        i = meshtastic.serial_interface.SerialInterface(devPath=destino)
    else:
        i = meshtastic.tcp_interface.TCPInterface(hostname=destino)
    try:
        num = i.myInfo.my_node_num if i.myInfo else None
        yo = (i.nodesByNum or {}).get(num, {}) if num is not None else {}
        u = yo.get('user', {})
        ln = i.localNode
        lc = ln.localConfig
        canales = []
        for c in (ln.channels or []):
            rol = _enum(c, 'role')
            if rol in (None, 'DISABLED'):
                continue
            psk = bytes(c.settings.psk or b'')
            clave = 'sin cifrar' if not psk else ('pública (por defecto)' if len(psk) == 1 else 'propia AES-%d' % (len(psk) * 8))
            canales.append({'indice': c.index, 'nombre': c.settings.name or '(principal)', 'rol': rol, 'clave': clave})
        pos = yo.get('position', {})
        meta = getattr(i, 'metadata', None)
        return {
            'ok': True, 'num': '!%08x' % num if num is not None else '',
            'largo': u.get('longName', ''), 'corto': u.get('shortName', ''), 'hw': u.get('hwModel', ''),
            'firmware': getattr(meta, 'firmware_version', '') if meta else '',
            'rol': _enum(lc.device, 'role'), 'region': _enum(lc.lora, 'region'),
            'preset': _enum(lc.lora, 'modem_preset'), 'potencia': lc.lora.tx_power, 'saltos': lc.lora.hop_limit,
            'canales': canales, 'nodos_oidos': max(len(i.nodes or {}) - 1, 0),
            'lat': round(pos['latitude'], 3) if 'latitude' in pos else None,
            'lon': round(pos['longitude'], 3) if 'longitude' in pos else None,
        }
    finally:
        i.close()


# ---------------------------------------------------------------- trabajos (uno a la vez)
class Trabajo:
    def __init__(self):
        self.cerrojo = threading.Lock()
        self.activo = False
        self.titulo = ''
        self.log = []
        self.fin = None
        self.lecturas = {}

    def apunta(self, texto):
        for l in tapar(str(texto)).splitlines():
            if l.strip():
                self.log.append(time.strftime('%H:%M:%S ') + l.rstrip())
        del self.log[:-200]

    def lanzar(self, titulo, fn, soltar_mapa=True):
        with self.cerrojo:
            if self.activo:
                return False
            self.activo, self.titulo, self.log, self.fin = True, titulo, [], None
        threading.Thread(target=self._correr, args=(fn, soltar_mapa), daemon=True).start()
        return True

    def _correr(self, fn, soltar_mapa):
        mapa = soltar_mapa and systemctl('is-active', '--quiet', SERVICIO_MAPA) == 0
        try:
            if mapa:
                self.apunta('Paro %s mientras tanto (el puerto es de uno solo)' % SERVICIO_MAPA)
                systemctl('stop', SERVICIO_MAPA)
                time.sleep(2)
            fn(self)
            self.apunta('✔ Terminado')
        except Exception as e:
            self.apunta('✘ %s' % e)
        finally:
            if mapa:
                systemctl('start', SERVICIO_MAPA)
                self.apunta('%s arrancado de nuevo' % SERVICIO_MAPA)
            self.fin = time.time()
            self.activo = False


TRABAJO = Trabajo()


def tapar(s):
    """Nada de claves en el registro de la web."""
    s = re.sub(r'(meshtastic\.org/e/#?)[A-Za-z0-9_-]+', r'\1…', s)
    s = re.sub(r'(?i)(psk\S*\s*[:=]?\s*)(base64:)?[A-Za-z0-9+/=]{8,}', r'\1…', s)
    s = re.sub(r'(?i)("?(?:access_token|refresh_token|token|pass(?:word)?|secret)"?\s*[:=]\s*)("[^"]*"|\S+)', r'\1…', s)
    s = re.sub(r'eyJ[A-Za-z0-9_.-]{20,}', '…', s)
    return re.sub(r'base64:[A-Za-z0-9+/=]+', 'base64:…', s)


def systemctl(*a):
    try:
        return subprocess.run(['systemctl'] + list(a), capture_output=True, timeout=60).returncode
    except Exception:
        return 1


def destino(nodo, env):
    if nodo == '433':
        return 'serie', env.get('MESH433_PUERTO', '/dev/lilygo-mesh')
    return 'tcp', env.get('MESH868_HOST', '127.0.0.1')


def cli(t, nodo, env, args, espera=0):
    tipo, dest = destino(nodo, env)
    if tipo == 'serie' and not os.path.exists(dest):
        raise RuntimeError('no existe %s: sudo bricohams-dispositivos identificar' % dest)
    cmd = [sys.executable, '-m', 'meshtastic'] + (['--port', dest] if tipo == 'serie' else ['--host', dest]) + args
    vista = [a if not a.startswith(('https://meshtastic.org', 'base64:')) else '…' for a in args]
    t.apunta('meshtastic %s' % ' '.join(vista))
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=150)
    t.apunta('\n'.join((r.stdout + r.stderr).splitlines()[-6:]))
    if r.returncode != 0:
        raise RuntimeError('meshtastic terminó con error %d' % r.returncode)
    if espera:
        time.sleep(espera)


def tarea_leer(nodos):
    def fn(t):
        env = leer_env()
        for n in nodos:
            tipo, dest = destino(n, env)
            if tipo == 'serie' and not os.path.exists(dest):
                TRABAJO.lecturas[n] = {'ok': False, 'error': 'no existe %s' % dest, 'hora': time.time()}
                t.apunta('%s: no existe %s' % (n, dest))
                continue
            t.apunta('Leyendo el nodo %s (%s)…' % (n, dest))
            try:
                r = subprocess.run([sys.executable, os.path.abspath(__file__), 'leer', tipo, dest],
                                   capture_output=True, text=True, timeout=120)
                datos = json.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else {}
                if not datos.get('ok'):
                    datos = {'ok': False, 'error': datos.get('error') or tapar(r.stderr.strip()[-300:]) or 'sin respuesta'}
            except subprocess.TimeoutExpired:
                datos = {'ok': False, 'error': 'el nodo no responde (120 s)'}
            except ValueError:
                datos = {'ok': False, 'error': 'respuesta ilegible'}
            datos['hora'] = time.time()
            TRABAJO.lecturas[n] = datos
            t.apunta('%s: %s' % (n, 'leído' if datos.get('ok') else datos.get('error')))
    return fn


def tarea_aplicar(nodo):
    def fn(t):
        env = leer_env()
        cfg = NODOS[nodo]
        url = env.get(cfg['url'], '')
        if nodo == '433':
            if url:
                cli(t, nodo, env, ['--seturl', url], 20)
            elif si(env.get('MESH433_CHANNELS'), 'yes') and env.get('MESH_CHANNEL_URL'):
                cli(t, nodo, env, ['--seturl', env['MESH_CHANNEL_URL']], 20)
                cli(t, nodo, env, ['--set', 'lora.region', 'EU_433', '--set', 'lora.use_preset', 'true',
                                   '--set', 'lora.override_frequency', '0', '--set', 'lora.tx_power', '0'], 15)
                cli(t, nodo, env, ['--set', 'lora.modem_preset', 'LONG_FAST'], 10)
            else:
                cli(t, nodo, env, ['--set', 'lora.region', 'EU_433'], 15)
        else:
            if url:
                cli(t, nodo, env, ['--seturl', url], 20)
            else:
                cli(t, nodo, env, ['--set', 'lora.region', env.get('MESH_REGION', 'EU_868')], 15)
            psk = env.get('MESH868_PRIVATE_PSK', '')
            if psk:
                try:
                    n = len(resumen_url(url)[0]) if url else 1
                except Exception:
                    n = 1
                if n < 8:
                    cli(t, nodo, env, ['--ch-add', env.get('MESH868_PRIVATE_NAME', 'BricoHams')], 10)
                    cli(t, nodo, env, ['--ch-index', str(n), '--ch-set', 'psk', 'base64:' + psk], 10)
                else:
                    t.apunta('La URL ya trae 8 canales: no cabe el canal privado')
        cli(t, nodo, env, ['--set-owner', env.get(cfg['largo'], cfg['def_largo']),
                           '--set-owner-short', env.get(cfg['corto'], cfg['def_corto'])], 10)
        if cfg['rol']:
            cli(t, nodo, env, ['--set', 'device.role', env.get(cfg['rol'], 'CLIENT')], 10)
        if env.get('STATION_LAT') and env.get('STATION_LON'):
            cli(t, nodo, env, ['--setlat', env['STATION_LAT'], '--setlon', env['STATION_LON'],
                               '--setalt', env.get('STATION_ASL', '0')], 5)
        try:
            cli(t, nodo, env, ['--set', 'position.gps_mode', 'NOT_PRESENT'])
        except RuntimeError:
            pass
        tarea_leer([nodo])(t)
    return fn


def tarea_reiniciar(servicio):
    def fn(t):
        t.apunta('systemctl restart %s' % servicio)
        rc = systemctl('restart', servicio)
        time.sleep(3)
        estado = 'activo' if systemctl('is-active', '--quiet', servicio) == 0 else 'NO arranca (journalctl -u %s)' % servicio
        t.apunta('%s: %s' % (servicio, estado))
        if rc != 0:
            raise RuntimeError('no se pudo reiniciar %s' % servicio)
    return fn


def estado_unidad(u):
    """(cargada, activa, texto) de una unidad systemd, sin lanzar nada."""
    try:
        r = subprocess.run(['systemctl', 'show', '-p', 'LoadState,ActiveState,SubState,UnitFileState', '--', u + '.service'],
                           capture_output=True, text=True, timeout=10)
        d = dict(l.split('=', 1) for l in r.stdout.splitlines() if '=' in l)
    except (OSError, subprocess.TimeoutExpired):
        d = {}
    if d.get('LoadState') != 'loaded':
        return False, False, 'no instalado'
    activa = d.get('ActiveState') == 'active'
    return True, activa, '%s (%s) · %s' % (d.get('ActiveState', '?'), d.get('SubState', '?'), d.get('UnitFileState', '?'))


def registro(u, lineas=40):
    """Últimas líneas del journal de una unidad, con secretos tapados."""
    try:
        r = subprocess.run(['journalctl', '-u', u + '.service', '-n', str(lineas), '--no-pager', '-o', 'short-iso'],
                           capture_output=True, text=True, timeout=15)
        t = r.stdout or r.stderr
    except (OSError, subprocess.TimeoutExpired) as x:
        t = str(x)
    return re.sub(r'(?i)((?:pass(?:word)?|token|secret|key)\S*\s*[:=]\s*)\S+', r'\1…', tapar(t))


def tarea_unidades(verbo, unidades):
    """start/stop/restart en orden (parar: al revés, primero lo que depende de lo demás)."""
    def fn(t):
        orden = list(reversed(unidades)) if verbo == 'stop' else list(unidades)
        fallos = []
        for u in orden:
            if not estado_unidad(u)[0]:
                t.apunta('%s: no instalado, lo salto' % u)
                continue
            t.apunta('systemctl %s %s' % (verbo, u))
            if systemctl(verbo, u + '.service') != 0:
                fallos.append(u)
        time.sleep(3)
        for u in unidades:
            t.apunta('%s: %s' % (u, estado_unidad(u)[2]))
        if fallos:
            raise RuntimeError('fallo en %s (mira journalctl -u …)' % ', '.join(fallos))
    return fn


VERBOS = {'arrancar': 'start', 'parar': 'stop', 'reiniciar': 'restart'}


def accion_servicios(a):
    """tak-<verbo>[-<unidad>] y mon-<verbo>[-<unidad>]; solo unidades de la lista blanca."""
    grupo, _, resto = a.partition('-')
    unidades = TAK_UNIDADES if grupo == 'tak' else MON_UNIDADES
    verbo, _, unidad = resto.partition('-')
    if verbo not in VERBOS:
        raise ValueError('acción desconocida')
    if unidad:
        if unidad not in unidades:
            raise ValueError('servicio no permitido')
        unidades = (unidad,)
    nombre = 'TAK' if grupo == 'tak' else 'monitorización'
    if not TRABAJO.lanzar('%s %s: %s' % (verbo.capitalize(), nombre, ' '.join(unidades)),
                          tarea_unidades(VERBOS[verbo], unidades), soltar_mapa=False):
        return 'Hay otro trabajo en marcha; espera a que termine.'
    return 'Orden enviada: %s %s…' % (verbo, ', '.join(unidades))


# ---------------------------------------------------------------- credenciales TAK
def leer_acceso_tak():
    """[(usuario, clave)] de tak-access.txt (lo escribe instalar_tak.sh); el primero es el administrador."""
    pares = []
    try:
        with open(TAK_ACCESO, encoding='utf-8') as f:
            for linea in f:
                u, sep, c = linea.strip().partition(':')
                if sep and USUARIO_TAK.match(u.strip()):
                    pares.append((u.strip(), c.strip()))
    except OSError:
        return []
    return pares


def escribir_acceso_tak(pares):
    tmp = TAK_ACCESO + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(''.join('%s: %s\n' % p for p in pares))
    os.chmod(tmp, 0o600)
    os.replace(tmp, TAK_ACCESO)


# usuario y clave entran por stdin: nunca en la línea de órdenes (se verían en ps)
SCRIPT_CLAVE_TAK = r'''
import sys
from datetime import datetime, timezone
usuario, clave = sys.stdin.read().split('\n')[:2]
from flask_security import hash_password
from opentakserver.app import create_app
from opentakserver.extensions import db
app = create_app()
with app.app_context():
    u = app.security.datastore.find_user(username=usuario)
    if u is None:
        sys.exit(3)
    u.password = hash_password(clave)
    u.active = True
    # una cuenta sin confirmar no puede entrar aunque la clave sea buena
    if getattr(u, 'confirmed_at', 1) is None:
        u.confirmed_at = datetime.now(timezone.utc).replace(tzinfo=None)
    db.session.commit()
print('ok')
'''


def tarea_clave_tak(usuario, clave):
    def fn(t):
        t.apunta('Cambiando la clave de %s en OpenTAKServer…' % usuario)
        r = subprocess.run(['runuser', '-u', 'opentakserver', '--', 'env', 'HOME=' + TAK_HOME,
                            'FLASK_APP=opentakserver.app', TAK_PYTHON, '-c', SCRIPT_CLAVE_TAK],
                           input=usuario + '\n' + clave + '\n', capture_output=True, text=True,
                           timeout=180, cwd=os.path.join(TAK_HOME, 'ots'))
        if r.returncode == 3:
            raise RuntimeError('el usuario %s no existe en OpenTAKServer' % usuario)
        if r.returncode or 'ok' not in r.stdout.split():
            raise RuntimeError('OpenTAKServer no aceptó el cambio (código %d)' % r.returncode)
        escribir_acceso_tak([(u, clave if u == usuario else c) for u, c in leer_acceso_tak()])
        t.apunta('Clave de %s cambiada y guardada en %s' % (usuario, TAK_ACCESO))
    return fn


def accion_clave_tak(campos):
    usuario = campos.get('usuario', '')
    if usuario not in [u for u, _ in leer_acceso_tak()]:
        raise ValueError('usuario TAK no permitido')
    if campos.get('generar') == 'yes':
        clave = secrets.token_urlsafe(24)
    else:
        clave = campos.get('clave', '')
        if clave != campos.get('clave2', ''):
            raise ValueError('las dos claves no coinciden')
        if not CLAVE_TAK.match(clave):
            raise ValueError('la clave debe tener entre 12 y 128 caracteres ASCII visibles, sin espacios')
    if not estado_unidad('bricohams-tak')[0]:
        raise ValueError('el servidor TAK no está instalado')
    if not TRABAJO.lanzar('Cambiar la clave TAK de %s' % usuario, tarea_clave_tak(usuario, clave), soltar_mapa=False):
        return 'Hay otro trabajo en marcha; espera a que termine.'
    return 'Cambiando la clave de %s… cuando termine pulsa «Mostrar credenciales».' % usuario


# ---------------------------------------------------------------- backup remoto (página Seguridad)
BR_USUARIO = re.compile(r'^[A-Za-z0-9._@-]{1,64}$')
BR_DOMINIO = re.compile(r'^[A-Za-z0-9.-]{1,64}$')
BR_SERVIDOR = re.compile(r'^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*'
                         r'|\[?[0-9A-Fa-f:.]{2,45}\]?)$')
BR_RUTA = re.compile(r'^[A-Za-z0-9 ._/@+-]{0,200}$')
BR_UNC = re.compile(r'^(?:\\\\|//)[A-Za-z0-9.-]{1,253}[\\/][A-Za-z0-9 $._+-]{1,80}(?:[\\/][A-Za-z0-9 $._+-]{1,80}){0,10}[\\/]?$')
BR_NFS = re.compile(r'^[A-Za-z0-9.-]{1,253}:/[A-Za-z0-9 ._/+-]{0,200}$')
BR_DRIVE_ID = re.compile(r'^[A-Za-z0-9!._-]{1,128}$')


def leer_json(ruta, defecto=None):
    try:
        with open(ruta, encoding='utf-8') as f:
            d = json.load(f)
        return d if isinstance(d, dict) else (defecto or {})
    except (OSError, ValueError):
        return defecto or {}


def escribir_json_seguro(ruta, datos, modo=0o600):
    """Escritura atómica: fichero temporal exclusivo con permisos ya restringidos y os.replace."""
    tmp = '%s.%s.tmp' % (ruta, secrets.token_hex(6))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, modo)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(datos, f, ensure_ascii=False, indent=1)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, modo)
        os.replace(tmp, ruta)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def br_validar(campos, actual):
    """Configuración sin secretos a partir del formulario; ValueError si algo no cuadra."""
    p = campos.get('protocolo', '')
    if p not in BR_PROTOCOLOS:
        raise ValueError('protocolo de backup no válido')
    c = {'protocolo': p}
    usuario = campos.get('usuario', '').strip()
    if '\\' in usuario:
        dom, usuario = usuario.split('\\', 1)
        campos = dict(campos, dominio=campos.get('dominio') or dom)
    if usuario and not BR_USUARIO.match(usuario):
        raise ValueError('usuario no válido (letras, números y . _ @ -; máximo 64)')
    if p == 'cifs':
        d = campos.get('destino', '').strip()
        if not BR_UNC.match(d):
            raise ValueError('ruta SMB no válida; usa \\\\servidor\\recurso\\carpeta')
        dominio = campos.get('dominio', '').strip()
        if dominio and not BR_DOMINIO.match(dominio):
            raise ValueError('dominio no válido')
        v = campos.get('smb_version', '3.0')
        if v not in ('2.1', '3.0', '3.1.1'):
            raise ValueError('versión SMB no válida')
        if not usuario:
            raise ValueError('SMB necesita usuario')
        c.update(destino=d, usuario=usuario, dominio=dominio, smb_version=v)
    elif p == 'nfs':
        d = campos.get('destino', '').strip()
        if not BR_NFS.match(d):
            raise ValueError('export NFS no válido; usa servidor:/ruta')
        v = campos.get('nfs_version', '4')
        if v not in ('3', '4', '4.1', '4.2'):
            raise ValueError('versión NFS no válida')
        c.update(destino=d, nfs_version=v)
    else:
        ruta = campos.get('ruta', '').strip().strip('/') or 'bricohams-backup'
        if not BR_RUTA.match(ruta) or '..' in ruta.split('/'):
            raise ValueError('carpeta remota no válida')
        c['ruta'] = ruta
        if p == 'sftp':
            servidor = campos.get('servidor', '').strip()
            if not BR_SERVIDOR.match(servidor):
                raise ValueError('servidor SFTP no válido')
            try:
                puerto = int(campos.get('puerto', '22') or '22')
            except ValueError:
                puerto = 0
            if not 1 <= puerto <= 65535:
                raise ValueError('puerto no válido')
            if not usuario:
                raise ValueError('SFTP necesita usuario')
            if servidor != actual.get('servidor') or puerto != actual.get('puerto'):
                c['huella_reset'] = True
            c.update(servidor=servidor, puerto=puerto, usuario=usuario)
        elif p == 'onedrive':
            drive_id = campos.get('drive_id', '').strip()
            if not BR_DRIVE_ID.match(drive_id):
                raise ValueError('drive_id de OneDrive no válido o vacío (rclone config lo muestra)')
            tipo = campos.get('drive_type', 'personal')
            if tipo not in ('personal', 'business', 'documentLibrary'):
                raise ValueError('tipo de OneDrive no válido')
            c.update(drive_id=drive_id, drive_type=tipo)
    try:
        ret = int(campos.get('retencion', '14') or '14')
    except ValueError:
        ret = 0
    if not 1 <= ret <= 365:
        raise ValueError('la retención debe estar entre 1 y 365 copias')
    c['retencion'] = ret
    c['incluir_secretos'] = campos.get('incluir_secretos') == 'yes'
    c['programado'] = campos.get('programado') == 'yes'
    return c


def br_secretos(campos, p, previo):
    """Contraseña / token nuevos; un campo vacío conserva lo guardado (nunca se devuelve al navegador)."""
    s = {k: v for k, v in previo.items() if k in ('password', 'token')}
    clave = campos.get('password', '')
    if clave:
        if clave != campos.get('password2', ''):
            raise ValueError('las dos contraseñas no coinciden')
        if len(clave) > 256 or any(ch in clave for ch in '\r\n\x00'):
            raise ValueError('contraseña no válida (máximo 256 caracteres, sin saltos de línea)')
        s['password'] = clave
    tok = campos.get('token', '').strip()
    if tok:
        if len(tok) > 8192:
            raise ValueError('token demasiado largo')
        try:
            d = json.loads(tok)
        except ValueError:
            raise ValueError('el token debe ser el JSON que devuelve «rclone authorize»') from None
        if not isinstance(d, dict) or not isinstance(d.get('access_token'), str):
            raise ValueError('el token no contiene access_token')
        s['token'] = json.dumps(d, separators=(',', ':'))
    if p in ('cifs', 'sftp') and not s.get('password'):
        raise ValueError('falta la contraseña')
    if p in ('gdrive', 'onedrive') and not s.get('token'):
        raise ValueError('falta el token OAuth (rclone authorize)')
    return s


def br_programar(si):
    r = subprocess.run(['systemctl', 'enable' if si else 'disable', '--now', BR_UNIDAD + '.timer'],
                       capture_output=True, text=True, timeout=60)
    if r.returncode:
        raise OSError('no se pudo %s la copia programada' % ('activar' if si else 'desactivar'))


# ---------------------------------------------------------------- bloqueo por IP / país
def bloqueo_red(texto):
    """IP o red pública normalizada; ValueError si no lo es o toca la LAN (mismo criterio que el helper)."""
    texto = (texto or '').strip()
    if not texto or len(texto) > 49:
        raise ValueError('dirección vacía o demasiado larga')
    try:
        red = ipaddress.ip_network(texto, strict=False)
    except ValueError:
        raise ValueError('%s no es una IP ni una red válida' % texto[:49])
    if red.prefixlen < (8 if red.version == 4 else 16):
        raise ValueError('%s: red demasiado grande' % texto)
    for p in BLOQUEO_PROTEGIDAS:
        if p.version == red.version and red.overlaps(p):
            raise ValueError('%s es de la LAN, loopback o reservada; no se bloquea' % texto)
    return str(red)


def bloqueo_leer():
    """{'ips': [{'red','nota','fecha'}], 'paises': [cc]} tolerante a ficheros viejos o rotos."""
    try:
        with open(BLOQUEO_CONF, encoding='utf-8') as f:
            d = json.load(f)
    except (OSError, ValueError):
        d = {}
    if not isinstance(d, dict):
        d = {}
    ips, vistas = [], set()
    for x in d.get('ips') or []:
        x = x if isinstance(x, dict) else {'red': x}
        try:
            red = bloqueo_red(str(x.get('red', '')))
        except ValueError:
            continue
        if red not in vistas:
            vistas.add(red)
            ips.append({'red': red, 'nota': str(x.get('nota', ''))[:80], 'fecha': str(x.get('fecha', ''))[:20]})
    paises = []
    for x in d.get('paises') or []:
        x = str(x).lower()
        if re.match(r'^[a-z]{2}$', x) and x not in paises:
            paises.append(x)
    return {'ips': ips[:BLOQUEO_MAX_IPS], 'paises': paises[:BLOQUEO_MAX_PAISES]}


def bloqueo_guardar(d):
    os.makedirs(os.path.dirname(BLOQUEO_CONF), mode=0o750, exist_ok=True)
    escribir_json_seguro(BLOQUEO_CONF, d, 0o600)


def bloqueo_lanzar(orden):
    r = subprocess.run(['systemctl', 'start', '--no-block', '%s@%s.service' % (BLOQUEO_UNIDAD, orden)],
                       capture_output=True, text=True, timeout=30)
    if r.returncode:
        raise OSError('no se pudo lanzar el bloqueo (%s); ¿está instalado bricohams-bloqueo?' % orden)


def bloqueo_paises(texto):
    paises = [x for x in re.split(r'[\s,;]+', (texto or '').lower()) if x]
    if not paises:
        raise ValueError('escribe al menos un código de país (ej.: cn, ru)')
    for x in paises:
        if not re.match(r'^[a-z]{2}$', x):
            raise ValueError('«%s» no es un código ISO de país de dos letras' % x[:10])
    return paises


def accion_bloqueo(a, campos):
    """Acciones del bloqueo por IP/país; None si la acción no es de este bloque."""
    if a == 'seg-bloquearip':
        d = bloqueo_leer()
        nuevas = [bloqueo_red(x) for x in re.split(r'[\s,;]+', campos.get('red', '')) if x]
        if not nuevas:
            raise ValueError('escribe una IP o red (ej.: 203.0.113.7 o 203.0.113.0/24)')
        nota = re.sub(r'[\x00-\x1f]', '', campos.get('nota', '')).strip()[:80]
        ya = {x['red'] for x in d['ips']}
        for red in nuevas:
            if red not in ya:
                ya.add(red)
                d['ips'].append({'red': red, 'nota': nota, 'fecha': time.strftime('%Y-%m-%d %H:%M')})
        if len(d['ips']) > BLOQUEO_MAX_IPS:
            raise ValueError('como mucho %d entradas en la lista de bloqueo' % BLOQUEO_MAX_IPS)
        bloqueo_guardar(d)
        bloqueo_lanzar('aplicar')
        return 'Bloqueada(s): %s. Se aplica en unos segundos.' % ', '.join(nuevas)
    if a == 'seg-desbloquearip':
        red = bloqueo_red(campos.get('red', ''))
        d = bloqueo_leer()
        d['ips'] = [x for x in d['ips'] if x['red'] != red]
        bloqueo_guardar(d)
        bloqueo_lanzar('aplicar')
        return 'Desbloqueada %s.' % red
    if a == 'seg-bloquearpais':
        d = bloqueo_leer()
        for cc in bloqueo_paises(campos.get('paises', '')):
            if cc not in d['paises']:
                d['paises'].append(cc)
        if len(d['paises']) > BLOQUEO_MAX_PAISES:
            raise ValueError('como mucho %d países' % BLOQUEO_MAX_PAISES)
        bloqueo_guardar(d)
        bloqueo_lanzar('geo-actualizar')
        return 'Descargando las redes de %s y aplicando el bloqueo; recarga en un minuto.' % ', '.join(
            x.upper() for x in d['paises'])
    if a == 'seg-desbloquearpais':
        cc = bloqueo_paises(campos.get('pais', ''))[0]
        d = bloqueo_leer()
        d['paises'] = [x for x in d['paises'] if x != cc]
        bloqueo_guardar(d)
        bloqueo_lanzar('aplicar')
        return 'Quitado el bloqueo de %s.' % cc.upper()
    if a == 'seg-desbanear':
        try:
            ip = str(ipaddress.ip_address(campos.get('ip', '').strip()))
        except ValueError:
            raise ValueError('IP no válida')
        os.makedirs(BLOQUEO_VAR, mode=0o755, exist_ok=True)
        ruta = os.path.join(BLOQUEO_VAR, 'desbanear.json')
        previas = []
        try:
            with open(ruta, encoding='utf-8') as f:
                previas = [x for x in json.load(f) if isinstance(x, str)][:100]
        except (OSError, ValueError, TypeError):
            pass
        escribir_json_seguro(ruta, sorted(set(previas + [ip])), 0o600)
        bloqueo_lanzar('desbanear')
        return 'Pedido a fail2ban que libere %s.' % ip
    if a == 'seg-refrescar':
        bloqueo_lanzar('estado')
        return 'Actualizando el estado; recarga la página en unos segundos.'
    if a == 'seg-recargarfw':
        fallos = []
        for verbo, u in (('restart', 'bricohams-cortafuegos'), ('restart', 'fail2ban'), ('reload', 'nginx')):
            if not estado_unidad(u)[0]:
                continue
            r = subprocess.run(['systemctl', verbo, u + '.service'], capture_output=True, text=True, timeout=120)
            if r.returncode:
                fallos.append(u)
        bloqueo_lanzar('aplicar')
        if fallos:
            raise OSError('no se pudo recargar: %s (mira su registro)' % ', '.join(fallos))
        return 'Cortafuegos, fail2ban y nginx recargados; bloqueo reaplicado.'
    return None


# ---------------------------------------------------------------- usuarios de OpenWebRX
def owrx_usuarios_ruta():
    if os.environ.get('BRICOHAMS_OWRX_USUARIOS'):
        return os.environ['BRICOHAMS_OWRX_USUARIOS']
    env = leer_env()
    if env.get('OWRX_BACKEND', 'native') == 'docker':
        return os.path.join(env.get('OWRX_DOCKER_DIR', '/opt/owrx-docker'), 'var', 'users.json')
    return '/var/lib/openwebrx/users.json'


def owrx_usuarios():
    """[(usuario, activo)] sin leer ni enseñar nunca los hashes."""
    try:
        with open(owrx_usuarios_ruta(), encoding='utf-8') as f:
            d = json.load(f)
    except (OSError, ValueError):
        return []
    salida = []
    for u in d if isinstance(d, list) else []:
        if isinstance(u, dict) and isinstance(u.get('user'), str):
            salida.append((u['user'], bool(u.get('enabled', True))))
    return salida


def owrx_admin(orden, usuario, clave=None):
    """openwebrx admin --noninteractive ORDEN USUARIO (nativo o Docker); la clave va por entorno, nunca en argv."""
    env = leer_env()
    entorno = {k: v for k, v in os.environ.items() if k != 'OWRX_PASSWORD'}
    if clave is not None:
        entorno['OWRX_PASSWORD'] = clave
    cli = ['openwebrx', 'admin', '--noninteractive', orden, usuario]
    docker = env.get('OWRX_BACKEND', 'native') == 'docker'
    if docker:
        contenedor = env.get('OWRX_DOCKER_CONTAINER', 'owrx-mbe')
        if not re.match(r'^[A-Za-z0-9_.-]{1,64}$', contenedor):
            raise ValueError('OWRX_DOCKER_CONTAINER no válido')
        cli = ['docker', 'exec'] + (['-e', 'OWRX_PASSWORD'] if clave is not None else []) + [contenedor] + cli
    try:
        r = subprocess.run(cli, capture_output=True, text=True, timeout=60, env=entorno)
    except (OSError, subprocess.TimeoutExpired):
        raise OSError('no se pudo ejecutar «openwebrx admin»')
    if not docker:
        ruta = owrx_usuarios_ruta()
        try:
            import shutil
            shutil.chown(ruta, 'openwebrx', 'openwebrx')
            os.chmod(ruta, 0o600)
        except (OSError, LookupError):
            pass
    if r.returncode:
        raise OSError('openwebrx admin %s falló: %s' % (orden, tapar((r.stderr or r.stdout).strip())[-200:]))


def accion_usuarios(a, campos):
    """Alta, baja, clave y activar/desactivar usuarios de OpenWebRX; None si no es de este bloque."""
    if not a.startswith('seg-usuario'):
        return None
    usuario = campos.get('usuario', '').strip()
    if not USUARIO_OWRX.match(usuario):
        raise ValueError('usuario no válido (letras, números, punto, guion o guion bajo; máx. 32)')
    lista = dict(owrx_usuarios())
    activos = [u for u, si in lista.items() if si]

    def clave():
        c = campos.get('clave', '')
        if c != campos.get('clave2', ''):
            raise ValueError('las dos claves no coinciden')
        if not CLAVE_TAK.match(c):
            raise ValueError('la clave debe tener entre 12 y 128 caracteres visibles, sin espacios')
        return c

    if a == 'seg-usuarionuevo':
        if usuario in lista:
            raise ValueError('el usuario %s ya existe' % usuario)
        owrx_admin('adduser', usuario, clave())
        return 'Usuario %s creado.' % usuario
    if usuario not in lista:
        raise ValueError('el usuario %s no existe' % usuario)
    if a == 'seg-usuarioclave':
        owrx_admin('resetpassword', usuario, clave())
        return 'Clave de %s cambiada.' % usuario
    if a == 'seg-usuarioactivar':
        owrx_admin('enableuser', usuario)
        return 'Usuario %s activado.' % usuario
    if a in ('seg-usuarioborrar', 'seg-usuariodesactivar'):
        if activos == [usuario]:
            raise ValueError('%s es el único usuario activo; crea otro antes para no quedarte sin acceso' % usuario)
        if a == 'seg-usuarioborrar':
            if campos.get('confirmar', '') != usuario:
                raise ValueError('para borrar escribe el nombre del usuario en «confirmar»')
            owrx_admin('removeuser', usuario)
            return 'Usuario %s borrado.' % usuario
        owrx_admin('disableuser', usuario)
        return 'Usuario %s desactivado.' % usuario
    raise ValueError('acción de usuario desconocida')


def accion_seguridad(campos):
    a = campos.get('accion', '')
    for bloque in (accion_bloqueo, accion_usuarios):
        msg = bloque(a, campos)
        if msg is not None:
            return msg
    if a == 'seg-guardar':
        actual = leer_json(BR_CONF)
        c = br_validar(campos, actual)
        huella_reset = c.pop('huella_reset', False)
        previo = leer_json(BR_SECRETO) if actual.get('protocolo') == c['protocolo'] else {}
        s = br_secretos(campos, c['protocolo'], previo)
        os.makedirs(os.path.dirname(BR_CONF), mode=0o750, exist_ok=True)
        escribir_json_seguro(BR_SECRETO, s, 0o600)
        escribir_json_seguro(BR_CONF, c, 0o600)
        if huella_reset:
            kh = os.path.join(os.path.dirname(BR_ESTADO), 'known_hosts')
            try:
                os.unlink(kh)
            except OSError:
                pass
        br_programar(c['programado'])
        extra = ' Pulsa «Obtener huella» y confírmala antes de copiar.' if c['protocolo'] == 'sftp' else ''
        return 'Configuración del backup remoto guardada.' + extra
    if a == 'seg-olvidar':
        for ruta in (BR_SECRETO, BR_CONF):
            try:
                os.unlink(ruta)
            except FileNotFoundError:
                pass
        br_programar(False)
        return 'Configuración y credenciales del backup remoto borradas.'
    orden = a[4:]
    if orden in BR_ORDENES:
        if not os.path.exists(BR_CONF):
            raise ValueError('primero guarda la configuración del backup remoto')
        r = subprocess.run(['systemctl', 'start', '--no-block', '%s@%s.service' % (BR_UNIDAD, orden)],
                           capture_output=True, text=True, timeout=30)
        if r.returncode:
            raise OSError('no se pudo lanzar %s; ¿está instalado el backup remoto?' % orden)
        return 'Lanzado «%s» en segundo plano; recarga la página para ver el resultado.' % orden
    raise ValueError('acción desconocida')


# ---------------------------------------------------------------- acciones del formulario
def accion(campos):
    """Devuelve el mensaje para la web; ValueError = dato no válido."""
    a = campos.get('accion', '')
    env = leer_env()
    m = re.match(r'^(guardar|aplicar)(433|868)$', a)
    if m:
        nodo = m.group(2)
        cfg = NODOS[nodo]
        largo, corto = validar_nombres(campos.get('largo', ''), campos.get('corto', ''))
        cambios = {cfg['largo']: largo, cfg['corto']: corto}
        if cfg['rol']:
            rol = campos.get('rol', 'CLIENT')
            if rol not in ROLES:
                raise ValueError('rol no válido')
            cambios[cfg['rol']] = rol
        url = campos.get('url', '').strip()
        if url:
            cambios[cfg['url']] = validar_url(url, cfg['region'])
        guardar(cambios)
        if m.group(1) == 'guardar':
            return 'Guardado en bricohams.env (nodo %s). Aplícalo al nodo cuando quieras.' % nodo
        if not TRABAJO.lanzar('Aplicar la configuración al nodo %s' % nodo, tarea_aplicar(nodo)):
            return 'Guardado, pero hay otro trabajo en marcha: aplícalo cuando termine.'
        return 'Guardado. Aplicando al nodo %s (tarda 1-2 minutos)…' % nodo
    if a == 'mapa':
        cambios = {k: ('yes' if campos.get(k) == 'yes' else 'no') for k in ('MESH433_OWRX', 'MESH868_OWRX', 'MESH_OWRX_CHAT')}
        guardar(cambios)
        if si(env.get('OWRX_MAPA_LORA'), 'yes'):
            TRABAJO.lanzar('Reiniciar el mapa de OpenWebRX+', tarea_reiniciar(SERVICIO_MAPA), soltar_mapa=False)
        return 'Mapa de OpenWebRX+ actualizado.'
    if a == 'leer':
        if not TRABAJO.lanzar('Leer los nodos', tarea_leer(['433', '868'])):
            return 'Hay otro trabajo en marcha.'
        return 'Leyendo los nodos…'
    if a in ('reiniciar868', 'reiniciarmapa'):
        s = 'meshtasticd' if a == 'reiniciar868' else SERVICIO_MAPA
        if not TRABAJO.lanzar('Reiniciar %s' % s, tarea_reiniciar(s), soltar_mapa=(a == 'reiniciar868')):
            return 'Hay otro trabajo en marcha.'
        return 'Reiniciando %s…' % s
    if a == 'reiniciarrak':
        if not TRABAJO.lanzar('Reiniciar %s' % SERVICIO_RAK, tarea_reiniciar(SERVICIO_RAK), soltar_mapa=False):
            return 'Hay otro trabajo en marcha.'
        return 'Reiniciando la pasarela APRS del RAK…'
    if a == 'tak-clave':
        return accion_clave_tak(campos)
    if re.match(r'^(tak|mon)-[a-z]+(-[a-z0-9-]+)?$', a):
        return accion_servicios(a)
    if a.startswith('seg-'):
        return accion_seguridad(campos)
    raise ValueError('acción desconocida')


# ---------------------------------------------------------------- web
def e(s):
    return html.escape('' if s is None else str(s), quote=True)


def token(sesion):
    return hmac.new(SECRETO, sesion.encode('utf-8'), hashlib.sha256).hexdigest()[:40]


def sesion_owrx(cabecera_cookie):
    try:
        c = http.cookies.SimpleCookie()
        c.load(cabecera_cookie or '')
        return c['owrx-session'].value if 'owrx-session' in c else ''
    except http.cookies.CookieError:
        return ''


_VALIDAS = {}
_VALIDAS_LOCK = threading.Lock()
VALIDA_SEG = 30


def autorizado_cache(sesion):
    """Como autorizado(), recordando 30 s las sesiones buenas (el cliente web de :8443 sondea mucho)."""
    ahora = time.monotonic()
    with _VALIDAS_LOCK:
        if _VALIDAS.get(sesion, 0) > ahora:
            return True
    if not autorizado(sesion):
        return False
    with _VALIDAS_LOCK:
        if len(_VALIDAS) > 200:
            for k in [k for k, v in _VALIDAS.items() if v <= ahora]:
                del _VALIDAS[k]
        _VALIDAS[sesion] = ahora + VALIDA_SEG
    return True


def autorizado(sesion):
    """La sesión vale si OpenWebRX+ deja ver /settings con ella (AuthorizationMixin: 200 o 403)."""
    if not sesion or not re.match(r'^[A-Za-z0-9_-]{8,128}$', sesion):
        return False
    host, _, puerto = OWRX.partition(':')
    try:
        c = http.client.HTTPConnection(host, int(puerto or 80), timeout=5)
        c.request('GET', '/settings', headers={'Cookie': 'owrx-session=' + sesion, 'X-Requested-With': 'XMLHttpRequest'})
        r = c.getresponse()
        r.read()
        c.close()
        return r.status == 200
    except (OSError, ValueError, http.client.HTTPException):
        return False


def hora(t):
    return time.strftime('%d/%m %H:%M:%S', time.localtime(t)) if t else ''


def html_lectura(n):
    d = TRABAJO.lecturas.get(n)
    if not d:
        return '<p class="text-muted">Sin leer todavía (botón «Leer los nodos»).</p>'
    if not d.get('ok'):
        return '<p class="text-danger">Última lectura %s: %s</p>' % (e(hora(d.get('hora'))), e(d.get('error')))
    filas = [('Nodo', '%s · %s (%s)' % (d.get('num'), d.get('largo'), d.get('corto'))), ('Hardware', d.get('hw')),
             ('Firmware', d.get('firmware')), ('Rol', d.get('rol')),
             ('Radio', '%s · %s · %s dBm · %s saltos' % (d.get('region'), d.get('preset'), d.get('potencia'), d.get('saltos'))),
             ('Posición', '%s, %s' % (d.get('lat'), d.get('lon')) if d.get('lat') is not None else 'sin posición'),
             ('Nodos oídos', d.get('nodos_oidos')),
             ('Canales', ' · '.join('%s %s (%s)' % (c['indice'], c['nombre'], c['clave']) for c in d.get('canales', [])))]
    return ('<p class="text-muted">Leído %s</p><table class="table table-sm">' % e(hora(d.get('hora')))
            + ''.join('<tr><th>%s</th><td>%s</td></tr>' % (e(k), e(v)) for k, v in filas) + '</table>')


def html_url(url, region):
    if not url:
        return 'sin URL propia'
    try:
        canales, radio = resumen_url(url)
    except Exception:
        return '<span class="text-danger">URL ilegible</span>'
    nombres = ', '.join('%s (%s)' % (c['nombre'] or 'principal', c['clave']) for c in canales)
    return e('%d canales: %s · radio %s %s' % (len(canales), nombres, radio.get('region', region), radio.get('modem', '')))


