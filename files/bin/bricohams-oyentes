#!/usr/bin/env python3
"""Lista localmente el registro voluntario de identificadores de oyentes."""
import argparse
import csv
import datetime
import os
from pathlib import Path
import sqlite3
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--csv', action='store_true', help='exportar todas las filas como CSV')
    parser.add_argument('--limite', type=int, default=1000, help='máximo de filas en la vista de tabla (1-100000)')
    args = parser.parse_args()
    if not 1 <= args.limite <= 100000:
        parser.error('--limite debe estar entre 1 y 100000')

    ruta = os.path.join(os.environ.get('STATE_DIRECTORY', '/var/lib/bricohams'), 'oyentes.sqlite')
    if not os.path.isfile(ruta):
        print('No hay registros de oyentes todavía.', file=sys.stderr)
        return 1
    try:
        db = sqlite3.connect(Path(ruta).resolve().as_uri() + '?mode=ro', uri=True)
        filas = db.execute(
            'SELECT identificador, tipo, creado FROM registro_oyentes ORDER BY creado DESC, id DESC'
            + ('' if args.csv else ' LIMIT ?'),
            () if args.csv else (args.limite,)).fetchall()
    except sqlite3.Error as e:
        print('No se pudo leer el registro de oyentes: %s' % e, file=sys.stderr)
        return 1
    finally:
        if 'db' in locals():
            db.close()

    salida = csv.writer(sys.stdout)
    salida.writerow(('identificador', 'tipo', 'fecha_hora_local'))
    for identificador, tipo, creado in filas:
        fecha = datetime.datetime.fromtimestamp(creado).astimezone().isoformat(timespec='seconds')
        salida.writerow((identificador, tipo, fecha))
    if not filas:
        print('Sin registros dentro del período de retención.', file=sys.stderr)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
