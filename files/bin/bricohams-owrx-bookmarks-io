#!/usr/bin/env python3
# =====================================================================
#  bricohams-owrx-bookmarks-io · botones «Importar desde fichero…»,
#  «Exportar todos» y «Exportar editables» en /settings/bookmarks
#
#  Solo en el editor de bookmarks de /settings (protegido con la
#  contraseña de administrador); la página principal no cambia.
#
#  Parches (idempotentes y reversibles):
#   1) htdocs/settings/bookmarks.html: botones + <input type=file> + JS,
#      entre <!-- bricohams-bmio --> y <!-- /bricohams-bmio -->.
#   2) owrx/controllers/settings/bookmarks.py: incrusta en la página un
#      <script type="application/json" id="bh-bm-todos"> con TODOS los
#      bookmarks (sistema + editables) para poder exportarlos; líneas
#      marcadas con  #@BH-BMIO@ .
#
#  Importar: lee un JSON con el formato de OpenWebRX+ (lista de objetos
#  {name, frequency, modulation, underlying, description, scannable[, ctcss]}
#  o {"bookmarks": [...]}) y crea uno a uno los válidos con la API del
#  propio editor (POST /settings/bookmarks). Omite duplicados y
#  frecuencias ya ocupadas por un bookmark editable (OpenWebRX+ guarda un
#  solo bookmark por frecuencia) y explica los inválidos.
#  Exportar: descarga bookmarks-todos-AAAAMMDD-HHMM.json (o -editables-),
#  en el mismo formato, reimportable.
#
#  Un «apt upgrade» de openwebrx reescribe los ficheros: el gancho
#  /etc/apt/apt.conf.d/99bricohams-owrx-bookmarks-io lo vuelve a aplicar.
#
#  Uso: bricohams-owrx-bookmarks-io [-q]      aplica los parches
#       bricohams-owrx-bookmarks-io --quitar  deja los ficheros originales
# =====================================================================
import os
import re
import sys

MARCA_INI = '<!-- bricohams-bmio -->'
MARCA_FIN = '<!-- /bricohams-bmio -->'
MARCA_PY = '#@BH-BMIO@'

# sin «$»: OpenWebRX+ pasa la plantilla por string.Template
JS = r'''<script>
jQuery(function(){
  var J = jQuery;
  var URL_BM = location.pathname;
  while (URL_BM.length > 1 && URL_BM.charAt(URL_BM.length - 1) === '/') URL_BM = URL_BM.slice(0, -1);
  var estado = J('#bh-bm-estado');
  function datos(){
    try { var d = JSON.parse(document.getElementById('bh-bm-todos').textContent);
          return {todos: d.todos || [], editable: d.editable || []}; }
    catch (e) { return {todos: [], editable: []}; }
  }
  function modos(){
    var m = J('.bookmarks table').first().data('modes');
    return (m && typeof m === 'object') ? m : null;
  }
  function p2(n){ return (n < 10 ? '0' : '') + n; }
  function sello(){ var d = new Date();
    return d.getFullYear() + p2(d.getMonth() + 1) + p2(d.getDate()) + '-' + p2(d.getHours()) + p2(d.getMinutes()); }
  function descargar(lista, nombre){
    var blob = new Blob([JSON.stringify(lista, null, 4) + '\n'], {type: 'application/json'});
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = nombre;
    document.body.appendChild(a); a.click();
    setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 1500);
  }
  function aviso(html, clase){ estado.attr('class', 'alert alert-' + (clase || 'info') + ' mt-3').html(html).show(); }
  function esc(t){ return String(t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  J('#bh-bm-exportar').on('click', function(){
    var d = datos();
    if (!d.todos.length) { aviso('No hay bookmarks que exportar.', 'warning'); return; }
    descargar(d.todos, 'bookmarks-todos-' + sello() + '.json');
    aviso('Exportados ' + d.todos.length + ' bookmarks (sistema + editables).', 'success');
  });
  J('#bh-bm-exportar-ed').on('click', function(){
    var d = datos(), l = d.todos.filter(function(b, i){ return d.editable[i]; });
    if (!l.length) { aviso('No hay bookmarks editables que exportar.', 'warning'); return; }
    descargar(l, 'bookmarks-editables-' + sello() + '.json');
    aviso('Exportados ' + l.length + ' bookmarks editables.', 'success');
  });

  function normalizar(x, m){
    if (!x || typeof x !== 'object' || Array.isArray(x)) return 'no es un bookmark';
    var nombre = (typeof x.name === 'string') ? x.name.trim() : '';
    if (!nombre) return 'sin nombre';
    var f = Number(x.frequency);
    if (!isFinite(f) || f <= 0) return 'frecuencia inválida';
    var mod = String(x.modulation || '').trim().toLowerCase();
    if (!mod) return 'sin modulación';
    if (m && !(mod in m)) return 'modulación «' + mod + '» no disponible en este receptor';
    var b = {name: nombre, frequency: Math.round(f), modulation: mod};
    var u = String(x.underlying || '').trim().toLowerCase();
    if (u) {
      if (m && (m[mod].underlying || []).indexOf(u) < 0) return 'modo subyacente «' + u + '» incorrecto para ' + mod;
      b.underlying = u;
    }
    if (typeof x.description === 'string' && x.description) b.description = x.description;
    if ('scannable' in x) b.scannable = !!x.scannable;
    if (x.ctcss !== undefined && x.ctcss !== null && x.ctcss !== '' && Number(x.ctcss)) b.ctcss = Number(x.ctcss);
    return b;
  }

  function analizar(lista){
    var d = datos(), m = modos(), ocupadas = {}, r = {nuevos: [], dup: [], conflicto: [], malos: []};
    d.todos.forEach(function(b, i){ if (d.editable[i]) ocupadas[b.frequency] = b; });
    lista.forEach(function(x, i){
      var b = normalizar(x, m);
      var etiqueta = '#' + (i + 1) + ' ' + ((x && x.name) ? x.name : '');
      if (typeof b === 'string') { r.malos.push(etiqueta + ': ' + b); return; }
      var o = ocupadas[b.frequency];
      if (o) {
        if (o.name === b.name && o.modulation === b.modulation) r.dup.push(b.name);
        else r.conflicto.push(etiqueta + ': ' + b.frequency + ' Hz ya la usa «' + o.name + '»');
        return;
      }
      ocupadas[b.frequency] = b;
      r.nuevos.push(b);
    });
    return r;
  }

  function lista_html(t, l){
    if (!l.length) return '';
    var max = 15, h = '<div class="mt-2"><b>' + esc(t) + ' (' + l.length + ')</b><ul class="mb-0">';
    l.slice(0, max).forEach(function(s){ h += '<li>' + esc(s) + '</li>'; });
    if (l.length > max) h += '<li>… y ' + (l.length - max) + ' más</li>';
    return h + '</ul></div>';
  }

  function crear(lista, i, ok, fallos, fin){
    if (i >= lista.length) return fin(ok, fallos);
    aviso('Importando… ' + (i + 1) + ' / ' + lista.length);
    J.ajax(URL_BM, {data: JSON.stringify([lista[i]]), contentType: 'application/json', method: 'POST'})
      .done(function(){ crear(lista, i + 1, ok + 1, fallos, fin); })
      .fail(function(){ fallos.push(lista[i].name + ' (' + lista[i].frequency + ' Hz): rechazado por el servidor');
                        crear(lista, i + 1, ok, fallos, fin); });
  }

  var fichero = J('#bh-bm-fichero');
  J('#bh-bm-importar').on('click', function(){ fichero.val(''); fichero.trigger('click'); });
  fichero.on('change', function(){
    var f = this.files && this.files[0];
    if (!f) return;
    if (f.size > 5 * 1024 * 1024) { aviso('El fichero supera 5 MB.', 'danger'); return; }
    var lector = new FileReader();
    lector.onerror = function(){ aviso('No se pudo leer el fichero.', 'danger'); };
    lector.onload = function(){
      var j;
      try { j = JSON.parse(String(lector.result).replace(/^\uFEFF/, '')); }
      catch (e) { aviso('El fichero no es JSON válido: ' + esc(e.message), 'danger'); return; }
      var lista = Array.isArray(j) ? j : (j && Array.isArray(j.bookmarks) ? j.bookmarks : null);
      if (!lista) { aviso('Formato no reconocido: se espera una lista de bookmarks de OpenWebRX+ o {"bookmarks": [...]}.', 'danger'); return; }
      var r = analizar(lista);
      var resumen = lista_html('Duplicados omitidos', r.dup) + lista_html('Frecuencia ya ocupada, omitidos', r.conflicto) +
                    lista_html('Inválidos', r.malos);
      if (!r.nuevos.length) { aviso('<b>' + esc(f.name) + '</b>: nada nuevo que importar.' + resumen, 'warning'); return; }
      if (!confirm('Se importarán ' + r.nuevos.length + ' bookmarks de «' + f.name + '»' +
                   (r.dup.length + r.conflicto.length + r.malos.length ?
                    ' (se omiten ' + (r.dup.length + r.conflicto.length + r.malos.length) + ')' : '') + '. ¿Continuar?')) return;
      J('#bh-bm-importar, #bh-bm-exportar, #bh-bm-exportar-ed').prop('disabled', true);
      crear(r.nuevos, 0, 0, [], function(ok, fallos){
        var msg = '<b>' + esc(f.name) + '</b>: importados ' + ok + ' de ' + r.nuevos.length + '.' +
                  lista_html('Fallidos', fallos) + resumen;
        try { sessionStorage.setItem('bh-bm-msg', JSON.stringify({html: msg, clase: fallos.length ? 'warning' : 'success'})); } catch (e) {}
        if (ok) { location.reload(); }
        else { aviso(msg, 'danger'); J('#bh-bm-importar, #bh-bm-exportar, #bh-bm-exportar-ed').prop('disabled', false); }
      });
    };
    lector.readAsText(f, 'utf-8');
  });

  try {
    var g = sessionStorage.getItem('bh-bm-msg');
    if (g) { sessionStorage.removeItem('bh-bm-msg'); g = JSON.parse(g); aviso(g.html, g.clase); }
  } catch (e) {}
});
</script>'''


def bloque():
    return (MARCA_INI + '''
            <button type="button" class="btn btn-success" id="bh-bm-importar" title="Importa bookmarks desde un fichero JSON (formato OpenWebRX+)">Importar desde fichero…</button>
            <button type="button" class="btn btn-secondary" id="bh-bm-exportar" title="Descarga todos los bookmarks (sistema + editables)">Exportar todos</button>
            <button type="button" class="btn btn-outline-secondary" id="bh-bm-exportar-ed" title="Descarga solo los bookmarks editables">Exportar editables</button>
            <input type="file" id="bh-bm-fichero" accept=".json,application/json" style="display:none">
            <div id="bh-bm-estado" style="display:none"></div>
            ''' + JS + '''
            ''' + MARCA_FIN + '\n')


ANCLA_HTML = re.compile(r'([ \t]*<button type="button" class="btn btn-primary bookmark-add">[^\n]*\n)')

LINEAS_PY = [
    'try:',
    '    _bh = sorted(Bookmarks.getSharedInstance().getBookmarks(), key=lambda b: b.getFrequency())',
    '    variables["bookmarks"] += \'<script type="application/json" id="bh-bm-todos">\' + json.dumps('
    '{"todos": [b.__dict__() for b in _bh], "editable": [b.getSrcFile() is None for b in _bh]})'
    '.replace("<", "\\\\u003c").replace(">", "\\\\u003e").replace("&", "\\\\u0026") + \'</script>\'',
    'except Exception:',
    '    logger.exception("bricohams bookmarks-io: no se pudo incrustar la lista de bookmarks")',
]
ANCLA_PY = re.compile(r'^([ \t]*)variables\["bookmarks"\] = self\.render_table\(\)[^\n]*\n', re.M)


def paquete(nombre, rel):
    try:
        m = __import__(nombre)
        # owrx/htdocs pueden ser paquetes "namespace" sin __file__
        base = os.path.dirname(m.__file__) if getattr(m, '__file__', None) else list(m.__path__)[0]
        return os.path.join(base, rel)
    except (ImportError, AttributeError, IndexError):
        return os.path.join('/usr/lib/python3/dist-packages', nombre, rel)


def ruta_html():
    return os.environ.get('OWRX_BOOKMARKS_HTML') or paquete('htdocs', os.path.join('settings', 'bookmarks.html'))


def ruta_py():
    return os.environ.get('OWRX_BOOKMARKS_PY') or paquete('owrx', os.path.join('controllers', 'settings', 'bookmarks.py'))


def quitar_html(t):
    return re.sub(r'[ \t]*' + re.escape(MARCA_INI) + r'.*?' + re.escape(MARCA_FIN) + r'\n?', '', t, flags=re.S)


def poner_html(t):
    limpio = quitar_html(t)
    m = ANCLA_HTML.search(limpio)
    if m:
        return limpio[:m.end()] + '            ' + bloque() + limpio[m.end():]
    i = limpio.rfind('</body>')
    if i < 0:
        raise ValueError('plantilla settings/bookmarks.html irreconocible')
    return limpio[:i] + '<div class="container"><div class="buttons">' + bloque() + '</div></div>\n' + limpio[i:]


def quitar_py(t):
    return ''.join(l for l in t.splitlines(True) if MARCA_PY not in l)


def poner_py(t):
    limpio = quitar_py(t)
    m = ANCLA_PY.search(limpio)
    if not m:
        raise ValueError('controlador settings/bookmarks.py irreconocible')
    sangria = m.group(1)
    nuevo = ''.join('%s%s  %s\n' % (sangria, l, MARCA_PY) for l in LINEAS_PY)
    return limpio[:m.end()] + nuevo + limpio[m.end():]


def escribir(ruta, original, nuevo):
    if nuevo == original:
        return False
    tmp = ruta + '.bricohams-tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(nuevo)
    os.chmod(tmp, os.stat(ruta).st_mode & 0o777)
    os.replace(tmp, ruta)
    return True


def main(a):
    callado = '-q' in a
    sacar = '--quitar' in a
    rc = 0
    for ruta, fq, fp in ((ruta_html(), quitar_html, poner_html), (ruta_py(), quitar_py, poner_py)):
        try:
            original = open(ruta, encoding='utf-8').read()
            nuevo = fq(original) if sacar else fp(original)
            if ruta.endswith('.py'):
                compile(nuevo, ruta, 'exec')
            cambiado = escribir(ruta, original, nuevo)
        except (OSError, ValueError, SyntaxError) as x:
            if not callado:
                print('%s: %s' % (ruta, x), file=sys.stderr)
            rc = 0 if callado else 1
            continue
        if not callado:
            print('%s: %s%s' % (ruta, 'parche quitado' if sacar else 'parche aplicado',
                                '' if cambiado else ' (sin cambios)'))
    return rc


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
