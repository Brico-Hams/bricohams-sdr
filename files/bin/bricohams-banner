#!/bin/bash
# =====================================================================
#  bricohams-banner · BricoHams (v4.5)
#  Banner de las conexiones SSH en dos partes:
#   1. ANTES de entrar (/etc/issue.net, «Banner» de sshd): logo y aviso legal.
#      No dice nada que ayude a un atacante: ni sistema, ni versiones, ni IP.
#   2. DESPUÉS de entrar (/etc/update-motd.d/20-bricohams): estado de la
#      estación (sistema, caja, servicios, receptores, LoRa, seguridad, ayuda).
#  Uso: sudo bricohams-banner instalar | ver | quitar
#  Pruebas: BH_RAIZ=/carpeta trabaja sobre un sistema de mentira.
# =====================================================================
set -euo pipefail
RAIZ=${BH_RAIZ:-}
ENV=$RAIZ/etc/bricohams/bricohams.env
SRC=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
MOTD_SRC=${BH_MOTD_SRC:-}
for c in "$SRC/../motd/20-bricohams" /usr/local/share/bricohams/20-bricohams; do
    [ -n "$MOTD_SRC" ] || { [ -r "$c" ] && MOTD_SRC=$c; }
done
DROPIN=$RAIZ/etc/ssh/sshd_config.d/80-bricohams-banner.conf

indicativo() {
    local c=""
    [ -r "$ENV" ] && c=$(sed -n 's/^[[:space:]]*CALLSIGN=["'\'']\{0,1\}\([A-Za-z0-9/-]*\).*/\1/p' "$ENV" | head -1)
    [ -n "$c" ] && [ "$c" != N0CALL ] || c="BricoHams"
    printf '%s' "${c^^}"
}

aviso_previo() {   # sin colores: lo enseñan todos los clientes SSH tal cual
    local call; call=$(indicativo)
    cat <<EOF

  ____       _           _   _
 | __ ) _ __(_) ___ ___ | | | | __ _ _ __ ___  ___      .  ((( ))) .
 |  _ \\| '__| |/ __/ _ \\| |_| |/ _\` | '_ \` _ \\/ __|        \\  |  /
 | |_) | |  | | (_| (_) |  _  | (_| | | | | | \\__ \\         \\ | /
 |____/|_|  |_|\\___\\___/|_| |_|\\__,_|_| |_| |_|___/          \\|/
                                                              |
 ===================== SDR · RADIOAFICIONADOS · ${call} =====================

  SISTEMA PRIVADO · ACCESO SOLO PARA PERSONAS AUTORIZADAS

  Este equipo es de la estación de radioaficionado ${call} (BricoHams).
  Se registran todas las conexiones (IP, fecha y usuario) y las órdenes
  con privilegios. Los accesos no autorizados se bloquean automáticamente
  y podrán ponerse en conocimiento de las autoridades (art. 197 bis del
  Código Penal). Si no tienes permiso, desconecta ahora.

  Datos personales (RGPD): responsable ${call}; finalidad: seguridad de
  este sistema; los registros se guardan solo el tiempo necesario.

  PRIVATE SYSTEM · AUTHORISED USERS ONLY · ALL CONNECTIONS ARE LOGGED
 =============================================================================

EOF
}

instalar() {
    [ -n "$RAIZ" ] || [ "$(id -u)" -eq 0 ] || { echo "Ejecútalo con sudo."; exit 1; }
    [ -n "$MOTD_SRC" ] || { echo "✘ No encuentro 20-bricohams (files/motd)"; exit 1; }
    install -d "$RAIZ/etc/update-motd.d" "$RAIZ/etc/ssh/sshd_config.d" "$RAIZ/usr/local/share/bricohams"
    if [ -f "$RAIZ/etc/issue.net" ] && [ ! -f "$RAIZ/etc/issue.net.bricohams-orig" ]; then
        cp -a "$RAIZ/etc/issue.net" "$RAIZ/etc/issue.net.bricohams-orig"
    fi
    aviso_previo >"$RAIZ/etc/issue.net"
    chmod 644 "$RAIZ/etc/issue.net"
    # el texto legal de Debian en /etc/motd sobra: el estado lo pone 20-bricohams
    if [ -s "$RAIZ/etc/motd" ] && [ ! -f "$RAIZ/etc/motd.bricohams-orig" ]; then
        cp -a "$RAIZ/etc/motd" "$RAIZ/etc/motd.bricohams-orig"
        : >"$RAIZ/etc/motd"
    fi
    install -m 755 "$MOTD_SRC" "$RAIZ/etc/update-motd.d/20-bricohams"
    install -m 644 "$MOTD_SRC" "$RAIZ/usr/local/share/bricohams/20-bricohams"
    printf '# BricoHams v4.5 (bricohams-banner): aviso legal antes de entrar\nBanner /etc/issue.net\nPrintLastLog yes\n' >"$DROPIN"
    chmod 644 "$DROPIN"
    if [ -z "$RAIZ" ]; then
        if command -v sshd >/dev/null && ! sshd -t 2>/dev/null; then
            rm -f "$DROPIN"
            echo "✘ sshd no acepta el Banner: lo quito (mira sudo sshd -t)"; exit 1
        fi
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    fi
    echo "✔ Banner SSH: aviso legal (/etc/issue.net) y estado al entrar (/etc/update-motd.d/20-bricohams)"
}

ver() {
    echo "----- antes de entrar (/etc/issue.net) -----"
    if [ -r "$RAIZ/etc/issue.net" ] && grep -q BricoHams "$RAIZ/etc/issue.net"; then cat "$RAIZ/etc/issue.net"; else aviso_previo; fi
    echo "----- al entrar (20-bricohams) -----"
    if [ -x "$RAIZ/etc/update-motd.d/20-bricohams" ]; then "$RAIZ/etc/update-motd.d/20-bricohams"
    elif [ -n "$MOTD_SRC" ]; then bash "$MOTD_SRC"; fi
}

quitar() {
    [ -n "$RAIZ" ] || [ "$(id -u)" -eq 0 ] || { echo "Ejecútalo con sudo."; exit 1; }
    rm -f "$DROPIN" "$RAIZ/etc/update-motd.d/20-bricohams"
    [ -f "$RAIZ/etc/issue.net.bricohams-orig" ] && mv -f "$RAIZ/etc/issue.net.bricohams-orig" "$RAIZ/etc/issue.net"
    [ -f "$RAIZ/etc/motd.bricohams-orig" ] && mv -f "$RAIZ/etc/motd.bricohams-orig" "$RAIZ/etc/motd"
    [ -n "$RAIZ" ] || systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    echo "✔ Banner quitado (vuelven los textos de Debian)"
}

case "${1:-}" in
    instalar) instalar ;;
    ver)      ver ;;
    quitar)   quitar ;;
    *) sed -n '3,11p' "$0" | sed 's/^#  \{0,1\}//'; exit 1 ;;
esac
