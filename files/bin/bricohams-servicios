#!/bin/bash
# =====================================================================
#  bricohams-servicios · BricoHams (v4.2: según SSL_MODO)
#  Lista los servicios web y de radio de la estación, si están en marcha y
#  cómo entrar a cada uno (red local y, con SSL, desde Internet).
#  Uso: bricohams-servicios        (no hace falta sudo)
# =====================================================================
[ -r /etc/bricohams/web.env ] && . /etc/bricohams/web.env
IP=$(hostname -I 2>/dev/null | awk '{print $1}')
DOM=${SSL_DOMAIN:-}
MODO=${SSL_MODO:-todo}
PUB=http; [ "$MODO" = todo ] && PUB=https          # receptor público
ADM=https; [ "$MODO" = no ] && ADM=http            # administración (/login, /settings)
v='\e[32m'; r='\e[31m'; g='\e[90m'; n='\e[0m'
est() {
    if [ "$1" = openwebrx ] && [ "${OWRX_BACKEND:-native}" = docker ]; then    # v4.3 · contenedor: se mira la web
        curl -fsS -o /dev/null --max-time 3 http://127.0.0.1:8073/status.json && printf "${v}● Docker${n}" || printf "${r}○ Docker${n}"
        return
    fi
    systemctl is-active --quiet "$1" 2>/dev/null && printf "${v}● activo${n}" || printf "${r}○ parado${n}"
}
fila() { printf '%-22s %-24b %-38s %s\n' "$1" "$(est "$2")" "$3" "$4"; }
echo "BricoHams SDR · servicios · $(hostname) · LAN ${IP:-?} · dominio ${DOM:-(ninguno)} · SSL_MODO=$MODO"
printf '%-22s %-15s %-38s %s\n' "Servicio" "Estado" "Red local" "Internet"
fila "Receptor OpenWebRX+" openwebrx "$PUB://$IP/" "${DOM:+$PUB://$DOM/}"     # v5.0 · el 8073 solo en 127.0.0.1
fila "Administración" openwebrx "$ADM://$IP/settings" "${DOM:+$ADM://$DOM/settings}"
fila "Portal de servicios" nginx "$PUB://$IP/bricohams/" "${DOM:+$PUB://$DOM/bricohams/}"
fila "Mapa aviones tar1090" tar1090 "$PUB://$IP/tar1090/" "${DOM:+$PUB://$DOM/tar1090/}"
[ -f /etc/systemd/system/bricohams-ais.service ] && fila "AIS local (barcos)" bricohams-ais "$PUB://$IP/map (capa AIS)" "${DOM:+$PUB://$DOM/map}"
fila "ADS-B readsb" readsb "Beast 127.0.0.1:30005" "-"
fila "AirNav rbfeeder" rbfeeder "sudo rbfeeder --showkey" "airnavradar.com"
fila "Cámara MediaMTX" mediamtx "rtsp://$IP:8554/mastil · http://$IP:8888/mastil/" "${DOM:+$PUB://$DOM/camara/mastil/}"
fila "Meshtastic 868" meshtasticd "API $IP:4403" "solo LAN"
fila "Panel Meshtastic" bricohams-mesh-admin "$ADM://$IP/settings/bricohams/meshtastic" "${DOM:+$ADM://$DOM/settings/bricohams/meshtastic} (admin)"
if [ "${MESH433_WEB:-no}" = yes ]; then
    fila "Meshtastic 433 web" bricohams-mesh-puente "https://$IP:8444 (admin)" "solo LAN/VPN"
fi
if [ -e /etc/systemd/system/bricohams-tak.service ]; then    # v5.0
    fila "Servidor TAK" bricohams-tak "https://$IP:8445 · CoT TLS 8089" "solo LAN · gestión /settings/bricohams/tak"
fi
if [ -d /usr/share/grafana ]; then
    fila "Prometheus" prometheus "127.0.0.1:9090" "-"
    fila "Grafana" grafana-server "$ADM://$IP/settings/bricohams/monitorizacion" "${DOM:+$ADM://$DOM/settings/bricohams/monitorizacion} (admin)"
fi
fila "iGate LoRa APRS" bricohams-rak-aprs "RAK4631 USB · 433,775 MHz" "APRS-IS (aprs.fi)"
fila "Mesh -> mapa OWRX+" bricohams-mesh-owrx "LilyGO 433 · HAT 868 -> MQTT" "mapa de OpenWebRX+"
fila "API plugins" bricohams-api "127.0.0.1:8075" "${DOM:+$PUB://$DOM/bricohams/api/salud}"
fila "Visitas + Telegram" bricohams-visitas "MQTT 127.0.0.1:1883 (openwebrx/#)" "-"
fila "MQTT mosquitto" mosquitto "127.0.0.1:1883" "-"
fila "Estación WX" bricohams-wx "sensor.json en la web" "aprs.fi"
fila "Pico IO (sensores)" bricohams-io "/dev/bricohams-io" "-"
fila "Ventiladores" bricohams-fan "sudo bricohams-fan --estado" "-"
fila "Pases satélites" bricohams-satpass.timer "cada 15 min" "-"
fila "Grabación de pases" bricohams-satrec "MP3 en Files · pases.ics" "${DOM:+$PUB://$DOM/bricohams/clima.html}"
fila "Clima en red (APRS)" bricohams-wx-red "APRS-IS solo lectura" "${DOM:+$PUB://$DOM/bricohams/clima.html}"
fila "Resumen WSPR" bricohams-wspr.timer "cada 15 min (wspr.live)" "wspr.rocks"
echo -e "${g}* v5.0: OpenWebRX+ (8073), tar1090 y AIS-catcher solo escuchan en 127.0.0.1: se entra por nginx (443).${n}"
if [ "$MODO" = no ]; then puertos="80"; else puertos="80 y 443"; fi
echo -e "${g}Router: abrir SOLO $puertos TCP hacia $IP (no 8073, 4403 ni 9443). Tareas automáticas: cat /etc/cron.d/bricohams${n}"
