#!/usr/bin/env python3
# =====================================================================
#  bricohams-owrx-rbimport · «Importar repetidores (RepeaterBook)…» en
#  /settings/bookmarks
#
#  Solo en el editor de bookmarks de /settings (protegido con la
#  contraseña de administrador); la página principal no cambia.
#
#  Parches (idempotentes y reversibles):
#   1) owrx/controllers/settings/bricohams_rbimport.py: módulo copiado
#      desde /usr/local/share/bricohams-rbimport/ (variable BH_RBI_SRC).
#      Controlador GET /settings/bookmarks/repeaterbook -> JSON con los
#      repetidores FM propuestos (frecuencia, subtono, descripción).
#   2) owrx/http.py: import + ruta, líneas marcadas con  #@BH-RBI@ .
#   3) htdocs/settings/bookmarks.html: botón + panel de búsqueda +
#      tabla de vista previa + JS, entre <!-- bricohams-rbi --> y
#      <!-- /bricohams-rbi -->.
#
#  Los repetidores elegidos se crean uno a uno con la API del propio
#  editor (POST /settings/bookmarks) en modulación FM («nfm» interno)
#  con su subtono CTCSS (requiere bricohams-owrx-ctcss).
#  La API key se configura en Settings → General settings
#  (bricohams-owrx-repeaterbook).
#
#  Un «apt upgrade» de openwebrx reescribe los ficheros: el gancho
#  /etc/apt/apt.conf.d/99bricohams-owrx-rbimport lo vuelve a aplicar.
#
#  Uso: bricohams-owrx-rbimport [-q]      aplica los parches
#       bricohams-owrx-rbimport --quitar  deja los ficheros originales
# =====================================================================
import os
import re
import shutil
import sys

MARCA_INI = '<!-- bricohams-rbi -->'
MARCA_FIN = '<!-- /bricohams-rbi -->'
MARCA_PY = '#@BH-RBI@'
MODULO = 'bricohams_rbimport.py'
SRC_DEF = '/usr/local/share/bricohams-rbimport/' + MODULO

IMPORT_PY = 'from owrx.controllers.settings.bricohams_rbimport import RepeaterBookImportController'
RUTAS_PY = (
    'StaticRoute("/settings/bookmarks/repeaterbook", RepeaterBookImportController),',
    'StaticRoute("/settings/bookmarks/repeaterbook/tonos", RepeaterBookImportController, method="POST", options={"action": "tonos"}),',
)
ANCLA_IMPORT = re.compile(r'^from owrx\.controllers\.settings\.bookmarks import BookmarksController[^\n]*\n', re.M)
ANCLA_RUTA = re.compile(r'^([ \t]*)StaticRoute\("/settings/bookmarks", BookmarksController\),[^\n]*\n', re.M)
ANCLA_HTML = re.compile(r'([ \t]*<button type="button" class="btn btn-primary bookmark-add">[^\n]*\n)')

# sin «$»: OpenWebRX+ pasa la plantilla por string.Template
JS = r'''<script>
jQuery(function(){
  var J = jQuery;
  var URL_BM = location.pathname;
  while (URL_BM.length > 1 && URL_BM.charAt(URL_BM.length - 1) === '/') URL_BM = URL_BM.slice(0, -1);
  var URL_RB = URL_BM + '/repeaterbook';
  var panel = J('#bh-rbi-panel'), estado = J('#bh-rbi-estado'), tabla = J('#bh-rbi-tabla');
  var lista = [];
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function aviso(html, clase){
    if (!html) { estado.hide().empty(); return; }
    estado.attr('class', 'alert alert-' + (clase || 'info') + ' mt-2').html(html).show();
  }
  function mhz(hz){ return (hz / 1e6).toFixed(4); }
  function guardar(){
    try { localStorage.setItem('bh-rbi-filtro', JSON.stringify({
      pais: J('#bh-rbi-pais').val(), distrito: J('#bh-rbi-distrito').val(), texto: J('#bh-rbi-texto').val(),
      activos: J('#bh-rbi-activos').prop('checked'),
      bandas: J('.bh-rbi-banda:checked').map(function(){ return this.value; }).get() })); } catch (e) {}
  }
  try {
    var f = JSON.parse(localStorage.getItem('bh-rbi-filtro') || 'null');
    if (f) {
      if (f.pais) J('#bh-rbi-pais').val(f.pais);
      if (f.distrito != null) J('#bh-rbi-distrito').val(f.distrito);
      J('#bh-rbi-texto').val(f.texto || '');
      J('#bh-rbi-activos').prop('checked', f.activos !== false);
      if (f.bandas) J('.bh-rbi-banda').each(function(){ this.checked = f.bandas.indexOf(this.value) >= 0; });
    }
  } catch (e) {}

  J('#bh-rbi-abrir').on('click', function(){ panel.toggle(); });

  function pintar(){
    var h = '<table class="table table-sm table-striped"><thead><tr>' +
            '<th><input type="checkbox" id="bh-rbi-todos" title="Marcar/desmarcar todos"></th>' +
            '<th>Nombre</th><th>Frecuencia</th><th>Modulación</th><th>Entrada</th><th>Región</th><th>Estado</th><th>Notas</th></tr></thead><tbody>';
    lista.forEach(function(r, i){
      var modo = r.ctcss ? 'FM (subtono ' + Number(r.ctcss).toFixed(1) + ' Hz)' : 'FM (sin subtono)';
      h += '<tr' + (r.existe ? ' class="text-muted"' : '') + '>' +
           '<td><input type="checkbox" class="bh-rbi-sel" data-i="' + i + '"' + (r.existe ? '' : ' checked') + '></td>' +
           '<td>' + esc(r.name) + (r.existe ? '<br><small>ya existe: ' + esc(r.existe) + '</small>' : '') + '</td>' +
           '<td>' + mhz(r.frequency) + ' MHz</td><td>' + esc(modo) + '</td>' +
           '<td>' + (r.entrada ? Number(r.entrada).toFixed(4) + ' MHz' : '') + '</td>' +
           '<td>' + esc(r.region) + '</td><td>' + esc(r.estado) + '</td>' +
           '<td><small>' + esc(r.description) + '</small></td></tr>';
    });
    tabla.html(h + '</tbody></table>');
    J('#bh-rbi-todos').on('change', function(){ J('.bh-rbi-sel').prop('checked', this.checked); contar(); });
    J('.bh-rbi-sel').on('change', contar);
    contar();
  }
  function contar(){
    var n = J('.bh-rbi-sel:checked').length;
    J('#bh-rbi-importar').prop('disabled', !n).text('Importar seleccionados (' + n + ')');
  }

  function buscar(refrescar){
    guardar();
    var bandas = J('.bh-rbi-banda:checked').map(function(){ return this.value; }).get();
    if (!bandas.length) { aviso('Elige al menos una banda.', 'warning'); return; }
    aviso('Consultando RepeaterBook…');
    tabla.empty(); lista = []; contar();
    J('#bh-rbi-buscar, #bh-rbi-refrescar').prop('disabled', true);
    J.ajax(URL_RB, {dataType: 'json', headers: {'X-Requested-With': 'XMLHttpRequest'}, data: {
        pais: J('#bh-rbi-pais').val(), distrito: J('#bh-rbi-distrito').val(), bandas: bandas.join(','),
        texto: J('#bh-rbi-texto').val(), solo_activos: J('#bh-rbi-activos').prop('checked') ? 1 : 0,
        refrescar: refrescar ? 1 : 0}})
      .done(function(d){
        if (!d || !d.ok) { aviso(esc((d && d.error) || 'Respuesta inesperada.'), 'danger'); return; }
        lista = d.repetidores || [];
        var nex = lista.filter(function(r){ return r.existe; }).length;
        var nct = lista.filter(function(r){ return r.ctcss; }).length;
        aviso('<b>' + lista.length + '</b> repetidores FM encontrados (de ' + d.total_pais + ' en ' + esc(d.pais) + '), ' +
              nct + ' con subtono' + (nex ? '; ' + nex + ' ya tienen bookmark en su frecuencia y quedan desmarcados' : '') + '.',
              lista.length ? 'info' : 'warning');
        if (lista.length) pintar();
      })
      .fail(function(x){
        var e = x.responseJSON && x.responseJSON.error;
        if (x.status === 403) e = 'Sesión caducada: vuelve a iniciar sesión en /settings.';
        aviso(esc(e || ('Error ' + x.status)), 'danger');
      })
      .always(function(){ J('#bh-rbi-buscar, #bh-rbi-refrescar').prop('disabled', false); });
  }
  J('#bh-rbi-buscar').on('click', function(){ buscar(false); });
  J('#bh-rbi-refrescar').on('click', function(){ buscar(true); });
  J('#bh-rbi-texto').on('keydown', function(e){ if (e.keyCode === 13) { e.preventDefault(); buscar(false); } });

  function crear(sel, i, ok, fallos, fin){
    if (i >= sel.length) return fin(ok, fallos);
    aviso('Importando… ' + (i + 1) + ' / ' + sel.length);
    var r = sel[i], b = {name: r.name, frequency: r.frequency, modulation: 'nfm',
                         description: r.description, scannable: true};
    if (r.ctcss) b.ctcss = r.ctcss;
    J.ajax(URL_BM, {data: JSON.stringify([b]), contentType: 'application/json', method: 'POST'})
      .done(function(){ crear(sel, i + 1, ok + 1, fallos, fin); })
      .fail(function(){ fallos.push(r.name + ' (' + mhz(r.frequency) + ' MHz)'); crear(sel, i + 1, ok, fallos, fin); });
  }
  J('#bh-rbi-importar').on('click', function(){
    var sel = J('.bh-rbi-sel:checked').map(function(){ return lista[J(this).data('i')]; }).get();
    if (!sel.length) return;
    var rep = sel.filter(function(r){ return r.existe; }).length;
    if (!confirm('Se crearán ' + sel.length + ' bookmarks FM' +
                 (rep ? ' (' + rep + ' en frecuencias que ya tienen bookmark: el servidor podría rechazarlos)' : '') +
                 '. ¿Continuar?')) return;
    J('#bh-rbi-importar, #bh-rbi-buscar, #bh-rbi-refrescar').prop('disabled', true);
    crear(sel, 0, 0, [], function(ok, fallos){
      var msg = '<b>RepeaterBook</b>: importados ' + ok + ' de ' + sel.length + ' repetidores (modulación FM con subtono).';
      if (fallos.length) msg += '<div>Fallidos:</div><ul>' + fallos.slice(0, 20).map(function(s){ return '<li>' + esc(s) + '</li>'; }).join('') + '</ul>';
      try { sessionStorage.setItem('bh-bm-msg', JSON.stringify({html: msg, clase: fallos.length ? 'warning' : 'success'})); } catch (e) {}
      if (ok) { location.reload(); }
      else { aviso(msg, 'danger'); J('#bh-rbi-buscar, #bh-rbi-refrescar').prop('disabled', false); contar(); }
    });
  });

  J('#bh-rbi-tonos').on('click', function(){
    guardar();
    var sob = confirm('¿Sobrescribir también los subtonos que ya tengan asignados?\n\nAceptar = sí, sobrescribir\nCancelar = solo los que no tienen subtono');
    var btn = J(this).prop('disabled', true);
    aviso('Buscando subtonos en RepeaterBook…');
    J.ajax(URL_RB + '/tonos', {method: 'POST', dataType: 'json', contentType: 'application/json',
        headers: {'X-Requested-With': 'XMLHttpRequest'},
        data: JSON.stringify({pais: J('#bh-rbi-pais').val(), distrito: J('#bh-rbi-distrito').val(), sobrescribir: sob})})
      .done(function(d){
        if (!d || !d.ok) { aviso(esc((d && d.error) || 'Respuesta inesperada.'), 'danger'); return; }
        var msg = '<b>RepeaterBook</b>: subtono FM asignado a ' + d.total + ' bookmarks.';
        if (d.total) msg += '<ul>' + d.cambios.slice(0, 60).map(function(c){
          return '<li>' + esc(c.name) + ' (' + mhz(c.frequency) + ' MHz) → ' + Number(c.ctcss).toFixed(1) + ' Hz' +
                 (c.origen ? ' <small>[' + esc(c.origen) + ']</small>' : '') + '</li>'; }).join('') + '</ul>';
        try { sessionStorage.setItem('bh-bm-msg', JSON.stringify({html: msg, clase: d.total ? 'success' : 'info'})); } catch (e) {}
        if (d.total) location.reload(); else aviso(msg, 'info');
      })
      .fail(function(x){
        var e = x.responseJSON && x.responseJSON.error;
        if (x.status === 403) e = 'Sesión caducada: vuelve a iniciar sesión en /settings.';
        aviso(esc(e || ('Error ' + x.status)), 'danger');
      })
      .always(function(){ btn.prop('disabled', false); });
  });
});
</script>'''

DISTRITOS = [('', 'Todos'), ('1', 'EA1 · Galicia, Asturias, Cantabria, Castilla y León'),
             ('2', 'EA2 · Aragón, Navarra, País Vasco, La Rioja'), ('3', 'EA3 · Cataluña'),
             ('4', 'EA4 · Madrid, Extremadura, Castilla-La Mancha'), ('5', 'EA5 · C. Valenciana, Murcia'),
             ('6', 'EA6 · Baleares'), ('7', 'EA7 · Andalucía'), ('8', 'EA8 · Canarias'), ('9', 'EA9 · Ceuta, Melilla')]
BANDAS = [('10m', False), ('6m', False), ('4m', False), ('2m', True), ('70cm', True), ('23cm', False)]


def bloque():
    opciones = ''.join('<option value="%s"%s>%s</option>' % (v, ' selected' if v == '5' else '', t) for v, t in DISTRITOS)
    bandas = ''.join('<label class="mr-2 me-2"><input type="checkbox" class="bh-rbi-banda" value="%s"%s> %s</label>'
                     % (b, ' checked' if m else '', b) for b, m in BANDAS)
    return (MARCA_INI + '''
            <button type="button" class="btn btn-info" id="bh-rbi-abrir" title="Busca repetidores FM en RepeaterBook y los añade como bookmarks con su subtono">Importar repetidores (RepeaterBook)…</button>
            <div id="bh-rbi-panel" class="card mt-2 mb-2" style="display:none"><div class="card-body">
              <h5 class="card-title">Importar repetidores de RepeaterBook</h5>
              <p class="small text-muted mb-2">Repetidores FM analógicos con su subtono (CTCSS). La API key se configura en
                <a href="../settings/general">General settings</a> → RepeaterBook. Para otros países el distrito no aplica (déjalo en «Todos»).</p>
              <div class="form-row row">
                <div class="form-group col-md-2"><label for="bh-rbi-pais">País</label>
                  <input type="text" class="form-control form-control-sm" id="bh-rbi-pais" value="Spain" maxlength="40"></div>
                <div class="form-group col-md-4"><label for="bh-rbi-distrito">Distrito (España)</label>
                  <select class="form-control form-control-sm" id="bh-rbi-distrito">''' + opciones + '''</select></div>
                <div class="form-group col-md-3"><label for="bh-rbi-texto">Texto (indicativo, ciudad…)</label>
                  <input type="text" class="form-control form-control-sm" id="bh-rbi-texto" maxlength="60"></div>
                <div class="form-group col-md-3"><label>Bandas</label><div>''' + bandas + '''</div></div>
              </div>
              <label class="mr-3 me-3"><input type="checkbox" id="bh-rbi-activos" checked> Solo en servicio (on-air)</label>
              <button type="button" class="btn btn-sm btn-primary" id="bh-rbi-buscar">Buscar</button>
              <button type="button" class="btn btn-sm btn-outline-secondary" id="bh-rbi-refrescar" title="Ignora la caché (6 h) y vuelve a descargar">Buscar (refrescar)</button>
              <button type="button" class="btn btn-sm btn-success" id="bh-rbi-importar" disabled>Importar seleccionados (0)</button>
              <button type="button" class="btn btn-sm btn-warning" id="bh-rbi-tonos" title="Busca en RepeaterBook el subtono FM de los bookmarks FM que ya tienes (misma frecuencia de salida) y se lo asigna">Asignar subtonos a los existentes</button>
              <div id="bh-rbi-estado" style="display:none"></div>
              <div id="bh-rbi-tabla" class="mt-2" style="max-height:60vh;overflow:auto"></div>
            </div></div>
            ''' + JS + '''
            ''' + MARCA_FIN + '\n')


def paquete(nombre, rel):
    try:
        m = __import__(nombre)
        base = os.path.dirname(m.__file__) if getattr(m, '__file__', None) else list(m.__path__)[0]
        return os.path.join(base, rel)
    except (ImportError, AttributeError, IndexError):
        return os.path.join('/usr/lib/python3/dist-packages', nombre, rel)


def ruta_html():
    return os.environ.get('OWRX_BOOKMARKS_HTML') or paquete('htdocs', os.path.join('settings', 'bookmarks.html'))


def ruta_http():
    return os.environ.get('OWRX_HTTP_PY') or paquete('owrx', 'http.py')


def ruta_modulo():
    return os.environ.get('OWRX_RBI_DST') or paquete('owrx', os.path.join('controllers', 'settings', MODULO))


def quitar_html(t):
    return re.sub(r'[ \t]*' + re.escape(MARCA_INI) + r'.*?' + re.escape(MARCA_FIN) + r'\n?', '', t, flags=re.S)


def poner_html(t):
    limpio = quitar_html(t)
    m = ANCLA_HTML.search(limpio)
    if m:
        return limpio[:m.end()] + '            ' + bloque() + limpio[m.end():]
    i = limpio.rfind('</body>')
    if i < 0:
        raise ValueError('plantilla settings/bookmarks.html irreconocible')
    b = bloque()
    envuelto = MARCA_INI + '<div class="container"><div class="buttons">' + b[len(MARCA_INI):-len(MARCA_FIN) - 1] + '</div></div>' + MARCA_FIN + '\n'
    return limpio[:i] + envuelto + limpio[i:]


def quitar_py(t):
    return ''.join(l for l in t.splitlines(True) if MARCA_PY not in l)


def poner_py(t):
    limpio = quitar_py(t)
    m = ANCLA_IMPORT.search(limpio)
    if not m:
        raise ValueError('owrx/http.py: import de BookmarksController no encontrado')
    limpio = limpio[:m.end()] + '%s  %s\n' % (IMPORT_PY, MARCA_PY) + limpio[m.end():]
    m = ANCLA_RUTA.search(limpio)
    if not m:
        raise ValueError('owrx/http.py: ruta /settings/bookmarks no encontrada')
    rutas = ''.join('%s%s  %s\n' % (m.group(1), r, MARCA_PY) for r in RUTAS_PY)
    return limpio[:m.start()] + rutas + limpio[m.start():]


def escribir(ruta, original, nuevo):
    if nuevo == original:
        return False
    tmp = ruta + '.bricohams-tmp'
    with open(tmp, 'w', encoding='utf-8', newline='') as f:
        f.write(nuevo)
    os.chmod(tmp, os.stat(ruta).st_mode & 0o777)
    os.replace(tmp, ruta)
    return True


def modulo(sacar, callado):
    dst = ruta_modulo()
    if sacar:
        if os.path.exists(dst):
            os.remove(dst)
            return '%s: eliminado' % dst
        return '%s: no existía' % dst
    src = os.environ.get('BH_RBI_SRC') or SRC_DEF
    nuevo = open(src, encoding='utf-8').read()
    compile(nuevo, dst, 'exec')
    try:
        viejo = open(dst, encoding='utf-8').read()
    except OSError:
        viejo = None
    if viejo == nuevo:
        return '%s: sin cambios' % dst
    tmp = dst + '.bricohams-tmp'
    shutil.copyfile(src, tmp)
    os.chmod(tmp, 0o644)
    os.replace(tmp, dst)
    return '%s: instalado' % dst


def main(a):
    callado = '-q' in a
    sacar = '--quitar' in a
    rc = 0
    # al quitar, primero la ruta (http.py) y luego el módulo; al poner, al revés
    pasos = ['html', 'http', 'mod'] if sacar else ['mod', 'http', 'html']
    for paso in pasos:
        try:
            if paso == 'mod':
                msg = modulo(sacar, callado)
            else:
                ruta, fq, fp = ((ruta_html(), quitar_html, poner_html) if paso == 'html'
                                else (ruta_http(), quitar_py, poner_py))
                original = open(ruta, encoding='utf-8').read()
                nuevo = fq(original) if sacar else fp(original)
                if ruta.endswith('.py'):
                    compile(nuevo, ruta, 'exec')
                cambiado = escribir(ruta, original, nuevo)
                msg = '%s: %s%s' % (ruta, 'parche quitado' if sacar else 'parche aplicado', '' if cambiado else ' (sin cambios)')
        except (OSError, ValueError, SyntaxError) as x:
            if not callado:
                print('%s: %s' % (paso, x), file=sys.stderr)
            rc = 0 if callado else 1
            if paso == 'mod' and not sacar:
                break  # sin módulo no se toca http.py (OpenWebRX no arrancaría)
            continue
        if not callado:
            print(msg)
    return rc


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
