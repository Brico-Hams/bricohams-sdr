#!/usr/bin/env python3
# =====================================================================
#  bricohams-owrx-botones · botones «Meshtastic 433 / 868», «APRS (RAK)»,
#  «Seguridad» (backup remoto) y
#  «Meshtastic Web (868)» (https://<host>:8443/, si MESH_WEB no es «no»)
#  en la página /settings de OpenWebRX+ (v4.5)
#
#  Se añaden a la plantilla settings.html del paquete openwebrx, así salen
#  entres por donde entres (nginx en 80/443 o directo a :8073). La página
#  /settings ya exige la contraseña de administrador; los paneles que abren
#  (bricohams-mesh-admin) vuelven a comprobar la sesión en cada petición.
#  Desde :8073 los enlaces se cambian a https://<host>/settings/bricohams/…
#  porque el panel solo lo sirve nginx.
#
#  Un «apt upgrade» de openwebrx reescribe la plantilla: el gancho
#  /etc/apt/apt.conf.d/99bricohams-owrx-botones lo vuelve a aplicar.
#
#  También añade al final de htdocs/css/admin.css un tema oscuro de alto
#  contraste (entre /* bricohams-tema-oscuro */) para todas las páginas de
#  administración: cajas, desplegables, tarjetas y tablas legibles.
#
#  Uso: bricohams-owrx-botones [-q]      añade los botones (idempotente)
#       bricohams-owrx-botones --quitar  deja la plantilla original
# =====================================================================
import os
import re
import sys

MARCA_INI = '<!-- bricohams-botones -->'
MARCA_FIN = '<!-- /bricohams-botones -->'
BOTON_WEB = '''
        <div class="col-4">
            <a class="btn btn-secondary" id="bricohams-meshweb" href="settings/bricohams/meshtastic">Meshtastic Web (868)</a>
        </div>'''
BOTON_WEB433 = '''
        <div class="col-4">
            <a class="btn btn-secondary" id="bricohams-meshweb433" href="settings/bricohams/meshtastic/chat">Meshtastic Web (433)</a>
        </div>'''
# sin «$»: OpenWebRX+ pasa la plantilla por string.Template
JS = ("<script>if(location.port==='8073'){document.querySelectorAll('a[data-bricohams]').forEach(function(a){"
      "a.href='https://'+location.hostname+'/'+a.getAttribute('href');});}"
      "var w=document.getElementById('bricohams-meshweb');if(w){w.href='https://'+location.hostname+':8443/';}"
      "var q=document.getElementById('bricohams-meshweb433');if(q){q.href='https://'+location.hostname+':8444/';}</script>")


BOTON_TAK = '''
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/tak">Servidor TAK</a>
        </div>'''
BOTON_MON = '''
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/monitorizacion">Monitorización</a>
        </div>'''


def bloque(web=True, tak=False, mon=False, web433=False):
    return MARCA_INI + '''
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/meshtastic">Meshtastic 433 / 868</a>
        </div>
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/aprs">APRS (RAK)</a>
        </div>
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/mapflights">map.flights (ADS-B)</a>
        </div>
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/satelites">Satélites y agendas</a>
        </div>
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/clima">Clima en red</a>
        </div>
        <div class="col-4">
            <a class="btn btn-secondary" data-bricohams href="settings/bricohams/seguridad">Seguridad</a>
        </div>''' + (BOTON_WEB if web else '') + (BOTON_WEB433 if web and web433 else '') + (BOTON_TAK if tak else '') + (BOTON_MON if mon else '') + '''
        ''' + JS + '''
        ''' + MARCA_FIN + '\n'


BLOQUE = bloque()

# Tema oscuro de alto contraste para todas las páginas de administración
# (OpenWebRX+ y paneles BricoHams cargan admin.css). Las cajas de texto,
# desplegables, tarjetas y tablas de Bootstrap salen blancas o con texto gris
# poco legible; aquí van oscuras con texto claro y foco naranja BricoHams.
CSS_INI = '/* bricohams-tema-oscuro */'
CSS_FIN = '/* /bricohams-tema-oscuro */'
TEMA_OSCURO = (
    # Official BricoHams dark tokens (colour manual v1.1); keep identical to bricohams-mesh-admin.
    ':root{--brand-ink:#23272B;--brand-orange:#F26B1D;--on-accent:#23272B;--bg:#111518;--surface:#1C2329;'
    '--text:#F6F8FA;--text-muted:#BAC4CC;--border:#38434C;--link:#FFA06A;--focus:#FFC18F}'
    'html,body{background-color:var(--bg)!important;background-image:none!important;color:var(--text);'
    'font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}'
    'h1,h2{font-family:Montserrat,Inter,system-ui,sans-serif;font-weight:800}'
    '.form-control,.custom-select,select,textarea{background-color:var(--surface)!important;color:var(--text)!important;border:1px solid var(--border)!important}'
    '.form-control:focus,.custom-select:focus,select:focus,textarea:focus{background-color:var(--surface)!important;color:var(--text)!important;'
    'border-color:var(--focus)!important;box-shadow:none!important}'
    ':focus-visible{outline:3px solid var(--focus)!important;outline-offset:3px}'
    '.form-control::placeholder,textarea::placeholder{color:var(--text-muted)!important;opacity:1}'
    '.form-control:disabled,.form-control[readonly]{background-color:var(--bg)!important;color:var(--text-muted)!important}'
    'select option,select optgroup{background-color:var(--surface);color:var(--text)}'
    '.input-group-text{background-color:var(--surface);color:var(--text);border-color:var(--border)}'
    '.form-check-input,.custom-control-label::before{background-color:var(--surface);border-color:var(--text-muted)}'
    '.card,.list-group-item,.modal-content,.dropdown-menu,.popover,.toast{background-color:var(--surface);color:var(--text);border-color:var(--border);border-radius:12px}'
    '.card-header,.card-footer,.modal-header,.modal-footer{background-color:var(--surface);color:var(--text);border-color:var(--border)}'
    '.dropdown-item{color:var(--text)}.dropdown-item:hover,.dropdown-item:focus{background-color:var(--brand-orange);color:var(--on-accent)}'
    '.btn-primary,.btn-primary:hover,.btn-primary:focus,.btn-primary:active{background-color:var(--brand-orange)!important;'
    'border-color:var(--brand-orange)!important;color:var(--on-accent)!important}'
    '.table,.table th,.table td{color:var(--text);border-color:var(--border)}'
    '.table-striped tbody tr:nth-of-type(odd){background-color:var(--surface)}'
    '.table-hover tbody tr:hover{background-color:var(--surface);color:var(--text)}'
    '.text-muted,.form-text,.small.text-muted{color:var(--text-muted)!important}'
    'label,.col-form-label,legend,h1,h2,h3,h4,h5,h6{color:var(--text)}'
    'pre,code,kbd{background-color:var(--surface);color:var(--text)}'
    'pre{padding:.6em;border:1px solid var(--border);border-radius:.25rem}'
    '.breadcrumb{background-color:var(--surface)}.breadcrumb-item.active,.breadcrumb-item+.breadcrumb-item::before{color:var(--text-muted)}'
    'a:not(.btn){color:var(--link)}a:not(.btn):hover{color:var(--focus)}'
    '.nav-tabs .nav-link{color:var(--text)}.nav-tabs .nav-link.active{background-color:var(--surface);color:var(--text);border-color:var(--border) var(--border) var(--surface)}'
    '.tab-body{background-color:var(--surface)}'
    '.bg-white,.bg-light{background-color:var(--surface)!important;color:var(--text)!important}'
    '.btn-light,.btn-outline-light{background-color:var(--surface);color:var(--text);border-color:var(--border)}'
)


def bloque_css():
    return '\n' + CSS_INI + '\n' + TEMA_OSCURO + '\n' + CSS_FIN + '\n'

LOGIN_OSCURO = (
    TEMA_OSCURO +
    '.login{background-color:var(--surface)!important;color:var(--text);'
    'width:calc(100% - 32px);max-width:500px;box-sizing:border-box}'
    '.login .btn-login{background-color:var(--brand-orange);color:var(--on-accent);border-color:var(--brand-orange)}'
)
CABECERA = (
    '.webrx-top-bar{background:var(--surface)!important}'
    '.webrx-top-bar .webrx-rx-texts div,.webrx-top-bar .webrx-rx-texts h1{color:var(--text)}'
    '.webrx-top-bar .openwebrx-main-buttons{background:var(--surface);flex-shrink:0}'
)


def admin_css(settings_html):
    ruta = os.environ.get('OWRX_ADMIN_CSS')
    if ruta:
        return ruta
    return os.path.join(os.path.dirname(settings_html), 'css', 'admin.css')


def quitar_css(texto):
    return re.sub(r'\n?' + re.escape(CSS_INI) + r'.*?' + re.escape(CSS_FIN) + r'\n?', '', texto, flags=re.S)


def tema(ruta, quitar_tema=False, css=TEMA_OSCURO):
    """Añade (o quita) el tema oscuro al final de admin.css; None si no existe."""
    try:
        original = open(ruta, encoding='utf-8').read()
    except OSError:
        return None
    limpio = quitar_css(original)
    nuevo = limpio if quitar_tema else limpio.rstrip('\n') + '\n\n' + CSS_INI + '\n' + css + '\n' + CSS_FIN + '\n'
    if nuevo != original:
        tmp = ruta + '.bricohams-tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(nuevo)
        os.chmod(tmp, os.stat(ruta).st_mode & 0o777)
        os.replace(tmp, ruta)
    return True


ANCLA = re.compile(r'([ \t]*<div class="col-4">\s*<a class="btn btn-secondary" href="features">)')


def env_val(clave, defecto=''):
    """Último valor de CLAVE en bricohams.env (en minúsculas, sin comillas); defecto si falta."""
    try:
        t = open(os.environ.get('BRICOHAMS_ENV', '/etc/bricohams/bricohams.env'), encoding='utf-8').read()
    except OSError:
        return defecto
    m = re.findall(r'^\s*' + re.escape(clave) + r'=["\']?([A-Za-z]*)', t, re.M)
    return m[-1].lower() if m else defecto


def mesh_web():
    """MESH_WEB de bricohams.env (por defecto yes): botón del cliente web de Meshtastic en :8443."""
    return env_val('MESH_WEB', 'yes') != 'no'


def tak():
    """Botón «Servidor TAK» si TAK=yes, o si no se indica y el servicio ya está instalado."""
    v = env_val('TAK', '')
    if v:
        return v == 'yes'
    return os.path.exists(os.environ.get('BRICOHAMS_TAK_UNIT', '/etc/systemd/system/bricohams-tak.service'))


def monitorizacion():
    """Botón «Monitorización» (dashboard de Grafana) si MONITORIZACION=yes."""
    return env_val('MONITORIZACION', 'no') == 'yes'


def plantilla():
    ruta = os.environ.get('OWRX_SETTINGS_HTML')
    if ruta:
        return ruta
    try:
        import htdocs
        return os.path.join(os.path.dirname(htdocs.__file__), 'settings.html')
    except ImportError:
        return '/usr/lib/python3/dist-packages/htdocs/settings.html'


def quitar(texto):
    return re.sub(r'[ \t]*' + re.escape(MARCA_INI) + r'.*?' + re.escape(MARCA_FIN) + r'\n?', '', texto, flags=re.S)


def poner(texto):
    limpio = quitar(texto)
    b = bloque(mesh_web(), tak(), monitorizacion(), env_val('MESH433_WEB', 'no') == 'yes')
    m = ANCLA.search(limpio)
    if m:
        return limpio[:m.start()] + '        ' + b + limpio[m.start():]
    # plantilla distinta: antes de </body>
    i = limpio.rfind('</body>')
    if i < 0:
        raise ValueError('plantilla de OpenWebRX+ irreconocible')
    return limpio[:i] + '<div class="container"><div class="row">' + b + '</div></div>\n' + limpio[i:]


def main(a):
    callado = '-q' in a
    ruta = plantilla()
    try:
        original = open(ruta, encoding='utf-8').read()
    except OSError as x:
        if not callado:
            print('No encuentro la plantilla de OpenWebRX+ (%s): %s' % (ruta, x), file=sys.stderr)
        return 0 if callado else 1
    nuevo = quitar(original) if '--quitar' in a else poner(original)
    if nuevo != original:
        tmp = ruta + '.bricohams-tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(nuevo)
        os.chmod(tmp, os.stat(ruta).st_mode & 0o777)
        os.replace(tmp, ruta)
    if not callado:
        print('%s: botones %s' % (ruta, 'quitados' if '--quitar' in a else 'puestos'))
    css = admin_css(ruta)
    if tema(css, '--quitar' in a) and not callado:
        print('%s: tema oscuro %s' % (css, 'quitado' if '--quitar' in a else 'puesto'))
    for nombre, contenido in (('login.css', LOGIN_OSCURO), ('openwebrx-header.css', CABECERA)):
        hoja = os.path.join(os.path.dirname(css), nombre)
        if tema(hoja, '--quitar' in a, contenido) and not callado:
            print('%s: estilos %s' % (hoja, 'quitados' if '--quitar' in a else 'puestos'))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
