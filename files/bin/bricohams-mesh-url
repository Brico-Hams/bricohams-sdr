#!/usr/bin/env python3
# =====================================================================
#  bricohams-mesh-url · BricoHams (v4.5)
#  Lee una URL de canales de Meshtastic (https://meshtastic.org/e/#…) sin
#  instalar nada (protobuf ChannelSet decodificado a mano) y NUNCA enseña claves:
#    ver URL       canales (nombre, tipo de clave, precisión de posición) y radio
#    contar URL    número de canales (el nodo admite 8)
#    publica URL   la misma URL sin los canales con clave propia (para documentos y git)
#    json URL      resumen en JSON (lo usa bricohams-check)
#  Uso: bricohams-mesh-url ver "$MESH433_CHANNEL_URL"
# =====================================================================
import base64
import json
import sys

REGIONES = {0: 'UNSET', 1: 'US', 2: 'EU_433', 3: 'EU_868', 4: 'CN', 5: 'JP', 6: 'ANZ', 7: 'KR', 8: 'TW', 9: 'RU',
            10: 'IN', 11: 'NZ_865', 12: 'TH', 13: 'LORA_24', 14: 'UA_433', 15: 'UA_868', 16: 'MY_433',
            17: 'MY_919', 18: 'SG_923'}
PRESETS = {0: 'LONG_FAST', 1: 'LONG_SLOW', 2: 'VERY_LONG_SLOW', 3: 'MEDIUM_SLOW', 4: 'MEDIUM_FAST', 5: 'SHORT_SLOW',
           6: 'SHORT_FAST', 7: 'LONG_MODERATE', 8: 'SHORT_TURBO', 9: 'LONG_TURBO'}


def varint(b, i):
    v = s = 0
    while True:
        c = b[i]
        i += 1
        v |= (c & 0x7F) << s
        s += 7
        if not c & 0x80:
            return v, i


def campos(b):
    """[(número, tipo, valor, bytes crudos del campo)]"""
    i, out = 0, []
    while i < len(b):
        ini = i
        k, i = varint(b, i)
        n, t = k >> 3, k & 7
        if t == 0:
            v, i = varint(b, i)
        elif t == 2:
            ln, i = varint(b, i)
            v, i = b[i:i + ln], i + ln
        elif t == 5:
            v, i = int.from_bytes(b[i:i + 4], 'little'), i + 4
        elif t == 1:
            v, i = int.from_bytes(b[i:i + 8], 'little'), i + 8
        else:
            raise ValueError('tipo protobuf %d' % t)
        out.append((n, t, v, b[ini:i]))
    return out


def desde_url(url):
    frag = url.split('#', 1)[-1].strip()
    b = base64.b64decode((frag + '=' * (-len(frag) % 4)).replace('-', '+').replace('_', '/'), validate=True)
    if not b:
        raise ValueError('vacía')
    return b


def a_url(b):
    return 'https://meshtastic.org/e/#' + base64.urlsafe_b64encode(b).decode().rstrip('=')


def tipo_clave(psk):
    if len(psk) == 0:
        return 'sin cifrar'
    if len(psk) == 1:
        return 'pública (por defecto %d)' % psk[0]
    return 'PROPIA AES-%d' % (len(psk) * 8)


def leer(url):
    b = desde_url(url)
    canales, radio = [], {}
    for n, t, v, _ in campos(b):
        if n == 1 and t == 2:
            c = {'nombre': '', 'clave': 'pública (por defecto 1)', 'propia': False, 'subida': False, 'bajada': False,
                 'precision': None}
            for cn, ct, cv, _ in campos(v):
                if cn == 2:
                    c['clave'], c['propia'] = tipo_clave(cv), len(cv) > 1
                elif cn == 3:
                    c['nombre'] = cv.decode('utf-8', 'replace')
                elif cn == 5:
                    c['subida'] = bool(cv)
                elif cn == 6:
                    c['bajada'] = bool(cv)
                elif cn == 7:
                    for mn, _, mv, _ in campos(cv):
                        if mn == 1:
                            c['precision'] = mv
            canales.append(c)
        elif n == 2 and t == 2:
            for rn, rt, rv, _ in campos(v):
                if rn == 1:
                    radio['preset'] = bool(rv)
                elif rn == 2:
                    radio['modem'] = PRESETS.get(rv, rv)
                elif rn == 3:
                    radio['bw_khz'] = 62.5 if rv == 62 else rv
                elif rn == 4:
                    radio['sf'] = rv
                elif rn == 5:
                    radio['cr'] = '4/%d' % rv
                elif rn == 7:
                    radio['region'] = REGIONES.get(rv, rv)
                elif rn == 8:
                    radio['saltos'] = rv
                elif rn == 10:
                    radio['potencia_dbm'] = rv
                elif rn == 14 and rt == 5:
                    import struct
                    radio['frecuencia_mhz'] = round(struct.unpack('<f', rv.to_bytes(4, 'little'))[0], 3)
    if radio:
        radio.setdefault('preset', False)
    if radio.get('preset') and 'modem' not in radio:
        radio['modem'] = 'LONG_FAST'
    return canales, radio


def publica(url):
    out = b''
    for n, t, v, crudo in campos(desde_url(url)):
        if n == 1 and t == 2:
            psk = [cv for cn, _, cv, _ in campos(v) if cn == 2]
            if psk and len(psk[0]) > 1:
                continue
        out += crudo
    return a_url(out)


def main(a):
    if len(a) < 3 or a[1] not in ('ver', 'contar', 'publica', 'json'):
        print(open(__file__, encoding='utf-8').read().split('# =====')[1].replace('\n#  ', '\n').strip('#=\n '))
        return 1
    try:
        canales, radio = leer(a[2])
    except Exception as e:                                  # URL mal copiada
        print('✘ URL de Meshtastic no válida: %s' % e)
        return 1
    if a[1] == 'contar':
        print(len(canales))
    elif a[1] == 'publica':
        print(publica(a[2]))
    elif a[1] == 'json':
        print(json.dumps({'canales': canales, 'radio': radio}, ensure_ascii=False))
    else:
        for i, c in enumerate(canales):
            print('  %d %-12s clave %-22s posición %s%s' % (i, c['nombre'] or '(principal por defecto)', c['clave'],
                                                           c['precision'] if c['precision'] is not None else '-',
                                                           ' · MQTT' if c['subida'] or c['bajada'] else ''))
        print('  radio: ' + ', '.join('%s=%s' % kv for kv in radio.items()))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
