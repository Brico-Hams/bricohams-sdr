#!/usr/bin/env python3
# =====================================================================
#  bricohams-rak-aprs · EA5KAO · BricoHams (v4.5)
#  Pasarela de la Raspberry para el RAK4631 con el firmware «BricoHams RAK APRS»
#  (firmware/rak4631-lora-aprs, port de LoRa_APRS_iGate de CA2RXU).
#
#  El RAK4631 no tiene WiFi: recibe LoRa APRS en 433,775 MHz y lo entrega por USB
#  como TNC KISS. Este programa hace la parte de Internet del iGate original:
#    - sube a APRS-IS lo oído por RF (reglas de iGate: sin TCPIP/NOGATE/RFONLY, qAR)
#      y la baliza y telemetría propias del RAK (con la temperatura de la caja);
#    - le manda al RAK su configuración desde bricohams.env (orden KISS 0x06);
#    - pasa los mensajes de APRS-IS a RF para las estaciones oídas (como messagesToRF del original);
#    - pinta en el MAPA de OpenWebRX+ lo oído (MQTT local «lora433/APRS», v4.5, ADR-50);
#    - deja el estado en /run/bricohams-rak/rak-aprs.json (lo leen bricohams-check,
#      el control de ventiladores y el banner SSH).
#
#  Uso:  bricohams-rak-aprs servicio          (lo arranca systemd)
#        bricohams-rak-aprs prueba            (PING, configuración y estado del RAK)
#        bricohams-rak-aprs estado            (último estado guardado)
#        bricohams-rak-aprs config            (lo que se le mandaría al RAK, sin claves)
#        bricohams-rak-aprs baliza            (pide una baliza ya)
#        bricohams-rak-aprs grabar [paquete.zip] (graba el firmware por DFU serie)
#        bricohams-rak-aprs gps [minutos]     (espera al fix del GPS y dice cuántos satélites ve)
#        bricohams-rak-aprs bootloader        (versión del bootloader por UF2; sale grabando el .uf2)
#        bricohams-rak-aprs puesta-en-marcha  (todo: grabar si hace falta, nombres, prueba, bootloader, GPS)
#  Panel web (v5.1): https://<estación>/settings/bricohams/aprs (solo admin; API local 127.0.0.1:8077).
# =====================================================================
import json
import os
import re
import socket
import subprocess
import sys
import time

sys.path[:0] = [os.path.dirname(os.path.realpath(__file__)), '/usr/local/lib/bricohams']
try:
    from bricohams_mqtt import Publicador, simbolo
except ImportError:                                    # sin el módulo: no hay mapa de OpenWebRX+, el iGate sigue
    Publicador = None

# con systemd (LoadCredential=env:…) el env llega como credencial: el servicio no corre como root
_CRED = os.path.join(os.environ.get('CREDENTIALS_DIRECTORY', '/nonexistent'), 'env')
ENV_FILE = os.environ.get('BRICOHAMS_ENV', _CRED if os.path.exists(_CRED) else '/etc/bricohams/bricohams.env')
RUN_DIR = os.environ.get('RAK_RUN_DIR', '/run/bricohams-rak')
FW_DIR = os.environ.get('RAK_FW_DIR', '/opt/bricohams/firmware/rak4631-lora-aprs')
FEND, FESC, TFEND, TFESC = 0xC0, 0xDB, 0xDC, 0xDD
CMD_DATA, CMD_HW = 0x00, 0x06
VERS = 'BricoHams-RAK 1.0'


# ------------------------------------------------------------------ entorno
def quitar_comillas(v):
    """Valor de una línea de bricohams.env: «"valor"   # comentario» -> valor (sin ejecutar nada)."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        fin = v.find(v[0], 1)
        if fin > 0:
            return v[1:fin]
    return re.sub(r'\s+#.*$', '', v)


def cargar_env(path=ENV_FILE):
    try:
        for linea in open(path, encoding='utf-8'):
            linea = linea.strip()
            if not linea or linea.startswith('#') or '=' not in linea:
                continue
            k, v = linea.split('=', 1)
            os.environ.setdefault(k.strip(), quitar_comillas(v))
    except OSError:
        pass


def env(k, d=''):
    v = os.environ.get(k, '')
    return v if v != '' else d


def si(k, d='no'):
    return env(k, d).strip().lower() in ('1', 'yes', 'si', 'sí', 'true', 'on')


def num(k, d, tipo=float):
    try:
        return tipo(env(k, str(d)))
    except ValueError:
        return tipo(d)


def indicativo():
    return env('RAK_CALLSIGN', env('IGATE_CALLSIGN', 'N0CALL-10')).upper()


def config_deseada():
    """Configuración del RAK a partir de bricohams.env (no lleva claves)."""
    sim = env('RAK_SYMBOL', 'L&')
    return {
        'callsign': indicativo(),
        'comment': env('RAK_COMMENT', 'SDR BricoHams LoRa APRS')[:43],
        'symbol': sim if len(sim) == 2 else 'L&',
        'path': env('RAK_PATH', 'WIDE1-1'),
        'status': env('RAK_STATUS', '')[:62], 'ambiguity': max(0, min(4, int(num('RAK_AMBIGUEDAD', 0, int)))),
        'lat': round(num('STATION_LAT', 0.0), 6), 'lon': round(num('STATION_LON', 0.0), 6),
        'alt': int(num('STATION_ASL', 0)),
        'gps': si('RAK_GPS', 'yes'), 'gpsBeacon': si('RAK_GPS_BALIZA', 'no'),
        'freq': int(num('RAK_FREQ', 433775000, int)), 'sf': int(num('RAK_SF', 12, int)),
        'bw': int(num('RAK_BW', 125000, int)), 'cr': int(num('RAK_CR', 5, int)),
        'power': int(num('RAK_POWER', 20, int)), 'tx': si('RAK_TX', 'no'), 'cad': True,
        'digi': int(num('RAK_DIGI', 0, int)),
        'beaconMin': int(num('RAK_BEACON_MIN', 15, int)), 'beaconRF': si('RAK_BEACON_RF', 'no'),
        'telemetryMin': int(num('RAK_TELEMETRY_MIN', 10, int)), 'telemetryRF': si('RAK_TELEMETRY_RF', 'no'),
        'tempInComment': True, 'tempOffset': num('RAK_TEMP_OFFSET', 0.0),
        'battery': si('RAK_BATERIA', 'no'), 'kissOwn': True, 'statusSec': 60,
    }


def difiere(actual, deseada):
    """Claves de «deseada» que el RAK tiene distintas (los float con tolerancia)."""
    malas = []
    for k, v in deseada.items():
        a = actual.get(k)
        if isinstance(v, float) or isinstance(a, float):
            try:
                if abs(float(a) - float(v)) > 1e-5:
                    malas.append(k)
            except (TypeError, ValueError):
                malas.append(k)
        elif a != v:
            malas.append(k)
    return malas


# ------------------------------------------------------------------ KISS / AX.25
def kiss_frame(cmd, datos):
    out = bytearray([FEND, cmd & 0x0F])
    for b in datos:
        if b == FEND:
            out += bytes([FESC, TFEND])
        elif b == FESC:
            out += bytes([FESC, TFESC])
        else:
            out.append(b)
    out.append(FEND)
    return bytes(out)


class LectorKISS:
    """Trocea el flujo del USB en tramas KISS: devuelve (orden, datos sin escapar)."""

    def __init__(self):
        self.buf, self.dentro = bytearray(), False

    def alimentar(self, datos):
        tramas = []
        for b in datos:
            if b == FEND:
                if self.dentro and self.buf:
                    tramas.append(self._cerrar())
                self.buf, self.dentro = bytearray(), True
            elif self.dentro:
                self.buf.append(b)
                if len(self.buf) > 1024:
                    self.buf, self.dentro = bytearray(), False
        return tramas

    def _cerrar(self):
        cmd, crudo, datos, esc = self.buf[0], self.buf[1:], bytearray(), False
        for b in crudo:
            if esc:
                datos.append(FEND if b == TFEND else FESC if b == TFESC else b)
                esc = False
            elif b == FESC:
                esc = True
            else:
                datos.append(b)
        return cmd, bytes(datos)


def _dir_ax25(campo):
    nombre = ''.join(chr(c >> 1) for c in campo[:6]).strip()
    ssid = (campo[6] >> 1) & 0x0F
    return nombre + ('-%d' % ssid if ssid else ''), bool(campo[6] & 0x80), bool(campo[6] & 0x01)


def ax25_a_tnc2(trama):
    if len(trama) < 16:
        raise ValueError('trama corta')
    dst, _, _ = _dir_ax25(trama[0:7])
    src, _, ultimo = _dir_ax25(trama[7:14])
    ruta, i = [], 14
    while not ultimo and i + 7 <= len(trama):
        d, h, ultimo = _dir_ax25(trama[i:i + 7])
        ruta.append(d + ('*' if h else ''))
        i += 7
    if i + 2 > len(trama) or trama[i] != 0x03 or trama[i + 1] != 0xF0:
        raise ValueError('no es UI/APRS')
    info = trama[i + 2:].decode('latin-1')
    return '%s>%s%s:%s' % (src, dst, ''.join(',' + r for r in ruta), info)


def _codifica_dir(texto, ultimo):
    rep = texto.endswith('*')
    texto = texto.rstrip('*')
    nombre, _, ssid = texto.partition('-')
    campo = bytes((ord(c) << 1) for c in nombre.upper().ljust(6)[:6])
    b = 0x60 | ((int(ssid or 0) & 0x0F) << 1) | (0x80 if rep else 0) | (0x01 if ultimo else 0)
    return campo + bytes([b])


def tnc2_a_ax25(tnc2):
    cab, info = tnc2.split(':', 1)
    src, resto = cab.split('>', 1)
    partes = resto.split(',')
    dirs = [partes[0], src] + partes[1:]
    out = b''.join(_codifica_dir(d, i == len(dirs) - 1) for i, d in enumerate(dirs))
    return out + b'\x03\xf0' + info.encode('latin-1')


# ------------------------------------------------------------------ reglas de iGate
PROHIBIDOS = ('TCPIP', 'TCPXX', 'NOGATE', 'RFONLY')


def para_aprsis(tnc2, propio, igate):
    """Línea para APRS-IS o None si no se sube (reglas de iGate de APRS-IS)."""
    try:
        cab, info = tnc2.split(':', 1)
        src, resto = cab.split('>', 1)
    except ValueError:
        return None
    ruta = resto.split(',')
    if not info or any(p.rstrip('*') in PROHIBIDOS for p in ruta):
        return None
    if propio:
        if src != igate:
            return None
        return '%s>%s,TCPIP*:%s' % (src, ruta[0], info)
    if src == igate or info.startswith('?') or info.startswith('}'):   # bucles, consultas y terceros
        return None
    return '%s>%s,qAR,%s:%s' % (src, ','.join(ruta), igate, info)


# ------------------------------------------------------------------ posición (para el mapa de OpenWebRX+)
TOCALL = 'APZBH1'
FREQ_LORA = 433775000


def _coord(txt, grados, hemis):
    txt = txt.replace(' ', '0')                       # ambigüedad: el centro del recuadro sería más fino; vale
    v = int(txt[:grados]) + float(txt[grados:]) / 60.0
    return -v if hemis in 'SW' else v


def _b91(t):
    v = 0
    for c in t:
        v = v * 91 + ord(c) - 33
    return v


def posicion(info):
    """{lat, lon, tabla, simbolo, comentario} de un campo de información APRS (sin comprimir o comprimido)."""
    try:
        if info[0] in '/\\' or (info[0].isalpha() and not info[0].isdigit()):   # comprimida
            if len(info) >= 13:
                return {'lat': 90 - _b91(info[1:5]) / 380926.0, 'lon': -180 + _b91(info[5:9]) / 190463.0,
                        'tabla': info[0], 'simbolo': info[9], 'comentario': info[13:].strip()}
            return None
        if len(info) >= 19 and info[7] in 'NS' and info[17] in 'EW':
            return {'lat': _coord(info[0:7], 2, info[7]), 'lon': _coord(info[9:17], 3, info[17]),
                    'tabla': info[8], 'simbolo': info[18], 'comentario': info[19:].strip()}
    except (ValueError, IndexError):
        pass
    return None


def aprs_mapa(tnc2, meta=None, origen='LoRa 433,775'):
    """Mensaje para OpenWebRX+ (owrx/mqtt.py → AprsParser.updateMap) o None si no lleva posición."""
    try:
        cab, info = tnc2.split(':', 1)
        src, resto = cab.split('>', 1)
    except ValueError:
        return None
    ruta = resto.split(',')
    d = {'mode': 'APRS', 'source': src, 'destination': ruta[0], 'path': ruta[1:],
         'timestamp': int(time.time() * 1000)}
    if origen == 'LoRa 433,775':
        d['freq'] = FREQ_LORA
    t = info[:1]
    if t and t in '!=':
        pos = posicion(info[1:])
    elif t and t in '/@':
        pos = posicion(info[8:])
    elif t == ';' and len(info) > 18:                  # objeto: ;NOMBRE___*DDHHMMz<posición>
        d.update({'type': 'object', 'object': info[1:10].strip()})
        pos = posicion(info[18:])
    else:
        pos = None
    if not pos or not (-90 <= pos['lat'] <= 90 and -180 <= pos['lon'] <= 180):
        return None
    meta = meta or {}
    extra = origen + (' · %s dBm' % meta['rssi'] if meta.get('rssi') is not None else '') + \
        (' · SNR %s dB' % meta['snr'] if meta.get('snr') is not None else '')
    d.update({'lat': round(pos['lat'], 6), 'lon': round(pos['lon'], 6),
              'symbol': simbolo(pos['simbolo'], pos['tabla']) if Publicador else None,
              'comment': (pos['comentario'] + ' · ' if pos['comentario'] else '') + extra})
    return d


def mensaje_chat(tnc2):
    """Solo texto APRS: no acuses de recibo ni metadatos de telemetria."""
    try:
        cab, info = tnc2.split(':', 1)
        src = cab.split('>', 1)[0]
    except ValueError:
        return None
    if info.startswith('}'):
        return mensaje_chat(info[1:]) if not info[1:].startswith('}') else None
    if not re.fullmatch(r'[A-Za-z0-9]{1,9}(?:-[0-9]{1,2})?', src):
        return None
    if len(info) < 12 or info[0] != ':' or info[10] != ':':
        return None
    dest, texto = info[1:10].strip(), info[11:]
    if not dest or re.match(r'^(?:ack|rej)[A-Za-z0-9]{1,5}$|^(?:PARM|UNIT|EQNS|BITS)\.', texto):
        return None
    texto = re.sub(r'\{[A-Za-z0-9]{1,5}(?:\}[A-Za-z0-9]{0,5})?$', '', texto)
    texto = ''.join(c for c in texto if ord(c) >= 32).strip()[:200]
    if not texto:
        return None
    return {'state': 'ChatMessage', 'name': '%s -> %s' % (src.upper(), dest.upper()), 'message': texto}


class ChatAPRS:
    def __init__(self, mqtt):
        self.mqtt, self.vistos = mqtt, {}

    def recibir(self, tnc2, ahora):
        m = mensaje_chat(tnc2)
        if not m:
            return False
        self.vistos = {k: t for k, t in self.vistos.items() if ahora - t < 300}
        clave = (m['name'], m['message'])
        if clave in self.vistos:
            return False
        if not self.mqtt.publicar('aprs/CLIENT', m):
            print('aprs chat: broker MQTT no disponible', flush=True)
            return False
        if len(self.vistos) >= 1024:
            del self.vistos[next(iter(self.vistos))]
        self.vistos[clave] = ahora
        return True


def mensaje_a_rf(linea, igate, oidas, ahora, recordar=1800, ruta='WIDE1-1'):
    """Mensaje de APRS-IS para una estación oída por RF hace menos de «recordar» s → paquete de terceros
    para transmitir (como aprs_is.messagesToRF del iGate original). None si no toca."""
    if not linea or linea.startswith('#') or ':' not in linea or '>' not in linea:
        return None
    cab, info = linea.split(':', 1)
    src, resto = cab.split('>', 1)
    camino = resto.split(',')
    if len(info) < 11 or info[0] != ':' or info[10] != ':':
        return None
    destinatario = info[1:10].strip().upper()
    if any(x.rstrip('*') in ('TCPXX', 'NOGATE', 'RFONLY') for x in camino) or src == igate:
        return None
    if ahora - oidas.get(destinatario, 0) > recordar:         # no la hemos oído: no se molesta en RF
        return None
    if ahora - oidas.get(src, 0) <= recordar:                  # el remitente está en RF: ya lo oye directo
        return None
    return '%s>%s%s:}%s>%s,TCPIP,%s*:%s' % (igate, TOCALL, (',' + ruta) if ruta else '', src, camino[0], igate, info)


# ------------------------------------------------------------------ estado
def redondear(v, dec):
    try:
        return round(float(v), dec)
    except (TypeError, ValueError):
        return None


def guardar_estado(estado):
    os.makedirs(RUN_DIR, exist_ok=True)
    ruta = os.path.join(RUN_DIR, 'rak-aprs.json')
    tmp = ruta + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(estado, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, ruta)


def resumir_status(st, decimales):
    """Estado del RAK para el fichero público: la posición del GPS redondeada (manual 34)."""
    g = dict(st.get('gps') or {})
    for k in ('lat', 'lon'):
        if k in g:
            g[k] = redondear(g[k], decimales)
    s = dict(st)
    s['gps'] = g
    return s


# ------------------------------------------------------------------ APRS-IS
class APRSIS:
    def __init__(self, servidor, puerto, call, passcode, filtro=''):
        self.servidor, self.puerto, self.call, self.passcode, self.filtro = servidor, puerto, call, passcode, filtro
        self.sock, self.proximo_intento, self.enviados, self.buf = None, 0, 0, b''

    def activo(self):
        return bool(self.passcode) and self.passcode != '-1'

    def conectar(self):
        if self.sock or not self.activo() or time.time() < self.proximo_intento:
            return
        try:
            s = socket.create_connection((self.servidor, self.puerto), timeout=15)
            s.sendall(('user %s pass %s vers %s%s\r\n' % (self.call, self.passcode, VERS,
                                                         (' filter ' + self.filtro) if self.filtro else '')).encode())
            s.settimeout(0.0)
            self.sock = s
            print('aprs-is: conectado a %s:%d como %s' % (self.servidor, self.puerto, self.call), flush=True)
        except OSError as e:
            self.proximo_intento = time.time() + 60
            print('aprs-is: sin conexión (%s); reintento en 60 s' % e, flush=True)

    def lineas(self):
        """Líneas completas llegadas de APRS-IS (sin bloquear)."""
        if not self.sock:
            self.conectar()
            return []
        try:
            while True:
                d = self.sock.recv(4096)
                if not d:
                    self.cerrar()
                    break
                self.buf += d
        except BlockingIOError:
            pass
        except OSError:
            self.cerrar()
        *ls, self.buf = self.buf.split(b'\n')
        self.buf = self.buf[-4096:]
        return [x.decode('latin-1').strip() for x in ls if x.strip()]

    def vaciar(self):
        self.lineas()

    def enviar(self, linea):
        self.conectar()
        if not self.sock:
            return False
        try:
            self.sock.settimeout(10)
            self.sock.sendall((linea + '\r\n').encode('latin-1', 'replace'))
            self.sock.settimeout(0.0)
            self.enviados += 1
            return True
        except OSError:
            self.cerrar()
            return False

    def cerrar(self):
        try:
            if self.sock:
                self.sock.close()
        finally:
            self.sock, self.proximo_intento = None, time.time() + 30


# ------------------------------------------------------------------ RAK
def puerto():
    p = env('RAK_PUERTO', '/dev/rak-aprs')
    if os.path.exists(p):
        return p
    raise SystemExit('✘ No existe %s. ¿Está enchufado el RAK? sudo bricohams-dispositivos identificar' % p)


def abrir(p):
    import serial                                           # python3-serial
    s = serial.Serial(p, 115200, timeout=0.2)
    try:
        s.dtr = True                                        # el CDC de TinyUSB solo habla con DTR activo
    except OSError:
        pass                                                # (pty de las pruebas)
    return s


def orden(ser, texto):
    ser.write(kiss_frame(CMD_HW, texto.encode('utf-8')))
    ser.flush()


def json_rak(texto):
    """JSON del RAK. El firmware 1.0.0 llegó a mandar «"vbat": nan» (no es JSON);
    nan/inf sueltos se leen como null para no perder el estado entero."""
    return json.loads(re.sub(r'(?<=[:,\[])\s*-?(?:nan|inf(?:inity)?)\b', 'null', texto, flags=re.I))


def esperar_hw(ser, lector, prefijo, segundos=5):
    fin = time.time() + segundos
    while time.time() < fin:
        for cmd, datos in lector.alimentar(ser.read(512)):
            if cmd & 0x0F == CMD_HW:
                t = datos.decode('utf-8', 'replace')
                if t.startswith(prefijo):
                    return t[len(prefijo):].strip()
    return None


def sincronizar_config(ser, lector):
    deseada = config_deseada()
    orden(ser, 'BH:CONF?')
    actual = esperar_hw(ser, lector, 'BH:CONF')
    try:
        actual = json_rak(actual) if actual else {}
    except ValueError:
        actual = {}
    malas = difiere(actual, deseada)
    if not malas:
        return 'al día'
    orden(ser, 'BH:CFG ' + json.dumps(deseada, separators=(',', ':')))
    r = esperar_hw(ser, lector, 'BH:CFG', 8)
    return 'actualizada (%s): %s' % (', '.join(malas), r or 'sin respuesta')



# ------------------------------------------------------------------ digipeater automático (v4.5.1)
def digi_auto(ahora, inicio, ultimo_visto, minutos=60, modo=1):
    """RAK_DIGI="auto": el RAK solo hace de digipeater si el otro iGate de la estación (RAK_DIGI_OTRO, el
    LilyGO EA5KAO-10) lleva «minutos» sin oírse por RF. Al arrancar se espera ese tiempo antes de decidir."""
    if ahora - inicio < minutos * 60:
        return 0
    return modo if ahora - ultimo_visto >= minutos * 60 else 0


def visto_en(tnc2, call):
    """El paquete es de «call» o lo ha repetido «call» (call* en la ruta)."""
    if not call or '>' not in tnc2 or ':' not in tnc2:
        return False
    cab = tnc2.split(':', 1)[0]
    src, resto = cab.split('>', 1)
    return src == call or (call + '*') in resto.split(',')[1:]


# ------------------------------------------------------------------ mensajes APRS (panel web)
def mensaje_para(info, call):
    """(texto, id) si el campo de información es un mensaje para «call»; si no, None."""
    if len(info) < 11 or info[0] != ':' or info[10] != ':' or info[1:10].strip().upper() != call:
        return None
    texto = info[11:]
    mid = None
    if '{' in texto:
        texto, mid = texto.rsplit('{', 1)
        mid = mid.split('}')[0][:5] or None
    return texto, mid


def linea_mensaje(a, texto, mid=None):
    texto = re.sub(r'[|~{]', '', texto)[:67]
    return ':%-9s:%s%s' % (a.upper()[:9], texto, ('{%s' % mid) if mid else '')


# ------------------------------------------------------------------ servicio
class Pasarela:
    """Todo el estado del servicio; el bucle principal es el único que toca el puerto serie y APRS-IS.
    El panel web (hilo HTTP) solo lee el estado y deja órdenes en una cola."""

    def __init__(self):
        import queue
        import threading
        self.igate = indicativo()
        self.decimales = int(num('OWRX_GPS_DECIMALES', 2, int)) if env('OWRX_GPS_DECIMALES', '2').isdigit() else 6
        self.aprsis = APRSIS(env('RAK_APRSIS_SERVER', env('IGATE_APRSIS_SERVER', 'euro.aprs2.net')),
                             int(num('RAK_APRSIS_PORT', 14580, int)), self.igate,
                             env('APRS_PASSCODE') if si('RAK_APRSIS', 'yes') else '', env('RAK_APRSIS_FILTRO', 'm/10'))
        self.tx = si('RAK_TX', 'no')
        self.a_rf = self.tx and si('RAK_MENSAJES_RF', 'yes')
        self.recordar = int(num('RAK_RECORDAR_MIN', 30, int)) * 60
        self.ruta1 = env('RAK_PATH', 'WIDE1-1').split(',')[0]
        self.mqtt = None
        self.mapa_activo, self.chat_activo = si('OWRX_MAPA_LORA', 'yes'), si('RAK_OWRX_CHAT', 'yes')
        if not Publicador and (self.mapa_activo or self.chat_activo):
            print('rak: falta bricohams_mqtt; mapa y chat no disponibles', file=sys.stderr, flush=True)
        if Publicador and (self.mapa_activo or self.chat_activo):
            h, _, pt = env('BRICOHAMS_MQTT', '127.0.0.1:1883').partition(':')
            self.mqtt = Publicador(h, int(pt or 1883), 'bricohams-rak-aprs')
        self.chat = ChatAPRS(self.mqtt) if self.mqtt and self.chat_activo else None
        self.cola = queue.Queue()
        self.lock = threading.Lock()
        self.oidas, self.enviados_rf, self.vistos = {}, {}, {}
        self.oidos, self.posiciones, self.mensajes = [], {}, []
        self.estado_rak, self.meta = {}, {}
        self.inicio = time.time()
        self.digi_modo = env('RAK_DIGI', '0').strip().lower()
        self.digi_otro = env('RAK_DIGI_OTRO', env('IGATE_CALLSIGN', '')).upper()
        self.digi_min = int(num('RAK_DIGI_AUTO_MIN', 60, int))
        self.otro_visto = 0.0
        self.digi_actual = None
        self.n_msg = int(time.time()) % 1000
        self.ser = None

    # --- configuración (con el digipeater automático)
    def digi_deseado(self):
        if self.digi_modo == 'auto':
            if not self.tx:
                return 0
            return digi_auto(time.time(), self.inicio, self.otro_visto, self.digi_min,
                             int(num('RAK_DIGI_AUTO_MODO', 1, int)))
        return int(num('RAK_DIGI', 0, int))

    def config(self):
        c = config_deseada()
        c['digi'] = self.digi_deseado()
        return c

    def sincronizar(self, lector):
        deseada = self.config()
        orden(self.ser, 'BH:CONF?')
        actual = esperar_hw(self.ser, lector, 'BH:CONF')
        try:
            actual = json_rak(actual) if actual else {}
        except ValueError:
            actual = {}
        malas = difiere(actual, deseada)
        self.digi_actual = deseada['digi']
        if not malas:
            return 'al día'
        orden(self.ser, 'BH:CFG ' + json.dumps(deseada, separators=(',', ':')))
        r = esperar_hw(self.ser, lector, 'BH:CFG', 8)
        return 'actualizada (%s): %s' % (', '.join(malas), r or 'sin respuesta')

    # --- salida
    def transmitir(self, tnc2):
        if self.tx and self.ser:
            self.ser.write(kiss_frame(CMD_DATA, tnc2_a_ax25(tnc2)))
            return True
        return False

    def enviar_mensaje(self, a, texto, mid=None, apunte=True):
        if mid is None:
            self.n_msg = self.n_msg % 999 + 1
            mid = str(self.n_msg)
        linea = linea_mensaje(a, texto, mid if mid != '-' else None)
        via = []
        if self.transmitir('%s>%s,%s:%s' % (self.igate, TOCALL, self.ruta1, linea)):
            via.append('RF')
        if self.aprsis.enviar('%s>%s,TCPIP*:%s' % (self.igate, TOCALL, linea)):
            via.append('APRS-IS')
        if apunte:
            with self.lock:
                self.mensajes.insert(0, {'hora': time.strftime('%H:%M:%S'), 'de': self.igate, 'a': a.upper(),
                                         'texto': texto, 'id': mid, 'via': '+'.join(via) or 'sin salida',
                                         'ack': False})
                del self.mensajes[50:]
        return via

    def recibir_mensaje(self, src, info, via):
        m = mensaje_para(info, self.igate)
        if not m:
            return
        texto, mid = m
        if texto.startswith('ack') or texto.startswith('rej'):
            with self.lock:
                for x in self.mensajes:
                    if x['de'] == self.igate and x['a'] == src and x['id'] == texto[3:]:
                        x['ack'] = texto.startswith('ack')
            return
        with self.lock:
            self.mensajes.insert(0, {'hora': time.strftime('%H:%M:%S'), 'de': src, 'a': self.igate, 'texto': texto,
                                     'id': mid, 'via': via})
            del self.mensajes[50:]
        if mid:
            self.enviar_mensaje(src, 'ack' + mid, '-', apunte=False)

    # --- entrada
    def de_aprsis(self, ahora):
        for l in self.aprsis.lineas():
            if l.startswith('#') or ':' not in l or '>' not in l:
                continue
            src = l.split('>', 1)[0]
            info = l.split(':', 1)[1]
            if self.chat:
                self.chat.recibir(l, ahora)
            if self.mqtt and self.mapa_activo:
                m = aprs_mapa(l, origen='APRS-IS')
                if m and not self.mqtt.publicar('aprsis/APRS', m):
                    print('aprs-is mapa: broker MQTT no disponible', flush=True)
            self.recibir_mensaje(src, info, 'APRS-IS')
            p = mensaje_a_rf(l, self.igate, self.oidas, ahora, self.recordar, self.ruta1) if self.a_rf else None
            if p and ahora - self.enviados_rf.get(info, 0) > 300 and self.tx:
                self.enviados_rf[info] = ahora
                self.transmitir(p)
                print('aprs-is -> rf: %s' % p, flush=True)
        self.enviados_rf = {k: v for k, v in self.enviados_rf.items() if ahora - v < 600}

    def de_rak(self, cmd, datos):
        if cmd & 0x0F == CMD_HW:
            t = datos.decode('utf-8', 'replace')
            if t.startswith('BH:STATUS '):
                try:
                    self.estado_rak = json_rak(t[10:])
                except ValueError:
                    pass
            elif t.startswith('BH:RX '):
                try:
                    self.meta = json_rak(t[6:])
                except ValueError:
                    self.meta = {}
            elif t.startswith('BH:LOG '):
                print('rak: ' + t[7:], flush=True)
            return
        if cmd & 0x0F != CMD_DATA:
            return
        try:
            tnc2 = ax25_a_tnc2(datos)
        except ValueError:
            return
        ahora = time.time()
        src = tnc2.split('>', 1)[0]
        propio = src == self.igate
        if visto_en(tnc2, self.digi_otro):
            self.otro_visto = ahora
        linea = para_aprsis(tnc2, propio, self.igate)
        clave = src + tnc2.split(':', 1)[1]
        if self.chat:
            self.chat.recibir(tnc2, ahora)
        self.vistos = {k: v for k, v in self.vistos.items() if ahora - v < 30}
        subido = False
        if linea and clave not in self.vistos:
            self.vistos[clave] = ahora
            subido = self.aprsis.enviar(linea)
        if not propio:
            if ':}' not in tnc2:
                self.oidas[src] = ahora
            m = aprs_mapa(tnc2, self.meta)
            en_mapa = bool(m) and bool(self.mqtt) and self.mapa_activo and self.mqtt.publicar('lora433/APRS', m)
            with self.lock:
                if m:
                    self.posiciones[m.get('object') or src] = {
                        'lat': m['lat'], 'lon': m['lon'], 'simbolo': (m.get('symbol') or {}).get('symbol', '/'),
                        'tabla': (m.get('symbol') or {}).get('table', '/'), 'comentario': m.get('comment', '')[:120],
                        'hora': time.strftime('%H:%M:%S'), 't': ahora}
                    if len(self.posiciones) > 150:
                        del self.posiciones[min(self.posiciones, key=lambda k: self.posiciones[k]['t'])]
                self.oidos.insert(0, {'mapa': en_mapa, 'hora': time.strftime('%H:%M:%S'), 'de': src,
                                      'rssi': self.meta.get('rssi'), 'snr': self.meta.get('snr'), 'aprsis': subido,
                                      'paquete': tnc2[:160]})
                del self.oidos[50:]
            self.recibir_mensaje(src, tnc2.split(':', 1)[1], 'RF')
            print('rf: %s%s' % (tnc2, '  -> APRS-IS' if subido else ''), flush=True)
        self.meta = {}

    def ordenes(self):
        import queue
        while True:
            try:
                o = self.cola.get_nowait()
            except queue.Empty:
                return
            if o[0] == 'baliza' and self.ser:
                orden(self.ser, 'BH:BEACON')
            elif o[0] == 'mensaje':
                self.enviar_mensaje(o[1], o[2])

    # --- estado
    def estado(self, publico=True):
        with self.lock:
            e = {'actualizado': time.strftime('%Y-%m-%dT%H:%M:%S'), 'puerto': getattr(self.ser, 'port', None),
                 'indicativo': self.igate,
                 'rak': resumir_status(self.estado_rak, self.decimales), 't_caja': (self.estado_rak or {}).get('t'),
                 'aprsis': {'conectado': self.aprsis.sock is not None, 'enviados': self.aprsis.enviados,
                            'activo': self.aprsis.activo(), 'mensajes_a_rf': self.a_rf},
                 'mapa_owrx': {'activo': self.mqtt is not None and self.mapa_activo, 'chat': self.chat is not None,
                               'publicados': self.mqtt.enviados if self.mqtt else 0},
                 'digi': {'modo': self.digi_modo, 'actual': self.digi_actual, 'otro': self.digi_otro,
                          'otro_oido': time.strftime('%H:%M:%S', time.localtime(self.otro_visto)) if self.otro_visto else None},
                 'tx': self.tx, 'oidos': list(self.oidos[:30])}
            if not publico:
                e.update({'posiciones': dict(self.posiciones), 'mensajes': list(self.mensajes),
                          'oidos': list(self.oidos), 'config': self.config()})
        return e


class _Api:
    """Panel web del iGate (manual 35): GET /estado · POST /baliza · POST /mensaje {"a", "texto"}.
    Solo escucha en 127.0.0.1; la usa bricohams-mesh-admin en /settings/bricohams/aprs (sesión de admin)."""

    @staticmethod
    def arrancar(pasarela, puerto):
        import threading
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

        class H(BaseHTTPRequestHandler):
            def _json(self, codigo, datos):
                b = json.dumps(datos, ensure_ascii=False).encode()
                self.send_response(codigo)
                self.send_header('Content-Type', 'application/json; charset=utf-8')
                self.send_header('Cache-Control', 'no-store')
                self.send_header('Content-Length', str(len(b)))
                self.end_headers()
                self.wfile.write(b)

            def do_GET(self):
                if self.path.split('?')[0].rstrip('/') in ('/estado', ''):
                    return self._json(200, pasarela.estado(publico=False))
                self._json(404, {'error': 'no existe'})

            def do_POST(self):
                ruta = self.path.split('?')[0].rstrip('/')
                try:
                    n = min(int(self.headers.get('Content-Length') or 0), 4096)
                    d = json.loads(self.rfile.read(n) or b'{}')
                except ValueError:
                    return self._json(400, {'error': 'JSON no válido'})
                if ruta == '/baliza':
                    pasarela.cola.put(('baliza',))
                    return self._json(200, {'ok': True})
                if ruta == '/mensaje':
                    a, texto = str(d.get('a', '')).strip().upper(), str(d.get('texto', '')).strip()
                    if not re.match(r'^[A-Z0-9]{3,6}(-[0-9A-Z]{1,2})?$', a) or not texto:
                        return self._json(400, {'error': 'indicativo o texto no válidos'})
                    pasarela.cola.put(('mensaje', a, texto[:67]))
                    return self._json(200, {'ok': True})
                self._json(404, {'error': 'no existe'})

            def log_message(self, *_):
                pass

        srv = ThreadingHTTPServer(('127.0.0.1', puerto), H)
        threading.Thread(target=srv.serve_forever, daemon=True, name='api-aprs').start()
        return srv


def servicio():
    cargar_env()
    if not si('RAK_ENABLE', 'yes'):
        print('RAK_ENABLE=no: nada que hacer', flush=True)
        return 0
    p = Pasarela()
    if not p.aprsis.activo():
        print('aviso: sin APRS_PASSCODE (o RAK_APRSIS=no): solo escucha, no sube nada a APRS-IS', flush=True)
    try:
        _Api.arrancar(p, int(num('RAK_API_PUERTO', 8077, int)))
    except OSError as e:
        print('aviso: sin panel web (%s)' % e, flush=True)
    t_estado = t_latido = t_digi = 0.0
    while True:
        try:
            p.ser = abrir(puerto())
        except (SystemExit, OSError) as e:
            print('rak: %s; reintento en 20 s' % e, flush=True)
            p.ser = None
            for _ in range(20):
                p.ordenes()
                time.sleep(1)
            continue
        lector = LectorKISS()
        print('rak: abierto %s · configuración %s' % (p.ser.port, p.sincronizar(lector)), flush=True)
        orden(p.ser, 'BH:GET')
        ultimo_dato = time.time()
        try:
            while True:
                ahora = time.time()
                p.de_aprsis(ahora)
                p.ordenes()
                for cmd, datos in lector.alimentar(p.ser.read(512)):
                    ultimo_dato = time.time()
                    p.de_rak(cmd, datos)
                if p.mqtt and ahora - t_latido > 30:
                    p.mqtt.latido()
                    t_latido = ahora
                if p.digi_modo == 'auto' and ahora - t_digi > 60:
                    t_digi = ahora
                    if p.digi_deseado() != p.digi_actual:
                        print('digi: %s -> %s (%s %s)' % (p.digi_actual, p.digi_deseado(), p.digi_otro,
                              'callado' if p.digi_deseado() else 'activo'), flush=True)
                        p.sincronizar(lector)
                if (p.estado_rak or p.oidos) and ahora - t_estado > 5:
                    t_estado = ahora
                    guardar_estado(p.estado())
                if ahora - ultimo_dato > 180:
                    raise OSError('el RAK no habla desde hace 3 min')
        except OSError as e:
            print('rak: %s; reabro en 5 s' % e, flush=True)
            try:
                p.ser.close()
            except OSError:
                pass
            p.ser = None
            time.sleep(5)


# ------------------------------------------------------------------ órdenes de puesta en marcha
class servicio_parado:
    """Las pruebas abren el puerto serie: el servicio lo suelta mientras tanto y se vuelve a arrancar."""

    def __enter__(self):
        self.estaba = subprocess.call(['systemctl', 'is-active', '--quiet', 'bricohams-rak-aprs']) == 0
        if self.estaba:
            subprocess.call(['systemctl', 'stop', 'bricohams-rak-aprs'])
            time.sleep(1)
        return self

    def __exit__(self, *a):
        if self.estaba:
            subprocess.call(['systemctl', 'start', 'bricohams-rak-aprs'])


def _estado_rak(ser, lector):
    orden(ser, 'BH:GET')
    st = esperar_hw(ser, lector, 'BH:STATUS')
    return json_rak(st) if st else {}


def prueba():
    cargar_env()
    with servicio_parado():
        ser = abrir(puerto())
        lector = LectorKISS()
        orden(ser, 'BH:PING')
        pong = esperar_hw(ser, lector, 'BH:PONG')
        if not pong:
            print('✘ El RAK no contesta. ¿Tiene el firmware BricoHams? sudo bricohams-rak-aprs grabar')
            return 1
        print('✔ firmware: %s' % pong)
        print('  configuración: %s' % sincronizar_config(ser, lector))
        try:
            st = _estado_rak(ser, lector)
        except ValueError as e:
            print('  ✘ estado ilegible: %s' % str(e)[:200])
            return 1
        finally:
            ser.close()
    g = st.get('gps') or {}
    print('  radio: %s · %.3f MHz · TX %s · digi %s' % (st.get('radio'), st.get('freq', 0) / 1e6,
                                                       'sí' if st.get('tx') else 'no', st.get('digi')))
    print('  caja: %s °C (%s)%s' % (st.get('t', '?'), st.get('sensor', '?'),
                                    (' · %s %%' % st['h']) if 'h' in st else ''))
    print('  GPS: %s' % ('sin GPS (¿módulo en el slot A?)' if not g.get('present') else
                         ('fix con %s satélites' % g.get('sats') if g.get('fix') else
                          'sin fix todavía (%s satélites)' % g.get('sats'))))
    print('  paquetes: %s recibidos, %s transmitidos, %s errores CRC' % (st.get('rx'), st.get('txn'), st.get('crcerr')))
    return 0 if st.get('radio') == 'ok' else 1


def usb_de(tty):
    """(vid, pid) del USB del que cuelga /dev/ttyACMx, o ('', '')."""
    d = os.path.realpath('/sys/class/tty/%s/device' % os.path.basename(os.path.realpath(tty)))
    for _ in range(4):
        d = os.path.dirname(d)
        try:
            with open(os.path.join(d, 'idVendor')) as v, open(os.path.join(d, 'idProduct')) as p:
                return v.read().strip().lower(), p.read().strip().lower()
        except OSError:
            continue
    return '', ''


RUI3_AVISO = '''✘ El RAK lleva el firmware de fábrica RUI3 de RAKwireless (USB 1915:521f).
  Su bootloader no es el WisBlock/Adafruit que necesita este firmware: hay que convertirlo
  UNA vez (manual 35, «RAK con RUI3»): AT+BOOT -> nrfutil 6.1.7 «dfu usb-serial» con
  rak4631_factory_bootloader.zip -> adafruit-nrfutil con rak4631_factory_softdevice.zip
  -> y después otra vez: sudo bricohams-rak-aprs grabar'''


def gps(minutos=15):
    """Espera al fix del GPS (dentro de la caja tarda más o no llega): satélites cada 15 s."""
    cargar_env()
    with servicio_parado():
        ser = abrir(puerto())
        lector = LectorKISS()
        fin, t0 = time.time() + minutos * 60, time.time()
        g = {}
        while time.time() < fin:
            g = _estado_rak(ser, lector).get('gps') or {}
            print('  %3d s · %s · %s satélites%s' % (time.time() - t0, 'FIX' if g.get('fix') else 'sin fix',
                  g.get('sats', 0), (' · hdop %s · %s' % (g.get('hdop'), g.get('utc', ''))) if g.get('fix') else ''),
                  flush=True)
            if g.get('fix') or not g.get('present', True):
                break
            time.sleep(15)
        ser.close()
    if not g.get('present'):
        print('✘ No llegan frases NMEA: ¿hay un RAK1910/RAK12500 en el slot A? (RAK_GPS="no" si no lo usas)')
        return 1
    if g.get('fix'):
        print('✔ GPS con fix en %d s (%s satélites, hdop %s)' % (time.time() - t0, g.get('sats'), g.get('hdop')))
        return 0
    print('✘ Sin fix en %d min dentro de la caja. Pon la antena GPS (IPEX) junto a la tapa o fuera, o deja '
          'RAK_GPS_BALIZA="no": la baliza usa STATION_LAT/LON y el GPS solo da la hora.' % minutos)
    return 1


def info_uf2(texto):
    """Datos de INFO_UF2.TXT del bootloader de Adafruit/RAK: versión, modelo y placa."""
    d = {}
    for l in texto.splitlines():
        if l.startswith('UF2 Bootloader'):
            d['bootloader'] = l.split()[2] if len(l.split()) > 2 else l
        elif ':' in l:
            k, v = l.split(':', 1)
            d[k.strip().lower()] = v.strip()
    return d


def _unidad_uf2(segundos=20):
    fin = time.time() + segundos
    while time.time() < fin:
        for d in ('/dev/disk/by-label',):
            try:
                for n in os.listdir(d):
                    if n.upper().startswith(('RAK', 'NRF52', 'FTHR840')):
                        return os.path.realpath(os.path.join(d, n))
            except OSError:
                pass
        time.sleep(1)
    return None


def bootloader(grabar_uf2=True):
    """Lleva el RAK al modo UF2 (unidad de disco), lee la versión del bootloader y sale grabando el .uf2."""
    cargar_env()
    uf2 = os.path.join(FW_DIR, 'bin', 'bricohams-rak4631-lora-aprs.uf2')
    with servicio_parado():
        ser = abrir(puerto())
        orden(ser, 'BH:UF2')
        ser.close()
        print('RAK en modo UF2: esperando la unidad de disco…')
        dev = _unidad_uf2()
        if not dev:
            print('✘ No aparece la unidad: el bootloader no tiene UF2 (es antiguo). La grabación por USB '
                  '(DFU serie, «grabar») sigue valiendo; pulsa RESET para volver al firmware.')
            return 1
        mnt = '/run/bricohams-uf2'
        os.makedirs(mnt, exist_ok=True)
        if subprocess.call(['mount', dev, mnt]) != 0:
            print('✘ No pude montar %s' % dev)
            return 1
        try:
            info = info_uf2(open(os.path.join(mnt, 'INFO_UF2.TXT'), encoding='utf-8', errors='replace').read())
            print('✔ bootloader %s · modelo %s · placa %s' % (info.get('bootloader', '?'), info.get('model', '?'),
                                                            info.get('board-id', '?')))
            os.makedirs('/var/lib/bricohams', exist_ok=True)
            json.dump(info, open('/var/lib/bricohams/rak-bootloader.json', 'w'), ensure_ascii=False)
            if grabar_uf2 and os.path.exists(uf2):
                print('Grabando el firmware por UF2 para salir del modo disco…')
                subprocess.call(['cp', uf2, mnt + '/'])
                subprocess.call(['sync'])
        finally:
            subprocess.call(['umount', '-l', mnt], stderr=subprocess.DEVNULL)
        time.sleep(8)
    return 0


def puesta_en_marcha(minutos_gps=10):
    """Todo de una vez (manual 35, §3): grabar si hace falta, nombres, prueba, bootloader y GPS."""
    cargar_env()
    res = []

    def paso(nombre, codigo):
        res.append((nombre, codigo))
        print('%s %s' % ('✔' if codigo == 0 else '✘', nombre), flush=True)

    with servicio_parado():
        actual = None
        try:
            ser = abrir(puerto())
            orden(ser, 'BH:PING')
            actual = esperar_hw(ser, LectorKISS(), 'BH:PONG', 4)
            ser.close()
        except (SystemExit, OSError):
            pass
    nuevo = None
    try:
        nuevo = re.search(r'"version"\s*:\s*"([^"]+)"', open(os.path.join(FW_DIR, 'bin', 'VERSION.json')).read()).group(1)
    except (OSError, AttributeError):
        pass
    if not actual or (nuevo and nuevo not in actual):
        print('== 1. grabar el firmware (%s)' % ('no contesta' if not actual else 'hay uno más nuevo'))
        paso('firmware grabado', grabar())
    else:
        paso('firmware ya grabado (%s)' % actual, 0)
    print('== 2. nombres fijos')
    paso('/dev/rak-aprs y /dev/lilygo-mesh', subprocess.call(['bricohams-dispositivos', 'identificar']))
    time.sleep(3)
    print('== 3. prueba')
    paso('radio, configuración y sensor', prueba())
    print('== 4. bootloader')
    paso('versión del bootloader (UF2)', bootloader())
    print('== 5. GPS (hasta %d min)' % minutos_gps)
    paso('fix del GPS dentro de la caja', gps(minutos_gps))
    print('\nResumen:')
    for n, c in res:
        print('  %s %s' % ('✔' if c == 0 else '✘', n))
    try:
        os.makedirs('/var/lib/bricohams', exist_ok=True)
        open('/var/lib/bricohams/rak-puesta.txt', 'w').write(
            time.strftime('%F %T\n') + '\n'.join('%s %s' % ('OK' if c == 0 else 'FALLO', n) for n, c in res) + '\n')
    except OSError:
        pass
    return 0 if all(c == 0 for n, c in res[:3]) else 1


def grabar(zip_=None):
    zip_ = zip_ or os.path.join(FW_DIR, 'bin', 'bricohams-rak4631-lora-aprs.zip')
    if not os.path.exists(zip_):
        raise SystemExit('✘ No encuentro %s' % zip_)
    cargar_env()
    subprocess.call(['systemctl', 'stop', 'bricohams-rak-aprs'], stderr=subprocess.DEVNULL)
    p = env('RAK_PUERTO', '/dev/rak-aprs')
    if not os.path.exists(p):
        cands = sorted(x for x in os.listdir('/dev') if x.startswith('ttyACM'))
        rui3 = [c for c in cands if usb_de('/dev/' + c)[0] == '1915']
        if rui3:
            print(RUI3_AVISO)
            return 2
        if len(cands) != 1:
            raise SystemExit('✘ No sé qué puerto es el RAK (%s). Enchufa solo el RAK o identifícalo.' % cands)
        p = '/dev/' + cands[0]
    if usb_de(p)[0] == '1915':
        print(RUI3_AVISO)
        return 2
    print('Grabando %s en %s (DFU serie, ~40 s)…' % (os.path.basename(zip_), p))
    # adafruit-nrfutil sale con 0 aunque falle el DFU («No data received on serial port»):
    # solo vale si dice «Device programmed».
    pr = subprocess.Popen(['adafruit-nrfutil', '--verbose', 'dfu', 'serial', '--package', zip_, '-p', p,
                           '-b', '115200', '--singlebank', '--touch', '1200'],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors='replace')
    salida = []
    for linea in pr.stdout:
        sys.stdout.write(linea)
        salida.append(linea)
    r = pr.wait()
    if r == 0 and any('Device programmed' in x for x in salida):
        time.sleep(5)
        subprocess.call(['systemctl', 'start', 'bricohams-rak-aprs'], stderr=subprocess.DEVNULL)
        print('✔ Grabado. Comprueba: sudo bricohams-rak-aprs prueba')
        return 0
    print('✘ Falló. Alternativa: doble pulsación de RESET -> unidad RAK4631 -> copia el .uf2 (manual 35)')
    return r or 1


def main(argv):
    o = argv[1] if len(argv) > 1 else ''
    if o == 'servicio':
        return servicio()
    if o == 'prueba':
        return prueba()
    if o == 'estado':
        try:
            print(open(os.path.join(RUN_DIR, 'rak-aprs.json'), encoding='utf-8').read())
            return 0
        except OSError:
            print('Sin estado todavía (¿servicio parado? systemctl status bricohams-rak-aprs)')
            return 1
    if o == 'config':
        cargar_env()
        print(json.dumps(config_deseada(), indent=1, ensure_ascii=False))
        return 0
    if o == 'baliza':
        cargar_env()
        try:                                             # con el servicio en marcha, por su API
            import urllib.request
            urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:%s/baliza' % env('RAK_API_PUERTO', '8077'),
                                                          data=b'{}', method='POST'), timeout=3)
        except OSError:
            ser = abrir(puerto())
            orden(ser, 'BH:BEACON')
        print('Baliza pedida (sale en unos segundos).')
        return 0
    if o == 'gps':
        return gps(int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else 15)
    if o == 'bootloader':
        return bootloader()
    if o == 'puesta-en-marcha':
        return puesta_en_marcha(int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else 10)
    if o == 'grabar':
        return grabar(argv[2] if len(argv) > 2 else None)
    for linea in open(__file__, encoding='utf-8').read().splitlines()[2:26]:
        print(linea.lstrip('# '))
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
