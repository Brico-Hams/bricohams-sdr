#!/bin/bash
set -euo pipefail

limpiar_copias() {
    local directorio=$1 limite=$2 simular=$3 fichero fecha
    if [ -L "$directorio" ]; then
        echo "ERROR: el directorio de copias no puede ser un enlace: $directorio" >&2
        return 1
    fi
    if [ ! -e "$directorio" ]; then
        echo "Sin directorio de copias: $directorio"
        return 0
    fi
    [ -d "$directorio" ] || { echo "ERROR: no es un directorio: $directorio" >&2; return 1; }
    local lista
    lista=$(mktemp)
    if ! find "$directorio" -maxdepth 1 -type f \
        \( -name 'backup-openwebrx-????-??-??.tar.gz' -o -name 'perfil-owrx-????-??-??.owrx.tar.gz' \) \
        -print0 >"$lista"; then
        rm -- "$lista"
        echo "ERROR: no se pudieron enumerar las copias" >&2
        return 1
    fi
    while IFS= read -r -d '' fichero; do
        fecha=$(stat -c %Y -- "$fichero") || { rm -- "$lista"; return 1; }
        if [ "$fecha" -lt "$limite" ]; then
            if [ "$simular" = yes ]; then
                printf 'Borraria: %s\n' "$fichero"
            else
                rm -- "$fichero" || { rm -- "$lista"; return 1; }
                printf 'Eliminada: %s\n' "$fichero"
            fi
        fi
    done <"$lista"
    rm -- "$lista"
}

main() {
    local simular=no
    case "${1-}" in
        '') ;;
        --dry-run) simular=yes ;;
        *) echo "Uso: bricohams-backup-limpieza [--dry-run]" >&2; return 2 ;;
    esac
    [ "$#" -le 1 ] || { echo "ERROR: demasiados argumentos" >&2; return 2; }
    exec 9>/run/lock/bricohams-backup-limpieza.lock
    flock -n 9 || { echo "ERROR: ya hay una limpieza en marcha" >&2; return 1; }
    limpiar_copias /var/backups/bricohams "$(( $(date +%s) - 5 * 24 * 60 * 60 ))" "$simular"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
