#!/usr/bin/python3
# bricohams-login-aviso  ·  avisa por Telegram de cada inicio de sesión correcto en /settings.
#  Lee el registro de nginx /var/log/nginx/bricohams-sdr-login.access.log (formato bricohams_login):
#    $remote_addr - [$time_local] "$request" $status "$sent_http_location"
#  OpenWebRX+ contesta 303 a /login?… cuando falla y 303 a otra página cuando acierta.
#  El registro no lleva el usuario (no se puede saber sin tocar OpenWebRX+): se avisa con IP y hora.
#  Se activa con TG_AVISO_LOGIN=yes en bricohams.env; una IP no repite aviso en 10 minutos.
import ipaddress
import os
import re
import subprocess
import sys
import time

LOG = os.environ.get('BRICOHAMS_LOGIN_LOG', '/var/log/nginx/bricohams-sdr-login.access.log')
ENV = os.environ.get('BRICOHAMS_KIT_ENV', '/opt/bricohams/kit/bricohams.env')
TELEGRAM = os.environ.get('BRICOHAMS_TELEGRAM', '/usr/local/bin/bricohams-telegram')
PAUSA = 600
LINEA = re.compile(r'^(\S+) - \[([^\]]*)\] "POST /login(?:\?\S*)? HTTP/[^"]+" (\d{3}) "([^"]*)"\s*$')


def activo():
    try:
        with open(ENV, encoding='utf-8', errors='replace') as f:
            for linea in f:
                m = re.match(r'^\s*TG_AVISO_LOGIN\s*=\s*["\']?([^"\'#\s]*)', linea)
                if m:
                    return m.group(1).lower() in ('yes', 'si', 'sí', '1', 'true', 'on')
    except OSError:
        pass
    return False


def analizar(linea):
    """Devuelve (ip, hora, correcto) o None si no es un POST /login."""
    m = LINEA.match(linea.strip())
    if not m or m.group(3) != '303':
        return None
    try:
        ip = str(ipaddress.ip_address(m.group(1)))
    except ValueError:
        return None
    destino = m.group(4)
    correcto = not re.match(r'^(?:\.\./)*/?login(?:\?|$)', destino) and '/login?' not in destino
    return ip, m.group(2), correcto


def texto_aviso(ip, hora):
    try:
        privada = ipaddress.ip_address(ip).is_private
    except ValueError:
        privada = False
    return '🔐 Inicio de sesión en /settings · IP %s%s · %s' % (ip, ' (LAN)' if privada else '', hora)


class Avisador:
    def __init__(self, enviar=None, reloj=time.monotonic):
        self.ultimo = {}
        self.enviar = enviar or self._telegram
        self.reloj = reloj

    @staticmethod
    def _telegram(texto):
        try:
            r = subprocess.run([TELEGRAM, texto], capture_output=True, timeout=40, text=True)
        except (OSError, subprocess.SubprocessError) as ex:
            print('login-aviso: Telegram no enviado (%s).' % type(ex).__name__, file=sys.stderr, flush=True)
            return False
        if r.returncode:
            print('login-aviso: Telegram no enviado; revisa destino y permisos del bot.',
                  file=sys.stderr, flush=True)
            return False
        return True

    def linea(self, linea):
        r = analizar(linea)
        if not r or not r[2]:
            return False
        ip, hora, _ = r
        ahora = self.reloj()
        if ahora - self.ultimo.get(ip, -PAUSA - 1) < PAUSA:
            return False
        if self.enviar(texto_aviso(ip, hora)) is False:
            return False
        self.ultimo[ip] = ahora
        if len(self.ultimo) > 1000:
            self.ultimo = {k: v for k, v in self.ultimo.items() if ahora - v < PAUSA}
        return True


def seguir(avisador):
    f, ino, pos = None, None, 0
    comprobado, encendido = 0, False
    while True:
        if time.monotonic() - comprobado > 60:
            encendido, comprobado = activo(), time.monotonic()
        try:
            st = os.stat(LOG)
        except OSError:
            st = None
        if st is None:
            if f:
                f.close()
                f = None
            time.sleep(5)
            continue
        if f is None or st.st_ino != ino or st.st_size < pos:
            if f:
                f.close()
            primera = ino is None
            f = open(LOG, encoding='utf-8', errors='replace')
            ino = st.st_ino
            if primera:
                f.seek(0, os.SEEK_END)
            pos = f.tell()
        linea = f.readline()
        if not linea:
            time.sleep(1)
            continue
        if not linea.endswith('\n'):
            f.seek(pos)
            time.sleep(1)
            continue
        pos = f.tell()
        if encendido:
            avisador.linea(linea)


if __name__ == '__main__':
    try:
        seguir(Avisador())
    except KeyboardInterrupt:
        sys.exit(0)
