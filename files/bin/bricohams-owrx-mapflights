#!/usr/bin/env python3
"""Añade la sección map.flights (selector y API key) a General Settings de OpenWebRX+.

La clave «mapflights_api_key» es opcional: sin ella se usa el acceso anónimo
de map.flights (límites más bajos). Solo la lee bricohams-api en el servidor
y la envía en la cabecera x-api-key; nunca llega al navegador del mapa.
"""
import os
import re
import sys

MARCA = '#@BH-MAPFLIGHTS@'
LINEAS = [
    'Section(',
    '    "map.flights",',
    '    CheckboxInput(',
    '        "mapflights_api_enabled",',
    '        "Use map.flights for aircraft details",',
    '        infotext="Route, destination and photo of the aircraft shown on the map come from the "',
    '        + "map.flights API (Powered by MAP.FLIGHTS).",',
    '    ),',
    '    PasswordInput(',
    '        "mapflights_api_key",',
    '        "map.flights API key",',
    '        infotext="Optional private beta key from map.flights (sent only from the server in the "',
    '        + "x-api-key header). Leave it empty to use anonymous access with lower limits. "',
    '        + \'Request it at <a href="https://map.flights/developers" target="_blank">\'',
    '        + "map.flights/developers</a>.",',
    '    ),',
    '),',
]
ANCLA = re.compile(r'^([ \t]*)Section\(\s*\n[ \t]*"Map settings",', re.M)
NATIVO = re.compile(r'^[ \t]*"mapflights_api_enabled",', re.M)


def ruta():
    if os.environ.get('OWRX_GENERAL_PY'):
        return os.environ['OWRX_GENERAL_PY']
    try:
        m = __import__('owrx')
        base = os.path.dirname(m.__file__) if getattr(m, '__file__', None) else list(m.__path__)[0]
    except (ImportError, AttributeError, IndexError):
        base = '/usr/lib/python3/dist-packages/owrx'
    return os.path.join(base, 'controllers', 'settings', 'general.py')


def quitar(texto):
    return ''.join(linea for linea in texto.splitlines(True) if MARCA not in linea)


def poner(texto):
    limpio = quitar(texto)
    if NATIVO.search(limpio):
        return limpio
    for clase in ('CheckboxInput', 'PasswordInput'):
        if not re.search(r'^\s*%s,\s*$' % clase, limpio, re.M) and not re.search(
                r'^from owrx\.form\.input import [^\n]*\b%s\b' % clase, limpio, re.M):
            raise ValueError('general.py no importa %s' % clase)
    ancla = ANCLA.search(limpio)
    if not ancla:
        raise ValueError('controlador settings/general.py irreconocible')
    sangria = ancla.group(1)
    nuevo = ''.join('%s%s  %s\n' % (sangria, linea, MARCA) for linea in LINEAS)
    return limpio[:ancla.start()] + nuevo + limpio[ancla.start():]


def escribir(ruta_archivo, original, nuevo):
    if nuevo == original:
        return False
    temporal = ruta_archivo + '.bricohams-tmp'
    with open(temporal, 'w', encoding='utf-8', newline='') as f:
        f.write(nuevo)
    os.chmod(temporal, os.stat(ruta_archivo).st_mode & 0o777)
    os.replace(temporal, ruta_archivo)
    return True


def main(argumentos):
    callado = '-q' in argumentos
    sacar = '--quitar' in argumentos
    archivo = ruta()
    try:
        original = open(archivo, encoding='utf-8', newline='').read()
        nuevo = quitar(original) if sacar else poner(original)
        compile(nuevo, archivo, 'exec')
        cambiado = escribir(archivo, original, nuevo)
    except (OSError, ValueError, SyntaxError) as error:
        if not callado:
            print('%s: %s' % (archivo, error), file=sys.stderr)
        return 0 if callado else 1
    if not callado:
        print('%s: %s%s' % (archivo, 'parche quitado' if sacar else 'parche aplicado',
                            '' if cambiado else ' (sin cambios)'))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
