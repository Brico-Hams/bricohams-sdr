#!/bin/bash
# =====================================================================
#  bricohams-sdr-serials · BricoHams
#  Graba en la EEPROM de cada RTL-SDR el número de serie que esperan
#  OpenWebRX y readsb, para que cada uno coja siempre su SDR:
#     HAT HackerGadgets (R860)        -> SERIAL_HAT  (SATÉLITES)
#     Mini RTL-SDR (R860)             -> SERIAL_MINI (RADIOAFICIONADOS)
#     RTL-SDR Blog V3 (R820T2)        -> SERIAL_V3   (MULTIPERFIL + HF)
#     FlightStick RadarBox (R820T2)   -> SERIAL_ADSB (ADS-B, readsb)
#  Los cuatro usan la misma familia de sintonizador y no se distinguen
#  solos, así que el script te pide conectarlos de uno en uno.
#  Uso: sudo bricohams-sdr-serials        (ver)
#       sudo bricohams-sdr-serials --grabar
# =====================================================================
set -u
ENV=/etc/bricohams/bricohams.env
# shellcheck source=/dev/null
[ -r "$ENV" ] && . "$ENV"
SERIAL_HAT=${SERIAL_HAT:-00000101}
SERIAL_MINI=${SERIAL_MINI:-00000102}
SERIAL_V3=${SERIAL_V3:-00000103}
SERIAL_ADSB=${SERIAL_ADSB:-00001090}

[ "$(id -u)" -eq 0 ] || { echo "Ejecútalo con sudo."; exit 1; }
command -v rtl_eeprom >/dev/null || { echo "Falta rtl_eeprom (paquete rtl-sdr)."; exit 1; }

# índice|serie de cada RTL-SDR conectado (la serie se lee de la EEPROM)
listar() {
    local n i sn
    n=$(rtl_test -t 2>&1 | sed -n 's/^Found \([0-9]\+\) device(s).*/\1/p')
    for ((i = 0; i < ${n:-0}; i++)); do
        sn=$(timeout 6 rtl_eeprom -d "$i" 2>&1 | sed -n 's/^Serial number:[[:space:]]*//p' | head -1)
        echo "$i|${sn:-?}"
    done
}

grabar() {  # índice serie
    echo "  -> grabando la serie $2 en el dispositivo $1"
    yes y | rtl_eeprom -d "$1" -s "$2" >/dev/null 2>&1 || { echo "  ✘ falló rtl_eeprom en el dispositivo $1"; exit 1; }
}

mostrar() {
    echo "RTL-SDR conectados (índice | serie en EEPROM):"
    listar | sed 's/^/   /'
    echo "Esperados: HAT=$SERIAL_HAT  MINI=$SERIAL_MINI  V3=$SERIAL_V3  ADS-B=$SERIAL_ADSB"
}

if [ "${1:-}" != "--grabar" ]; then
    mostrar
    echo; echo "Para grabar las series: sudo $0 --grabar"
    exit 0
fi

actuales=$(listar | cut -d'|' -f2 | sort | tr '\n' ' ')
esperadas=$(printf '%s\n' "$SERIAL_HAT" "$SERIAL_MINI" "$SERIAL_V3" "$SERIAL_ADSB" | sort | tr '\n' ' ')
if [ "$actuales" = "$esperadas" ]; then
    mostrar; echo; echo "Las cuatro series ya están bien. No hay nada que grabar."; exit 0
fi

echo "Paro OpenWebRX y readsb para liberar los SDR…"
systemctl stop openwebrx readsb 2>/dev/null
# v4.3 · OpenWebRX+ en Docker
if [ "$(. /etc/bricohams/bricohams.env 2>/dev/null; echo "${OWRX_BACKEND:-native}")" = docker ]; then
    docker stop "$(. /etc/bricohams/bricohams.env 2>/dev/null; echo "${OWRX_DOCKER_CONTAINER:-owrx-mbe}")" >/dev/null 2>&1 || true
fi
sleep 2

asignadas=" "
paso=1
for par in "HAT:$SERIAL_HAT:el RTL-SDR del HAT (su USB a la Raspberry)" \
           "MINI:$SERIAL_MINI:el Mini RTL-SDR (USB-C)" \
           "V3:$SERIAL_V3:el RTL-SDR Blog V3" \
           "ADSB:$SERIAL_ADSB:el FlightStick de RadarBox"; do
    IFS=: read -r _ serie texto <<<"$par"
    echo
    if [ "$paso" -eq 1 ]; then
        echo "Paso 1/4: deja conectado SOLO $texto. Desenchufa los otros tres."
    else
        echo "Paso $paso/4: enchufa ahora $texto (deja puestos los anteriores)."
    fi
    read -r -p "Pulsa Intro cuando esté listo… " _
    sleep 3
    lista=$(listar)
    cuantos=$(printf '%s\n' "$lista" | grep -c '|' || true)
    [ "$cuantos" -eq "$paso" ] || { echo "✘ Hay $cuantos RTL-SDR conectados y debería haber $paso."; exit 1; }
    # el recién conectado es el único cuya serie aún no se ha asignado
    nuevos=$(printf '%s\n' "$lista" | while IFS='|' read -r i sn; do
        case "$asignadas" in *" $sn "*) ;; *) echo "$i|$sn" ;; esac
    done)
    [ "$(printf '%s\n' "$nuevos" | grep -c '|' || true)" -eq 1 ] || { echo "✘ No sé cuál es el nuevo: ${nuevos//$'\n'/, }"; exit 1; }
    idx=${nuevos%%|*}; sn=${nuevos#*|}
    if [ "$sn" = "$serie" ]; then echo "  ✔ ya tenía la serie $serie"; else grabar "$idx" "$serie"; fi
    asignadas="$asignadas$serie "
    paso=$((paso + 1))
done

echo
echo "Hecho. Las series nuevas se leen al volver a enchufar: reinicia (sudo reboot)"
echo "o desenchufa y enchufa los dongles, y luego: sudo systemctl start openwebrx readsb"
echo "(con OpenWebRX+ en Docker: sudo docker start owrx-mbe, o el nombre de OWRX_DOCKER_CONTAINER)"
