#!/usr/bin/env python3
"""Impide borrar desde Files; no cambia descargas ni la retencion de Storage."""
import ast
import os
from pathlib import Path
import sys

MARCA = '# bricohams-files-solo-lectura'


def proteger(texto):
    tree = ast.parse(texto)
    clases = [n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'FilesController']
    if len(clases) != 1:
        raise ValueError('No se identifica FilesController')
    clase = clases[0]
    borrar = [n for n in clase.body if isinstance(n, ast.FunctionDef) and n.name == 'delete']
    plantilla = [n for n in clase.body if isinstance(n, ast.FunctionDef) and n.name == 'template_variables']
    if len(borrar) != 1 or len(plantilla) != 1:
        raise ValueError('Controlador Files incompatible')
    admins = [n for n in ast.walk(plantilla[0]) if isinstance(n, ast.Assign)
              and any(isinstance(t, ast.Name) and t.id == 'admin' for t in n.targets)]
    if len(admins) != 1:
        raise ValueError('No se identifica control de botones Files')
    lineas = texto.splitlines(keepends=True)
    cambios = [
        (admins[0].lineno - 1, admins[0].end_lineno,
         '        admin = False  ' + MARCA + '\n'),
        (borrar[0].lineno - 1, borrar[0].end_lineno,
         '    def delete(self):  ' + MARCA + '\n'
         '        self.send_response(\'{"error":"Borrado manual deshabilitado"}\',\n'
         '                           content_type="application/json", code=403)\n'),
    ]
    for inicio, fin, nuevo in sorted(cambios, reverse=True):
        lineas[inicio:fin] = [nuevo]
    resultado = ''.join(lineas)
    ast.parse(resultado)
    return resultado


def main():
    ruta = Path(os.environ.get('OWRX_FILES_CONTROLLER', '/usr/lib/python3/dist-packages/owrx/controllers/file.py'))
    try:
        if ruta.is_symlink():
            raise ValueError('El controlador no puede ser un enlace')
        texto = ruta.read_text(encoding='utf-8')
        nuevo = proteger(texto)
        if texto != nuevo:
            temporal = ruta.with_name(ruta.name + '.bricohams-tmp')
            try:
                temporal.write_text(nuevo, encoding='utf-8')
                os.chmod(temporal, ruta.stat().st_mode & 0o777)
                os.replace(temporal, ruta)
            finally:
                if temporal.exists():
                    temporal.unlink()
        print('Files: borrado web bloqueado; descargas y limpieza automatica conservadas.')
        return 0
    except (OSError, ValueError, SyntaxError) as x:
        print('No se pudo proteger Files: %s' % x, file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
