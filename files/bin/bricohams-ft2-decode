#!/usr/bin/env python3
# =====================================================================
#  bricohams-ft2-decode · BricoHams  (v4, experimental)
#  Decodifica un trozo WAV de 3,75 s (12 kHz, 16 bits, mono) en modo FT2 con
#  «decodium-rx» (Decodium 4.0 Core Shannon, IU8LMC, GPLv3) y escribe cada
#  mensaje en el MISMO formato que «jt9», para que OpenWebRX+ lo lea con su
#  analizador de FT8/FT4 sin cambios:
#     decodium-rx:  "  12:00:15.00   -9  0.1  1234  CQ N0CALL IM98"
#     salida:       "120015  -9  0.1 1234 ~  CQ N0CALL IM98"
#  Uso (lo llama OpenWebRX+ con el modo FT2):
#     bricohams-ft2-decode [-d N] [-t SEGUNDOS] fichero.wav
#  Ajustes (variable de entorno o /etc/bricohams/ft2.conf, formato CLAVE=valor):
#     FT2_CALL     indicativo de la estación (decodificación AP: --call)
#     FT2_LOW_HZ   audio mínimo, por defecto 200
#     FT2_HIGH_HZ  audio máximo, por defecto 5000 (como OpenWebRX+)
#     FT2_TIMEOUT  segundos máximos por trozo, por defecto 3.5 (< 3,75 s del ciclo)
#  Nunca se apilan procesos: si el trozo anterior sigue decodificándose, este
#  se salta y se anota en el log (FT2_LOG, por defecto /var/log/bricohams-ft2.log).
# =====================================================================
import os
import re
import signal
import subprocess
import sys
import tempfile
import time

try:
    import fcntl
except ImportError:  # sin fcntl (no es la Pi): no hay cerrojo
    fcntl = None

# Reloj HHMMSS, HH:MM:SS o HH:MM:SS.cc (también con coma o con "Z" detrás), SNR, DT, frecuencia y mensaje
LINEA = re.compile(
    r'^\s*(\d{2}):?(\d{2}):?(\d{2})(?:[.,]\d+)?Z?\s+'
    r'([+-]?\d+)\s+([+-]?\d+(?:[.,]\d+)?)\s+(\d+(?:[.,]\d+)?)\s+(\S.*?)\s*$')
ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
NOMBRE_TS = re.compile(r'(\d{6})_(\d{6})\.wav$')
CALL_OK = re.compile(r'^[A-Z0-9]{1,4}[0-9][A-Z0-9]{0,4}(?:/[A-Z0-9]{1,4})?$')
BIN = os.environ.get('DECODIUM_RX', 'decodium-rx')
CONF = os.environ.get('FT2_CONF', '/etc/bricohams/ft2.conf')
LOG = os.environ.get('FT2_LOG', '/var/log/bricohams-ft2.log')
CERROJO = os.path.join(tempfile.gettempdir(), 'bricohams-ft2.lock')
PERIODO = 3.75


def leer_conf(ruta=None):
    out = {}
    try:
        with open(ruta or CONF, encoding='utf-8') as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith('#') or '=' not in ln:
                    continue
                k, v = ln.split('=', 1)
                out[k.strip()] = v.split('#', 1)[0].strip().strip('"\'')
    except OSError:
        pass
    return out


def ajuste(conf, clave, defecto):
    return os.environ.get(clave) or conf.get(clave) or defecto


def numero(txt, defecto, minimo, maximo):
    try:
        v = float(txt)
    except (TypeError, ValueError):
        return defecto
    return min(max(v, minimo), maximo)


def registrar(msg):
    linea = '%s ft2: %s' % (time.strftime('%F %T'), msg)
    print(linea, file=sys.stderr)
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 1000000:
            os.truncate(LOG, 0)
        with open(LOG, 'a', encoding='utf-8') as f:
            f.write(linea + '\n')
    except OSError:
        pass


def convertir(linea, hhmmss_fichero=''):
    m = LINEA.match(ANSI.sub('', linea))
    if not m:
        return None
    hh, mi, ss, snr, dt, hz, msg = m.groups()
    ts = hh + mi + ss
    if ts == '000000' and hhmmss_fichero:
        ts = hhmmss_fichero
    return '%s %3d %4.1f %4d ~  %s' % (ts, int(snr), float(dt.replace(',', '.')),
                                      int(float(hz.replace(',', '.'))), msg)


def comando(wav, prof, conf):
    cmd = [BIN, '-m', 'ft2', '--wav', '--no-log', '--no-color', '--depth', str(prof)]
    call = ajuste(conf, 'FT2_CALL', '').strip().upper()
    if call and call != 'N0CALL' and CALL_OK.match(call):
        cmd += ['--call', call]
    low = int(numero(ajuste(conf, 'FT2_LOW_HZ', '200'), 200, 0, 20000))
    high = int(numero(ajuste(conf, 'FT2_HIGH_HZ', '5000'), 5000, 0, 20000))
    if high > low:
        cmd += ['--low', str(low), '--high', str(high)]
    return cmd + [wav]


def ejecutar(cmd, limite):
    # Proceso propio en su grupo: al vencer el plazo se mata con todos sus hijos
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                         start_new_session=(os.name == 'posix'))
    try:
        out, _ = p.communicate(timeout=limite)
        return out, False
    except subprocess.TimeoutExpired:
        try:
            if os.name == 'posix':
                os.killpg(p.pid, signal.SIGKILL)
            else:
                p.kill()
        except OSError:
            pass
        p.communicate()
        return '', True


def main(argv):
    prof = '3'
    args = argv[1:]
    conf = leer_conf()
    limite = numero(ajuste(conf, 'FT2_TIMEOUT', '3.5'), 3.5, 0.5, PERIODO - 0.05)
    while len(args) >= 2 and args[0] in ('-d', '-t'):
        if args[0] == '-d':
            prof = args[1]
        else:
            limite = numero(args[1], limite, 0.5, 600)  # -t sin tope: lo usan «probar» y las pruebas
        args = args[2:]
    if not args:
        print('uso: bricohams-ft2-decode [-d 1-3] [-t segundos] fichero.wav', file=sys.stderr)
        return 2
    wav = args[0]
    m = NOMBRE_TS.search(os.path.basename(wav))
    hhmmss = m.group(2) if m else ''
    lock = None
    if fcntl:
        try:
            lock = open(CERROJO, 'a')
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            registrar('trozo %s saltado: el anterior sigue decodificándose' % (hhmmss or os.path.basename(wav)))
            return 0
        except OSError:
            lock = None
    try:
        try:
            out, vencido = ejecutar(comando(wav, prof, conf), limite)
        except OSError as e:
            print('ft2: %s' % e, file=sys.stderr)
            return 1
        if vencido:
            registrar('trozo %s saltado: la decodificación pasó de %.1f s y se mató'
                      % (hhmmss or os.path.basename(wav), limite))
            return 0
        for ln in out.splitlines():
            res = convertir(ln, hhmmss)
            if res:
                print(res, flush=True)
        return 0
    finally:
        if lock:
            lock.close()


if __name__ == '__main__':
    sys.exit(main(sys.argv))
