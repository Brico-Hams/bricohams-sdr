#!/usr/bin/env python3
# =====================================================================
#  bricohams-owrx-repeaterbook · campo «RepeaterBook API key» en
#  Ajustes generales (/settings/general)
#
#  OpenWebRX+ ya guarda y usa la clave «repeaterbook_api_key» (está en
#  owrx/config/defaults.py y owrx/web/repeaters.py la envía como
#  «Authorization: Bearer …» junto con el e-mail de «Receiver admin» en
#  el User-Agent), pero el campo del formulario viene comentado. Este
#  parche añade una sección «RepeaterBook» en Ajustes generales, que solo
#  es accesible con la contraseña de administrador; la página principal
#  no cambia y la clave nunca se publica.
#
#  Parche idempotente y reversible: líneas marcadas con  #@BH-RB@  en
#  owrx/controllers/settings/general.py, justo antes de la sección
#  «Map settings». Si una versión futura de OpenWebRX+ trae el campo
#  activo, el parche no hace nada para no duplicarlo.
#
#  Un «apt upgrade» de openwebrx reescribe el fichero: el gancho
#  /etc/apt/apt.conf.d/99bricohams-owrx-repeaterbook lo vuelve a aplicar.
#
#  Uso: bricohams-owrx-repeaterbook [-q]      aplica el parche
#       bricohams-owrx-repeaterbook --quitar  deja el fichero original
# =====================================================================
import os
import re
import sys

MARCA = '#@BH-RB@'

LINEAS = [
    'Section(',
    '    "RepeaterBook",',
    '    PasswordInput(',
    '        "repeaterbook_api_key",',
    '        "RepeaterBook API key",',
    '        infotext="Token personal de la API de RepeaterBook.com; se usa para los "',
    '        + "bookmarks automáticos de repetidores y para importar repetidores "',
    '        + "desde Ajustes. Solicítalo en "',
    '        + \'<a href="https://www.repeaterbook.com/api/token_request.php" target="_blank">\'',
    '        + "repeaterbook.com/api/token_request.php</a>. RepeaterBook exige "',
    '        + "además un e-mail de contacto: rellena «Receiver admin» arriba. "',
    '        + "Déjalo vacío para usar el acceso anónimo de OpenWebRX+.",',
    '    ),',
    '),',
]

ANCLA = re.compile(r'^([ \t]*)Section\(\s*\n[ \t]*"Map settings",', re.M)
NATIVO = re.compile(r'^[ \t]*"repeaterbook_api_key",', re.M)


def ruta():
    if os.environ.get('OWRX_GENERAL_PY'):
        return os.environ['OWRX_GENERAL_PY']
    try:
        m = __import__('owrx')
        base = os.path.dirname(m.__file__) if getattr(m, '__file__', None) else list(m.__path__)[0]
    except (ImportError, AttributeError, IndexError):
        base = '/usr/lib/python3/dist-packages/owrx'
    return os.path.join(base, 'controllers', 'settings', 'general.py')


def quitar(t):
    return ''.join(l for l in t.splitlines(True) if MARCA not in l)


def poner(t):
    limpio = quitar(t)
    if NATIVO.search(limpio):
        return limpio  # el campo ya viene activo en OpenWebRX+
    if not re.search(r'^\s*PasswordInput,\s*$', limpio, re.M) and 'import PasswordInput' not in limpio:
        raise ValueError('general.py no importa PasswordInput')
    m = ANCLA.search(limpio)
    if not m:
        raise ValueError('controlador settings/general.py irreconocible')
    sangria = m.group(1)
    nuevo = ''.join('%s%s  %s\n' % (sangria, l, MARCA) for l in LINEAS)
    return limpio[:m.start()] + nuevo + limpio[m.start():]


def escribir(r, original, nuevo):
    if nuevo == original:
        return False
    tmp = r + '.bricohams-tmp'
    with open(tmp, 'w', encoding='utf-8', newline='') as f:
        f.write(nuevo)
    os.chmod(tmp, os.stat(r).st_mode & 0o777)
    os.replace(tmp, r)
    return True


def main(a):
    callado = '-q' in a
    sacar = '--quitar' in a
    r = ruta()
    try:
        original = open(r, encoding='utf-8', newline='').read()
        nuevo = quitar(original) if sacar else poner(original)
        compile(nuevo, r, 'exec')
        cambiado = escribir(r, original, nuevo)
    except (OSError, ValueError, SyntaxError) as x:
        if not callado:
            print('%s: %s' % (r, x), file=sys.stderr)
        return 0 if callado else 1
    if not callado:
        print('%s: %s%s' % (r, 'parche quitado' if sacar else 'parche aplicado',
                            '' if cambiado else ' (sin cambios)'))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))