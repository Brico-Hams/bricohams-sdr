#!/usr/bin/env python3
# =====================================================================
#  bricohams-backup-remoto · copia de la configuración fuera de la estación
#
#  Lo lanza systemd (bricohams-backup-remoto@<orden>.service, como root) desde
#  el panel /settings/bricohams/seguridad o desde su temporizador diario.
#  Destinos: SMB/CIFS (montaje), NFS (montaje), SFTP (rclone, clave del
#  servidor fijada con «huella» + «confirmar»), Google Drive y OneDrive
#  (rclone con el token de «rclone authorize»).
#
#  Ficheros:
#    /etc/bricohams/backup-remoto.json     configuración sin secretos (panel)
#    /etc/bricohams/backup-remoto.secret   contraseña / token (root, 600)
#    /var/lib/bricohams-backup-remoto/     estado.json, known_hosts, rclone.conf
#  Nunca escribe contraseñas ni tokens en la salida (va al journal).
#
#  Uso: bricohams-backup-remoto probar|copiar|verificar|huella|confirmar|estado
# =====================================================================
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile

CONF = os.environ.get('BACKUP_REMOTO_CONF', '/etc/bricohams/backup-remoto.json')
SECRETO = os.environ.get('BACKUP_REMOTO_SECRET', '/etc/bricohams/backup-remoto.secret')
DATOS = os.environ.get('BACKUP_REMOTO_DIR', '/var/lib/bricohams-backup-remoto')
RUN = os.environ.get('BACKUP_REMOTO_RUN', '/run/bricohams-backup-remoto')
BACKUP_LOCAL = os.environ.get('BACKUP_LOCAL_CMD', '/usr/local/sbin/bricohams-backup')
ESTADO = os.path.join(DATOS, 'estado.json')
KNOWN = os.path.join(DATOS, 'known_hosts')
KNOWN_PEND = os.path.join(DATOS, 'known_hosts.pendiente')
RCLONE_CONF = os.path.join(DATOS, 'rclone.conf')
PROTOCOLOS = ('cifs', 'nfs', 'sftp', 'gdrive', 'onedrive')
NOMBRE = re.compile(r'^bricohams-backup-\d{8}-\d{6}\.tar\.gz$')
# fuera de la copia remota salvo «incluir_secretos»: claves de la estación
SECRETOS_TAR = (re.compile(r'^etc/bricohams/(.*\.env|backup-remoto.*|tak-access\.txt)$'),
                re.compile(r'(^|/)[^/]*\.env$'),
                re.compile(r'^etc/letsencrypt/(keys/|archive/[^/]+/privkey|live/[^/]+/privkey)'))
ORDENES = ('probar', 'copiar', 'verificar', 'huella', 'confirmar', 'estado')


class Fallo(Exception):
    pass


def tapar(s):
    s = re.sub(r'(?i)("?(?:access_token|refresh_token|token|pass(?:word)?|secret)"?\s*[:=]\s*)("[^"]*"|\S+)', r'\1…', s or '')
    return re.sub(r'eyJ[A-Za-z0-9_.-]{20,}', '…', s)


def log(msg):
    print(tapar(msg), flush=True)


def ahora():
    return datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')


def leer_json(ruta, defecto=None):
    try:
        with open(ruta, encoding='utf-8') as f:
            d = json.load(f)
        return d if isinstance(d, dict) else (defecto or {})
    except (OSError, ValueError):
        return dict(defecto or {})


def escribir_json(ruta, datos, modo=0o600):
    os.makedirs(os.path.dirname(ruta), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(ruta), prefix='.tmp-')
    try:
        os.fchmod(fd, modo)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(datos, f, ensure_ascii=False, indent=1)
        os.replace(tmp, ruta)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def anotar(orden, ok, mensaje, **extra):
    e = leer_json(ESTADO)
    e[orden] = {'fecha': ahora(), 'ok': ok if ok is None else bool(ok), 'mensaje': tapar(str(mensaje))[:500]}
    e.update(extra)
    escribir_json(ESTADO, e, 0o644)


def ejecutar(cmd, entrada=None, timeout=600, env=None):
    r = subprocess.run(cmd, input=entrada, capture_output=True, text=True, timeout=timeout,
                       env=env or os.environ.copy())
    if r.returncode:
        raise Fallo('%s: %s' % (os.path.basename(cmd[0]), tapar((r.stderr or r.stdout).strip())[-400:] or 'código %d' % r.returncode))
    return r.stdout


# ---------------------------------------------------------------- configuración
def cargar():
    c = leer_json(CONF)
    s = leer_json(SECRETO)
    p = c.get('protocolo', '')
    if p not in PROTOCOLOS:
        raise Fallo('backup remoto sin configurar (elige el protocolo en /settings/bricohams/seguridad)')
    c['retencion'] = max(1, min(365, int(c.get('retencion') or 14)))
    return c, s


def ruta_limpia(r):
    partes = [x for x in re.split(r'[/\\]+', r or '') if x]
    if any(x in ('.', '..') or re.search(r'[\x00-\x1f]', x) for x in partes):
        raise Fallo('ruta remota no válida')
    return '/'.join(partes)


def unc(destino):
    """\\\\servidor\\recurso\\sub o //servidor/recurso/sub -> ('//servidor/recurso', 'sub')."""
    partes = [x for x in re.split(r'[/\\]+', destino or '') if x]
    if len(partes) < 2 or not re.match(r'^[A-Za-z0-9.-]{1,253}$', partes[0]):
        raise Fallo('destino SMB no válido (ejemplo: \\\\192.168.1.10\\recurso\\carpeta)')
    return '//%s/%s' % (partes[0], partes[1]), ruta_limpia('/'.join(partes[2:]))


# ---------------------------------------------------------------- destinos montados
class Montado:
    """CIFS/NFS: monta en /run, trabaja con ficheros normales y desmonta siempre."""

    def __init__(self, c, s):
        self.c, self.s = c, s
        self.mnt = os.path.join(RUN, 'mnt')
        self.cred = os.path.join(RUN, 'cifs.cred')
        self.sub = ''

    def __enter__(self):
        os.makedirs(self.mnt, mode=0o700, exist_ok=True)
        if os.path.ismount(self.mnt):
            subprocess.run(['umount', '-l', self.mnt], capture_output=True)
        base = ['nosuid', 'nodev', 'noexec']
        if self.c['protocolo'] == 'cifs':
            origen, self.sub = unc(self.c.get('destino', ''))
            usuario = self.c.get('usuario', '')
            if not usuario:
                raise Fallo('falta el usuario de SMB')
            clave = self.s.get('password', '')
            if '\n' in clave or '\n' in usuario:
                raise Fallo('usuario o contraseña no válidos')
            fd = os.open(self.cred, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w') as f:
                f.write('username=%s\npassword=%s\n' % (usuario, clave))
                if self.c.get('dominio'):
                    f.write('domain=%s\n' % self.c['dominio'])
            vers = self.c.get('smb_version') or '3.0'
            if vers not in ('2.1', '3.0', '3.1.1'):
                raise Fallo('versión SMB no válida')
            opts = base + ['credentials=' + self.cred, 'vers=' + vers, 'uid=0', 'gid=0',
                           'file_mode=0600', 'dir_mode=0700', 'iocharset=utf8', 'echo_interval=10']
            cmd = ['mount', '-t', 'cifs', origen, self.mnt, '-o', ','.join(opts)]
        else:
            d = self.c.get('destino', '')
            m = re.match(r'^([A-Za-z0-9.-]{1,253}|\[[0-9A-Fa-f:]+\]):(/[^\x00-\x1f]*)$', d)
            if not m:
                raise Fallo('destino NFS no válido (ejemplo: 192.168.1.10:/exportado/carpeta)')
            vers = self.c.get('nfs_version') or '4'
            if vers not in ('3', '4', '4.1', '4.2'):
                raise Fallo('versión NFS no válida')
            opts = base + ['vers=' + vers, 'soft', 'timeo=150', 'retrans=2']
            cmd = ['mount', '-t', 'nfs', '%s:%s' % (m.group(1), m.group(2)), self.mnt, '-o', ','.join(opts)]
        try:
            ejecutar(cmd, timeout=60)
        finally:
            with contextlib.suppress(OSError):
                os.unlink(self.cred)
        self.dir = os.path.join(self.mnt, self.sub) if self.sub else self.mnt
        os.makedirs(self.dir, exist_ok=True)
        return self

    def __exit__(self, *a):
        r = subprocess.run(['umount', self.mnt], capture_output=True)
        if r.returncode:
            subprocess.run(['umount', '-l', self.mnt], capture_output=True)

    def listar(self):
        return sorted(n for n in os.listdir(self.dir) if NOMBRE.match(n))

    def subir(self, local, nombre):
        tmp = os.path.join(self.dir, '.' + nombre + '.parcial')
        shutil.copyfile(local, tmp)
        os.replace(tmp, os.path.join(self.dir, nombre))

    def leer(self, nombre):
        with open(os.path.join(self.dir, nombre), 'rb') as f:
            yield from iter(lambda: f.read(1 << 20), b'')

    def borrar(self, nombre):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(os.path.join(self.dir, nombre))

    def escribir_prueba(self):
        p = os.path.join(self.dir, '.bricohams-prueba')
        with open(p, 'w') as f:
            f.write(ahora())
        os.unlink(p)


# ---------------------------------------------------------------- destinos rclone
class Rclone:
    """SFTP, Google Drive y OneDrive. Las claves van en un rclone.conf de root (600)."""

    def __init__(self, c, s):
        self.c, self.s = c, s

    def __enter__(self):
        if not shutil.which('rclone'):
            raise Fallo('falta rclone (sudo apt install rclone)')
        p = self.c['protocolo']
        sec = {}
        if p == 'sftp':
            host = self.c.get('servidor', '')
            if not re.match(r'^([A-Za-z0-9.-]{1,253}|[0-9A-Fa-f:]{2,39})$', host):
                raise Fallo('servidor SFTP no válido')
            if not self.c.get('usuario'):
                raise Fallo('falta el usuario de SFTP')
            if not os.path.isfile(KNOWN) or os.path.getsize(KNOWN) == 0:
                raise Fallo('clave del servidor sin confirmar: pulsa «Leer huella» y después «Confirmar huella»')
            sec = {'type': 'sftp', 'host': host, 'user': self.c['usuario'],
                   'port': str(int(self.c.get('puerto') or 22)), 'known_hosts_file': KNOWN,
                   'shell_type': 'unix', 'md5sum_command': 'none', 'sha1sum_command': 'none'}
            if self.s.get('password'):
                sec['pass'] = ejecutar(['rclone', 'obscure', '-'], entrada=self.s['password'], timeout=30).strip()
            huella = hashlib.sha256(json.dumps(sec, sort_keys=True).encode()).hexdigest()
            self.escribir_conf(sec, huella, siempre=True)
        else:
            token = self.s.get('token', '')
            if not token:
                raise Fallo('falta el token de %s (rclone authorize)' % ('Google Drive' if p == 'gdrive' else 'OneDrive'))
            if p == 'gdrive':
                sec = {'type': 'drive', 'scope': 'drive', 'token': token}
            else:
                if not self.c.get('drive_id'):
                    raise Fallo('falta el drive_id de OneDrive')
                sec = {'type': 'onedrive', 'token': token, 'drive_id': self.c['drive_id'],
                       'drive_type': self.c.get('drive_type') or 'personal'}
            # rclone renueva el token y lo guarda en el propio fichero: solo se
            # reescribe cuando el administrador pega uno nuevo
            huella = hashlib.sha256(json.dumps(sec, sort_keys=True).encode()).hexdigest()
            self.escribir_conf(sec, huella)
        self.raiz = 'bhr:' + ruta_limpia(self.c.get('ruta') or 'bricohams-backup')
        return self

    def escribir_conf(self, sec, huella, siempre=False):
        e = leer_json(ESTADO)
        if not siempre and e.get('rclone_conf') == huella and os.path.isfile(RCLONE_CONF):
            return
        os.makedirs(DATOS, mode=0o700, exist_ok=True)
        fd = os.open(RCLONE_CONF + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write('[bhr]\n' + ''.join('%s = %s\n' % (k, v.replace('\n', '')) for k, v in sec.items()))
        os.replace(RCLONE_CONF + '.tmp', RCLONE_CONF)
        e['rclone_conf'] = huella
        escribir_json(ESTADO, e, 0o644)

    def __exit__(self, *a):
        if self.c['protocolo'] == 'sftp':
            with contextlib.suppress(OSError):
                os.unlink(RCLONE_CONF)

    def rc(self, *a, timeout=1800):
        return ejecutar(['rclone', '--config', RCLONE_CONF, '--contimeout', '30s', '--timeout', '5m',
                         '--retries', '3', '--low-level-retries', '5'] + list(a), timeout=timeout)

    def listar(self):
        self.rc('mkdir', self.raiz, timeout=120)
        return sorted(n for n in self.rc('lsf', '--files-only', self.raiz, timeout=120).splitlines() if NOMBRE.match(n))

    def subir(self, local, nombre):
        self.rc('copyto', local, '%s/%s' % (self.raiz, nombre))

    def leer(self, nombre):
        p = subprocess.Popen(['rclone', '--config', RCLONE_CONF, 'cat', '%s/%s' % (self.raiz, nombre)],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            yield from iter(lambda: p.stdout.read(1 << 20), b'')
        finally:
            p.stdout.close()
            err = p.stderr.read().decode('utf-8', 'replace')
            if p.wait():
                raise Fallo('rclone cat: %s' % tapar(err.strip())[-300:])

    def borrar(self, nombre):
        self.rc('deletefile', '%s/%s' % (self.raiz, nombre), timeout=120)

    def escribir_prueba(self):
        with tempfile.NamedTemporaryFile('w', dir=RUN, delete=False) as f:
            f.write(ahora())
        try:
            self.rc('copyto', f.name, self.raiz + '/.bricohams-prueba', timeout=120)
            self.rc('deletefile', self.raiz + '/.bricohams-prueba', timeout=120)
        finally:
            os.unlink(f.name)


def destino(c, s):
    return Montado(c, s) if c['protocolo'] in ('cifs', 'nfs') else Rclone(c, s)


# ---------------------------------------------------------------- copia
def sha256_de(trozos):
    h = hashlib.sha256()
    for t in trozos:
        h.update(t)
    return h.hexdigest()


def preparar_copia(c, carpeta):
    """bricohams-backup local -> copia nueva sin secretos (salvo que se pida)."""
    salida = ejecutar([BACKUP_LOCAL], timeout=1800).strip().splitlines()
    origen = salida[-1].strip() if salida else ''
    if not os.path.isfile(origen):
        raise Fallo('bricohams-backup no ha dejado la copia local')
    nombre = 'bricohams-backup-%s.tar.gz' % datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    destino_local = os.path.join(carpeta, nombre)
    quitados = 0
    with tarfile.open(origen, 'r:gz') as ent, tarfile.open(destino_local, 'w:gz') as sal:
        for m in ent:
            if not c.get('incluir_secretos') and any(r.search(m.name.lstrip('./')) for r in SECRETOS_TAR):
                quitados += 1
                continue
            sal.addfile(m, ent.extractfile(m) if m.isfile() else None)
    os.chmod(destino_local, 0o600)
    with open(destino_local, 'rb') as f:
        suma = sha256_de(iter(lambda: f.read(1 << 20), b''))
    with open(destino_local + '.sha256', 'w') as f:
        f.write('%s  %s\n' % (suma, nombre))
    return destino_local, nombre, suma, quitados


def verificar_remoto(d, nombre, suma):
    remota = sha256_de(d.leer(nombre))
    if remota != suma:
        raise Fallo('la copia remota %s no coincide (SHA256 distinto)' % nombre)


def orden_copiar(c, s):
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=RUN) as tmp:
        local, nombre, suma, quitados = preparar_copia(c, tmp)
        tam = os.path.getsize(local)
        log('copia preparada: %s (%.1f MB, %d ficheros con secretos fuera)' % (nombre, tam / 1e6, quitados))
        with destino(c, s) as d:
            d.subir(local, nombre)
            d.subir(local + '.sha256', nombre + '.sha256')
            verificar_remoto(d, nombre, suma)
            log('subida y verificada (SHA256 %s…)' % suma[:16])
            copias = d.listar()
            for viejo in copias[:-c['retencion']]:
                d.borrar(viejo)
                with contextlib.suppress(Exception):
                    d.borrar(viejo + '.sha256')
                log('retención: borrada %s' % viejo)
    return 'copia %s subida y verificada' % nombre, {'ultima_copia': nombre, 'ultima_suma': suma,
                                                     'ultima_fecha': ahora(), 'ultimo_tamano': tam}


def orden_verificar(c, s):
    e = leer_json(ESTADO)
    with destino(c, s) as d:
        copias = d.listar()
        if not copias:
            raise Fallo('no hay copias en el destino')
        nombre = copias[-1]
        suma = e.get('ultima_suma') if e.get('ultima_copia') == nombre else None
        if not suma:
            linea = b''.join(d.leer(nombre + '.sha256')).decode('ascii', 'replace').split()
            suma = linea[0] if linea else ''
        if not re.match(r'^[0-9a-f]{64}$', suma or ''):
            raise Fallo('no encuentro el SHA256 de %s' % nombre)
        verificar_remoto(d, nombre, suma)
    return '%s verificada (%d copias en el destino)' % (nombre, len(copias)), {}


def orden_probar(c, s):
    with destino(c, s) as d:
        d.escribir_prueba()
        n = len(d.listar())
    return 'conexión correcta: se puede escribir (%d copias en el destino)' % n, {}


def orden_huella(c, s):
    if c['protocolo'] != 'sftp':
        raise Fallo('la huella solo se usa con SFTP')
    host, puerto = c.get('servidor', ''), str(int(c.get('puerto') or 22))
    if not re.match(r'^([A-Za-z0-9.-]{1,253}|[0-9A-Fa-f:]{2,39})$', host):
        raise Fallo('servidor SFTP no válido')
    claves = ejecutar(['ssh-keyscan', '-T', '10', '-p', puerto, '-t', 'ed25519,ecdsa,rsa', host], timeout=30)
    claves = '\n'.join(l for l in claves.splitlines() if l and not l.startswith('#')) + '\n'
    if not claves.strip():
        raise Fallo('el servidor no ha devuelto ninguna clave SSH')
    os.makedirs(DATOS, mode=0o700, exist_ok=True)
    with open(KNOWN_PEND, 'w') as f:
        f.write(claves)
    huellas = ejecutar(['ssh-keygen', '-l', '-E', 'sha256', '-f', KNOWN_PEND], timeout=30).strip()
    return 'huella leída: compárala con la del servidor y confírmala', {'huella_pendiente': huellas}


def orden_confirmar(c, s):
    if not os.path.isfile(KNOWN_PEND):
        raise Fallo('no hay ninguna huella pendiente: pulsa antes «Leer huella»')
    os.replace(KNOWN_PEND, KNOWN)
    os.chmod(KNOWN, 0o600)
    e = leer_json(ESTADO)
    return 'huella del servidor confirmada', {'huella': e.get('huella_pendiente', ''), 'huella_pendiente': ''}


ACCIONES = {'probar': orden_probar, 'copiar': orden_copiar, 'verificar': orden_verificar,
            'huella': orden_huella, 'confirmar': orden_confirmar}


def main(a):
    if len(a) != 2 or a[1] not in ORDENES:
        print('uso: bricohams-backup-remoto ' + '|'.join(ORDENES), file=sys.stderr)
        return 2
    orden = a[1]
    if orden == 'estado':
        print(json.dumps(leer_json(ESTADO), ensure_ascii=False, indent=1))
        return 0
    os.umask(0o077)
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    with open(os.path.join(RUN, 'lock'), 'w') as cerrojo:
        try:
            fcntl.flock(cerrojo, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            log('ya hay otra operación de backup remoto en marcha')
            anotar(orden, False, 'ya hay otra operación en marcha')
            return 1
        anotar(orden, None, 'en marcha…')
        try:
            c, s = cargar()
            mensaje, extra = ACCIONES[orden](c, s)
        except (Fallo, OSError, ValueError, tarfile.TarError, subprocess.TimeoutExpired) as x:
            log('ERROR %s: %s' % (orden, x))
            anotar(orden, False, x)
            return 1
        log(mensaje)
        anotar(orden, True, mensaje, **extra)
        return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
