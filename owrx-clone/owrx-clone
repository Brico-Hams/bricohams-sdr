def leer_os():
    d = {}
    try:
        for l in open(R('/etc/os-release'), encoding='utf-8'):
            k, _, v = l.strip().partition('=')
            if k:
                d[k] = v.strip().strip('"')
    except OSError:
        pass
    return {'id': d.get('ID', ''), 'like': d.get('ID_LIKE', ''), 'codename': d.get('VERSION_CODENAME', ''),
            'ubuntu_codename': d.get('UBUNTU_CODENAME', ''), 'nombre': d.get('PRETTY_NAME', '?')}


def arquitectura():
    if os.environ.get('OWRX_CLONE_ARCH'):
        return os.environ['OWRX_CLONE_ARCH']
    try:
        return subprocess.run(['dpkg', '--print-architecture'], capture_output=True, text=True).stdout.strip() or '?'
    except OSError:
        return {'x86_64': 'amd64', 'aarch64': 'arm64', 'armv7l': 'armhf'}.get(platform.machine(), platform.machine())


def conf_openwebrx(base=None):
    """data_directory y puerto según openwebrx.conf + openwebrx.conf.d/*.conf (como OpenWebRX+)."""
    base = base or R('/etc/openwebrx')
    cp = configparser.ConfigParser()
    cp.read_dict({'core': {'data_directory': '/var/lib/openwebrx'}, 'web': {'port': '8073'}})
    fs = [os.path.join(base, 'openwebrx.conf')]
    if os.path.isfile(fs[0]):
        fs += sorted(os.path.join(base, 'openwebrx.conf.d', f) for f in os.listdir(os.path.join(base, 'openwebrx.conf.d'))
                     if f.endswith('.conf')) if os.path.isdir(os.path.join(base, 'openwebrx.conf.d')) else []
    try:
        cp.read(fs)
    except configparser.Error as e:
        aviso('openwebrx.conf no se puede leer (%s): uso los valores por defecto' % e)
    try:
        puerto = int(cp.get('web', 'port'))
    except ValueError:
        puerto = 8073
    return {'data': cp.get('core', 'data_directory').rstrip('/') or '/var/lib/openwebrx', 'puerto': puerto}


def paquetes_instalados():
    """{nombre: versión} de /var/lib/dpkg/status (sin llamar a dpkg: así funciona igual en pruebas)."""
    r, cur = {}, {}
    try:
        texto = open(R('/var/lib/dpkg/status'), encoding='utf-8', errors='replace').read()
    except OSError:
        return r
    for bloque in texto.split('\n\n'):
        cur = {}
        for l in bloque.splitlines():
            if l and not l.startswith(' ') and ':' in l:
                k, _, v = l.partition(':')
                cur[k] = v.strip()
        if cur.get('Package') and cur.get('Status', '').endswith('installed') and 'not-installed' not in cur.get('Status', ''):
            r[cur['Package']] = cur.get('Version', '')
    return r


def paquetes_automaticos():
    auto, nombre = set(), None
    try:
        for l in open(R('/var/lib/apt/extended_states'), encoding='utf-8', errors='replace'):
            if l.startswith('Package:'):
                nombre = l.split(':', 1)[1].strip()
            elif l.startswith('Auto-Installed:') and l.split(':', 1)[1].strip() == '1' and nombre:
                auto.add(nombre)
    except OSError:
        pass
    return auto


def ficheros_paquete(pkg='openwebrx'):
    """{ruta absoluta: md5} del paquete (md5sums de dpkg)."""
    for n in (pkg, pkg + ':all', pkg + ':' + arquitectura()):
        p = R('/var/lib/dpkg/info/%s.md5sums' % n)
        if os.path.isfile(p):
            r = {}
            for l in open(p, encoding='utf-8', errors='replace'):
                partes = l.rstrip('\n').split(None, 1)
                if len(partes) == 2:
                    r['/' + partes[1].lstrip('/')] = partes[0]
            return r
    return {}


def ruta_htdocs(md5s):
    for p in md5s:
        if p.endswith('/htdocs/index.html'):
            return os.path.dirname(p)
    for p in ('/usr/lib/python3/dist-packages/htdocs', '/usr/local/lib/python3/dist-packages/htdocs'):
        if os.path.isdir(R(p)):
            return p
    return '/usr/lib/python3/dist-packages/htdocs'


def equipo():
    pk = paquetes_instalados()
    md5s = ficheros_paquete()
    c = conf_openwebrx()
    return {'hostname': socket.gethostname(), 'so': leer_os(), 'arch': arquitectura(),
            'openwebrx': pk.get('openwebrx', ''), 'data': c['data'], 'puerto': c['puerto'],
            'htdocs': ruta_htdocs(md5s), 'paquetes': pk, 'md5s': md5s}


def receptores(settings):
    """Resumen de los SDR de un settings.json."""
    out = []
    for i, s in (settings.get('sdrs') or {}).items():
        out.append({'id': i, 'nombre': s.get('name', i), 'tipo': s.get('type', '?'), 'device': str(s.get('device', '')),
                    'activo': s.get('enabled', True), 'perfiles': len(s.get('profiles') or {})})
    return out


def quitar_secretos(obj, ruta='', quitados=None):
    quitados = [] if quitados is None else quitados
    if isinstance(obj, dict):
        for k in list(obj):
            if SECRETO.search(k) and isinstance(obj[k], (str, int, list, dict)) and obj[k] not in ('', None, [], {}):
                obj[k] = '' if isinstance(obj[k], (str, int)) else type(obj[k])()
                quitados.append(ruta + k)
            else:
                quitar_secretos(obj[k], ruta + k + '.', quitados)
    elif isinstance(obj, list):
        for i, x in enumerate(obj):
            quitar_secretos(x, ruta + '%d.' % i, quitados)
    return quitados


