def comprobar(a):
    eq = equipo()
    malos = 0
    info('Comprobando OpenWebRX+ en %s (%s, %s)' % (eq['hostname'], eq['so']['nombre'], eq['arch']))
    if eq['openwebrx']:
        bien('paquete openwebrx %s' % eq['openwebrx'])
    else:
        aviso('el paquete openwebrx no está instalado'); malos += 1
    for f in ('settings.json', 'users.json', 'bookmarks.json'):
        p = R(eq['data'] + '/' + f)
        if not os.path.isfile(p):
            aviso('%s no existe en %s' % (f, eq['data']))
            malos += f == 'settings.json'
            continue
        try:
            j = json.load(open(p, encoding='utf-8'))
            if f == 'settings.json':
                bien('settings.json válido · %d receptor(es) · «%s»' % (len(j.get('sdrs') or {}), j.get('receiver_name', '')))
            else:
                bien('%s válido (%d)' % (f, len(j)))
        except PermissionError:
            aviso('%s: sin permiso para leerlo (usa sudo)' % f)
        except ValueError as e:
            aviso('%s NO es JSON válido: %s' % (f, e)); malos += 1
    init = R(eq['htdocs'] + '/plugins/receiver/init.js')
    if os.path.isfile(init):
        t = open(init, encoding='utf-8', errors='replace').read()
        # plugins LOCALES: Plugins.load('nombre') y bucles «for (const x of ['a', 'b']) … Plugins.load(x)»
        nombres = set(re.findall(r"Plugins\.load\(\s*['\"]([a-z0-9_]+)['\"]", t))
        for var, lista in re.findall(r"for\s*\(\s*(?:const|let|var)\s+(\w+)\s+of\s+\[([^\]]*)\]\s*\)\s*\{[^}]{0,200}?Plugins\.load\(\s*\w+\s*\)", t):
            nombres |= set(re.findall(r"'([a-z0-9_]+)'", lista))
        faltan = sorted(n for n in nombres if not os.path.isdir(R(eq['htdocs'] + '/plugins/receiver/' + n)))
        if faltan:
            aviso('init.js carga plugins locales que no están: %s' % ', '.join(faltan)); malos += 1
        else:
            bien('init.js y sus plugins locales')
    retocados = [p for p, s in eq['md5s'].items() if os.path.isfile(R(p)) and md5(R(p)) != s]
    if retocados:
        aviso('%d fichero(s) del paquete retocados a mano (se pierden al actualizar el paquete): %s' % (
            len(retocados), ', '.join(os.path.basename(x) for x in retocados[:6])))
    if not SIMULAR_ORDENES:
        r = subprocess.run(['systemctl', 'is-active', 'openwebrx'], capture_output=True, text=True)
        if r.stdout.strip() == 'active':
            bien('servicio openwebrx activo')
        else:
            aviso('servicio openwebrx %s' % (r.stdout.strip() or '?')); malos += 1
        if esperar_web(eq['puerto'], 5):
            bien('responde en http://%s:%d/' % (_ip(), eq['puerto']))
        else:
            aviso('no responde en el puerto %d' % eq['puerto']); malos += 1
    print()
    (info if not malos else aviso)('%s' % ('todo bien' if not malos else '%d problema(s)' % malos))
    return 1 if malos else 0


