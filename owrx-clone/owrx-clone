def copia_previa(destinos):
    """destinos: [(ruta, base)]. Guarda lo que existe (los enlaces, como enlaces) y la base de cada ruta."""
    os.makedirs(R(COPIAS), mode=0o700, exist_ok=True)
    nombre = R(COPIAS + '/copia-%s.tar.gz' % datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
    existentes = [d for d, _ in destinos if os.path.isfile(R(d)) or os.path.islink(R(d))]
    meta = {'herramienta': 'owrx-clone ' + VERSION, 'creada': datetime.datetime.now().isoformat(timespec='seconds'),
            'sobrescritos': existentes, 'creados': [], 'bases': {d: b for d, b in destinos if b}}
    fd = os.open(nombre, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'wb') as f, tarfile.open(fileobj=f, mode='w:gz') as t:
        for d in existentes:
            t.add(R(d), arcname='ficheros' + d)
        datos = json.dumps(meta, indent=2).encode()
        ti = tarfile.TarInfo('copia.json')
        ti.size = len(datos)
        t.addfile(ti, io.BytesIO(datos))
    return sin_raiz(nombre)


def _anotar_creados(copia, creados):
    with open(R(copia) + '.creados.json', 'w') as f:
        json.dump(creados, f, indent=2)
    os.chmod(R(copia) + '.creados.json', 0o600)


def deshacer(a):
    necesita_root()
    copias = sorted(f for f in _glob(R(COPIAS), ('copia-*.tar.gz',)))
    if a.copia:
        if '/' not in a.copia:
            copia = R(COPIAS + '/' + a.copia)
        else:
            copia = a.copia if (not RAIZ or a.copia.startswith(RAIZ)) else R(a.copia)
    elif copias:
        copia = copias[-1]
    else:
        raise Error('no hay copias en %s: no hay nada que deshacer' % COPIAS)
    if not os.path.isfile(copia):
        raise Error('no existe la copia %s' % copia)
    creados = []
    if os.path.isfile(copia + '.creados.json'):
        creados = json.load(open(copia + '.creados.json'))
    with tarfile.open(copia, 'r:gz') as t:
        meta = json.load(t.extractfile('copia.json'))
        info('Deshaciendo la importación con la copia %s (%s)' % (sin_raiz(copia), meta['creada']))
        gris('%d fichero(s) vuelven a como estaban · %d fichero(s) nuevos se borran' % (len(meta['sobrescritos']), len(creados)))
        if not a.si:
            if not sys.stdin.isatty():
                raise Error('falta confirmar: añade --si')
            if input('¿Seguir? [s/N] ').strip().lower() not in ('s', 'si', 'sí', 'y', 'yes'):
                return 1
        bases = meta.get('bases', {})
        servicio('stop', comprobar=False)
        saltados = []
        try:
            for mi in t.getmembers():
                if not mi.name.startswith('ficheros/') or '..' in mi.name.split('/'):
                    continue
                d = '/' + mi.name[len('ficheros/'):]
                if d not in meta['sobrescritos']:
                    continue
                if not camino_seguro(d, bases.get(d)):
                    saltados.append(d)
                    continue
                if mi.issym():
                    os.makedirs(os.path.dirname(R(d)), exist_ok=True)
                    if os.path.lexists(R(d)):
                        os.unlink(R(d))
                    os.symlink(mi.linkname, R(d))
                elif mi.isfile():
                    escribir_seguro(d, t.extractfile(mi).read(), mi.mode, (mi.uid, mi.gid), bases.get(d))
            for d in creados:
                if d not in meta['sobrescritos'] and os.path.lexists(R(d)):
                    if camino_seguro(d, bases.get(d)):
                        os.unlink(R(d))
                    else:
                        saltados.append(d)
        finally:
            ejecutar(['systemctl', 'daemon-reload'], comprobar=False)
            ejecutar(['udevadm', 'control', '--reload'], comprobar=False)
            servicio('start', comprobar=False)
    for d in saltados:
        aviso('no toco %s: hay un enlace simbólico en su camino (revísalo a mano)' % d)
    os.replace(copia, copia + '.usada')
    if os.path.isfile(copia + '.creados.json'):
        os.replace(copia + '.creados.json', copia + '.usada.creados.json')
    bien('hecho: la estación está como antes de importar (los paquetes instalados se quedan)')
    return 0


