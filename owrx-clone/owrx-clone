def abrir_perfil(ruta):
    """Devuelve (manifiesto, dir_temporal) tras comprobar sumas y nombres."""
    if not os.path.isfile(ruta):
        raise Error('no existe el perfil %s' % ruta)
    datos = open(ruta, 'rb').read()
    if datos[:8] == b'Salted__':
        clave = _clave(False)
        r = subprocess.run(['openssl', 'enc', '-d', '-aes-256-cbc', '-pbkdf2', '-iter', '200000', '-pass', 'env:OWRX_CLONE_CLAVE_INT'],
                           input=datos, capture_output=True, env=dict(os.environ, OWRX_CLONE_CLAVE_INT=clave))
        if r.returncode != 0:
            raise Error('no he podido descifrar el perfil: ¿contraseña equivocada?')
        datos = r.stdout
    tmp = tempfile.mkdtemp(prefix='owrx-clone-')
    try:
        with tarfile.open(fileobj=io.BytesIO(datos), mode='r:gz') as t:
            for mi in t.getmembers():
                n = mi.name
                if not mi.isfile() or n.startswith('/') or '..' in n.split('/') or not (n in ('manifiesto.json', 'LEEME.txt') or n.startswith('archivos/')):
                    raise Error('el perfil tiene una entrada no permitida: %s' % n)
                dst = os.path.join(tmp, n)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, 'wb') as f:
                    f.write(t.extractfile(mi).read())
    except (tarfile.TarError, OSError, EOFError) as e:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Error('el fichero no es un perfil válido (%s)' % e)
    try:
        m = json.load(open(os.path.join(tmp, 'manifiesto.json'), encoding='utf-8'))
    except (OSError, ValueError):
        shutil.rmtree(tmp, ignore_errors=True)
        raise Error('al perfil le falta manifiesto.json o está dañado')
    if m.get('formato', 0) > FORMATO:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Error('perfil de formato %s: actualiza owrx-clone (este entiende hasta el %d)' % (m.get('formato'), FORMATO))
    for e in m.get('ficheros', []):
        p = os.path.join(tmp, e['arc'])
        if e['arc'] != arc_de(e['nivel'], e['ruta']) or not os.path.isfile(p) or sha256(ruta=p) != e['sha256']:
            shutil.rmtree(tmp, ignore_errors=True)
            raise Error('el perfil está dañado o manipulado: %s no cuadra con su suma SHA-256' % e['ruta'])
    return m, tmp


