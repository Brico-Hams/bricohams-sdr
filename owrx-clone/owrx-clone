def R(p):
    """Ruta real en este equipo (con OWRX_CLONE_RAIZ en las pruebas)."""
    return RAIZ + p if RAIZ else p


def sin_raiz(p):
    return p[len(RAIZ):] if RAIZ and p.startswith(RAIZ) else p


def ejecutar(orden, comprobar=True, entrada=None, timeout=None):
    ORDENES.append(' '.join(orden))
    if SIMULAR_ORDENES:
        return subprocess.CompletedProcess(orden, 0, '', '')
    r = subprocess.run(orden, input=entrada, capture_output=True, text=True, timeout=timeout)
    if comprobar and r.returncode != 0:
        raise Error('falló «%s»: %s' % (' '.join(orden), (r.stderr or r.stdout).strip()[-400:]))
    return r


def sha256(datos=None, ruta=None):
    h = hashlib.sha256()
    if ruta:
        with open(ruta, 'rb') as f:
            for b in iter(lambda: f.read(1 << 16), b''):
                h.update(b)
    else:
        h.update(datos)
    return h.hexdigest()


def md5(ruta):
    h = hashlib.md5()
    with open(ruta, 'rb') as f:
        for b in iter(lambda: f.read(1 << 16), b''):
            h.update(b)
    return h.hexdigest()


def necesita_root():
    if not RAIZ and os.geteuid() != 0:
        raise Error('hace falta root: sudo owrx-clone %s' % ' '.join(sys.argv[1:]))


