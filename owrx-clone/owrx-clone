def _recorrer(base):
    if os.path.isfile(base):
        yield base
        return
    for d, subs, fs in os.walk(base):
        subs.sort()
        for f in sorted(fs):
            p = os.path.join(d, f)
            if os.path.isfile(p) and not os.path.islink(p):
                yield p


def _excluido(logica, patrones):
    return any(fnmatch.fnmatch(logica, p) or fnmatch.fnmatch(os.path.basename(logica), p) for p in patrones)


def recoger(eq, niveles, excluir=(), incluir=(), sin_usuarios=False):
    """Lista de (nivel, ruta lógica, ruta real) a exportar."""
    excl = list(EXCLUIR_DEFECTO) + list(excluir)
    out, vistos = [], set()

    def poner(nivel, logica, real):
        if logica in vistos or _excluido(logica, excl):
            return
        try:
            if os.path.getsize(real) > MAX_FICHERO:
                aviso('%s pesa más de %d MB: no lo exporto' % (logica, MAX_FICHERO >> 20))
                return
        except OSError:
            return
        vistos.add(logica)
        out.append((nivel, logica, real))

    if 'config' in niveles and os.path.isdir(R(eq['data'])):
        for real in _recorrer(R(eq['data'])):
            rel = os.path.relpath(real, R(eq['data']))
            if rel in CACHES or (sin_usuarios and rel == 'users.json'):
                continue
            poner('config', '{DATA}/' + rel, real)
    if 'etc' in niveles and os.path.isdir(R('/etc/openwebrx')):
        for real in _recorrer(R('/etc/openwebrx')):
            poner('etc', sin_raiz(real), real)
    if 'web' in niveles and os.path.isdir(R(eq['htdocs'])):
        for real in _recorrer(R(eq['htdocs'])):
            if sin_raiz(real) not in eq['md5s']:
                poner('web', '{HTDOCS}/' + os.path.relpath(real, R(eq['htdocs'])), real)
    if 'parches' in niveles:
        for ruta, suma in sorted(eq['md5s'].items()):
            real = R(ruta)
            if os.path.isfile(real) and not os.path.islink(real) and md5(real) != suma:
                poner('parches', ruta, real)
    if 'sistema' in niveles:
        for base in RUTAS_SISTEMA:
            if not os.path.isdir(R(base)):
                continue
            for real in _recorrer(R(base)):
                if base == '/etc/modprobe.d':
                    try:
                        if not re.search(r'rtl|dvb|sdr|airspy|hackrf|r82|e4000', open(real, errors='replace').read(), re.I):
                            continue
                    except OSError:
                        continue
                poner('sistema', sin_raiz(real), real)
    if 'extra' in niveles:
        for p in incluir:
            p = os.path.abspath(p)
            if any(p == x or p.startswith(x + '/') for x in PROHIBIDAS):
                raise Error('--incluir %s: esa ruta no se puede clonar (sistema o claves)' % p)
            if not os.path.exists(R(p)):
                raise Error('--incluir %s: no existe' % p)
            for real in _recorrer(R(p)):
                poner('extra', sin_raiz(real), real)
    return out


def _info_fichero(real):
    st = os.stat(real)
    try:
        u = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        u = str(st.st_uid)
    try:
        g = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        g = str(st.st_gid)
    return {'modo': '%04o' % (st.st_mode & 0o7777), 'dueno': u, 'grupo': g}


def arc_de(nivel, logica):
    return 'archivos/%s/%s' % (nivel, logica.replace('{', '').replace('}', '').lstrip('/'))


def exportar(a):
    necesita_root()
    eq = equipo()
    niveles = _lista_niveles(a.niveles, NIVELES[:-1] + (['extra'] if a.incluir else []))
    if a.incluir and 'extra' not in niveles:
        niveles.append('extra')
    if not eq['openwebrx']:
        aviso('el paquete openwebrx no está instalado aquí: exporto lo que encuentre')
    info('Exportando OpenWebRX+ %s de %s (%s, %s)' % (eq['openwebrx'] or '?', eq['hostname'], eq['so']['nombre'], eq['arch']))
    lista = recoger(eq, niveles, a.excluir, a.incluir, a.sin_usuarios or a.publico)
    entradas, contenido, quitados = [], {}, []
    for nivel, logica, real in lista:
        datos = open(real, 'rb').read()
        if a.publico and logica == '{DATA}/settings.json':
            try:
                j = json.loads(datos)
                quitados = quitar_secretos(j)
                datos = json.dumps(j, indent=4, ensure_ascii=False).encode()
            except ValueError:
                aviso('settings.json no es JSON válido: va tal cual')
        e = {'nivel': nivel, 'ruta': logica, 'arc': arc_de(nivel, logica), 'sha256': sha256(datos), 'tam': len(datos)}
        e.update(_info_fichero(real))
        entradas.append(e)
        contenido[e['arc']] = datos
    settings = {}
    if os.path.isfile(R(eq['data'] + '/settings.json')):
        try:
            settings = json.load(open(R(eq['data'] + '/settings.json'), encoding='utf-8'))
        except ValueError:
            aviso('settings.json no es JSON válido')
    auto = paquetes_automaticos()
    paqs = []
    if 'paquetes' in niveles:
        paqs = [{'nombre': p, 'version': v} for p, v in sorted(eq['paquetes'].items())
                if (p == 'openwebrx' or (PATRON_SDR.match(p) and p not in auto)) and not p.endswith('-dev')]
    repos = []
    for f in sorted(_glob(R('/etc/apt/sources.list.d'), ('*.list', '*.sources'))):
        for l in open(f, errors='replace'):
            if re.search(r'luarvique|openwebrx', l) and not l.lstrip().startswith('#'):
                repos.append(l.strip())
    avisos = []
    if os.path.exists(R('/usr/local/lib/libsdrplay_api.so')) or _glob(R('/usr/local/lib'), ('libsdrplay_api.so*',)):
        avisos.append('Hay una API de SDRplay instalada a mano: en el destino instálala desde sdrplay.com (licencia propia).')
    if any(e['nivel'] == 'parches' for e in entradas):
        avisos.append('Lleva ficheros del paquete openwebrx retocados: solo se aplican en el destino con la versión %s.' % eq['openwebrx'])
    m = {
        'formato': FORMATO, 'herramienta': 'owrx-clone ' + VERSION,
        'creado': datetime.datetime.now().astimezone().isoformat(timespec='seconds'),
        'origen': {'hostname': eq['hostname'], 'so': eq['so'], 'arch': eq['arch'], 'openwebrx': eq['openwebrx'],
                   'data': eq['data'], 'htdocs': eq['htdocs'], 'puerto': eq['puerto']},
        'niveles': niveles, 'secretos': 'quitados' if a.publico else 'incluidos',
        'secretos_quitados': quitados, 'usuarios': any(e['ruta'] == '{DATA}/users.json' for e in entradas),
        'receptores': receptores(settings), 'nombre_receptor': settings.get('receiver_name', ''),
        'paquetes': paqs, 'repos': repos, 'avisos': avisos, 'ficheros': entradas,
        'nota': a.nota or '',
    }
    destino = a.salida or 'owrx-perfil-%s-%s.owrx.tar.gz' % (re.sub(r'[^A-Za-z0-9_.-]', '_', eq['hostname']),
                                                             datetime.datetime.now().strftime('%Y%m%d-%H%M'))
    if a.cifrar and not destino.endswith('.enc'):
        destino += '.enc'
    _escribir_perfil(destino, m, contenido, a.cifrar)
    por = {}
    for e in entradas:
        por[e['nivel']] = por.get(e['nivel'], 0) + 1
    bien('perfil: %s (%s)' % (destino, _tam(os.path.getsize(destino))))
    for n in niveles:
        gris('%-9s %4d fichero(s) · %s' % (n, len(paqs) if n == 'paquetes' else por.get(n, 0), DESC_NIVEL[n]))
    gris('receptores: %d · usuarios: %s · claves: %s%s' % (
        len(m['receptores']), 'sí' if m['usuarios'] else 'no', m['secretos'],
        ' (%d quitadas)' % len(quitados) if a.publico else ''))
    for x in avisos:
        aviso(x)
    if not a.publico:
        aviso('El perfil lleva contraseñas y claves (usuarios, settings.json). Guárdalo como una contraseña'
              + ('' if a.cifrar else ' o usa --cifrar') + '. Para compartirlo: --publico.')
    return 0


def _glob(base, patrones):
    if not os.path.isdir(base):
        return []
    return [os.path.join(base, f) for f in os.listdir(base) if any(fnmatch.fnmatch(f, p) for p in patrones)]


def _tam(n):
    for u in ('B', 'kB', 'MB', 'GB'):
        if n < 1024:
            return '%.0f %s' % (n, u)
        n /= 1024.0
    return '%.1f TB' % n


def _clave(confirmar):
    k = os.environ.get('OWRX_CLONE_CLAVE')
    if k:
        return k
    if not sys.stdin.isatty():
        raise Error('perfil cifrado: pon la contraseña en OWRX_CLONE_CLAVE o ejecútalo en un terminal')
    k = getpass.getpass('Contraseña del perfil: ')
    if confirmar and getpass.getpass('Repítela: ') != k:
        raise Error('las contraseñas no coinciden')
    if len(k) < 8:
        raise Error('la contraseña debe tener al menos 8 caracteres')
    return k


def _escribir_perfil(destino, m, contenido, cifrar):
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode='w:gz') as t:
        def add(nombre, datos, modo=0o644):
            ti = tarfile.TarInfo(nombre)
            ti.size, ti.mode, ti.mtime = len(datos), modo, int(time.time())
            t.addfile(ti, io.BytesIO(datos))
        add('manifiesto.json', json.dumps(m, indent=2, ensure_ascii=False).encode())
        add('LEEME.txt', _leeme(m).encode())
        for e in m['ficheros']:
            add(e['arc'], contenido[e['arc']], 0o600)
    datos = buf.getvalue()
    if cifrar:
        clave = _clave(True)
        r = subprocess.run(['openssl', 'enc', '-aes-256-cbc', '-pbkdf2', '-iter', '200000', '-salt', '-pass', 'env:OWRX_CLONE_CLAVE_INT'],
                           input=datos, capture_output=True, env=dict(os.environ, OWRX_CLONE_CLAVE_INT=clave))
        if r.returncode != 0:
            raise Error('openssl no ha podido cifrar: %s' % r.stderr.decode(errors='replace'))
        datos = r.stdout
    fd = os.open(destino, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(datos)
    os.chmod(destino, 0o600)
    if os.environ.get('SUDO_UID') and not RAIZ:
        try:
            os.chown(destino, int(os.environ['SUDO_UID']), int(os.environ.get('SUDO_GID', os.environ['SUDO_UID'])))
        except OSError:
            pass


def _leeme(m):
    o = m['origen']
    l = ['Perfil de OpenWebRX+ hecho con %s el %s' % (m['herramienta'], m['creado']),
         'Origen: %s · %s · %s · OpenWebRX+ %s' % (o['hostname'], o['so'].get('nombre', '?'), o['arch'], o['openwebrx'] or '?'),
         'Receptor: %s' % (m.get('nombre_receptor') or '?'), '', 'Niveles: ' + ', '.join(m['niveles']),
         'Claves: ' + m['secretos'], '', 'Para verlo:     owrx-clone ver ESTE_FICHERO',
         'Para probarlo:  sudo owrx-clone importar ESTE_FICHERO --simular',
         'Para aplicarlo: sudo owrx-clone importar ESTE_FICHERO', '']
    if m.get('nota'):
        l += ['Nota: ' + m['nota'], '']
    return '\n'.join(l)


