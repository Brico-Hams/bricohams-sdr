def parser():
    p = argparse.ArgumentParser(prog='owrx-clone', formatter_class=argparse.RawDescriptionHelpFormatter,
                                description='Clona una instalación de OpenWebRX+ (configuración, plugins, sistema y paquetes) a otro equipo.',
                                epilog='Ejemplos:\n'
                                       '  sudo owrx-clone exportar --cifrar\n'
                                       '  owrx-clone ver owrx-perfil-sdr-20261005-1200.owrx.tar.gz.enc\n'
                                       '  sudo owrx-clone importar perfil.owrx.tar.gz --simular\n'
                                       '  sudo owrx-clone importar perfil.owrx.tar.gz --todo --mapear "serial=00000101=>serial=1234"\n'
                                       '  sudo owrx-clone deshacer\n'
                                       'Más: owrx-clone ayuda {niveles,seguridad,dispositivos,migrar,problemas} · man owrx-clone')
    p.add_argument('--version', action='version', version='owrx-clone ' + VERSION)
    p.add_argument('--raiz', help=argparse.SUPPRESS)
    sp = p.add_subparsers(dest='orden', metavar='ORDEN')

    e = sp.add_parser('exportar', aliases=['export'], help='crea un perfil con la estación de este equipo')
    e.add_argument('-o', '--salida', help='fichero de salida (por defecto owrx-perfil-EQUIPO-FECHA.owrx.tar.gz)')
    e.add_argument('--niveles', help='qué exportar, separado por comas (por defecto todos): ' + ','.join(NIVELES[:-1]))
    e.add_argument('--publico', action='store_true', help='para compartir: sin usuarios y con las claves en blanco')
    e.add_argument('--sin-usuarios', action='store_true', help='no incluir users.json')
    e.add_argument('--cifrar', action='store_true', help='cifrar con contraseña (AES-256, openssl)')
    e.add_argument('--incluir', action='append', default=[], metavar='RUTA', help='añadir un fichero o carpeta (nivel «extra»)')
    e.add_argument('--excluir', action='append', default=[], metavar='PATRÓN', help='no incluir lo que encaje (p. ej. "*.mp3")')
    e.add_argument('--nota', help='texto libre que se guarda en el perfil')
    e.set_defaults(fn=exportar)

    v = sp.add_parser('ver', aliases=['show'], help='muestra qué lleva un perfil (no cambia nada)')
    v.add_argument('perfil')
    v.add_argument('--todo', action='store_true', help='lista también cada fichero')
    v.add_argument('--json', action='store_true', help='el manifiesto completo en JSON')
    v.set_defaults(fn=ver)

    i = sp.add_parser('importar', aliases=['import'], help='aplica un perfil en este equipo')
    i.add_argument('perfil')
    i.add_argument('--niveles', help='qué aplicar (por defecto %s)' % ','.join(NIVELES_DEFECTO_IMPORTAR))
    i.add_argument('--todo', action='store_true', help='aplicar todos los niveles menos «extra», incluidos sistema y parches (ejecutan código como root: solo perfiles propios o de confianza)')
    i.add_argument('--simular', action='store_true', help='enseña lo que haría sin cambiar nada')
    i.add_argument('--detalle', action='store_true', help='lista cada fichero')
    i.add_argument('--si', action='store_true', help='no preguntar')
    i.add_argument('--sin-paquetes', action='store_true', help='no instalar paquetes')
    i.add_argument('--sin-usuarios', action='store_true', help='conservar los usuarios de este equipo')
    i.add_argument('--mapear', action='append', default=[], metavar='VIEJO=>NUEVO', help='cambiar el «device» de un SDR (repetible)')
    i.add_argument('--forzar-parches', action='store_true', help='aplicar los parches aunque la versión de openwebrx sea otra')
    i.add_argument('--no-arrancar', action='store_true', help='dejar OpenWebRX+ parado al terminar')
    i.set_defaults(fn=importar)

    d = sp.add_parser('deshacer', aliases=['undo'], help='vuelve a como estaba antes de la última importación')
    d.add_argument('copia', nargs='?', help='copia concreta de %s (por defecto la última)' % COPIAS)
    d.add_argument('--si', action='store_true', help='no preguntar')
    d.set_defaults(fn=deshacer)

    c = sp.add_parser('comprobar', aliases=['check'], help='revisa la instalación de OpenWebRX+ de este equipo')
    c.set_defaults(fn=comprobar)

    h = sp.add_parser('ayuda', aliases=['help'], help='ayuda por temas: ' + ', '.join(AYUDA))
    h.add_argument('tema', nargs='?', choices=list(AYUDA))
    h.set_defaults(fn=ayuda)
    return p


PARSER = parser()


def main(argv=None):
    global RAIZ
    a = PARSER.parse_args(argv)
    if a.raiz:
        RAIZ = a.raiz.rstrip('/')
    if not getattr(a, 'fn', None):
        PARSER.print_help()
        return 2
    try:
        return a.fn(a)
    except Error as e:
        print('%s✘ %s%s' % (C['ko'], e, C['0']), file=sys.stderr)
        return 1
    except OSError as e:          # disco lleno, permisos…: mensaje claro en vez de una traza
        print('%s✘ %s: %s%s' % (C['ko'], getattr(e, 'filename', '') or 'error del sistema', e.strerror or e, C['0']), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print('\ncancelado', file=sys.stderr)
        return 130


if __name__ == '__main__':
    sys.exit(main())
