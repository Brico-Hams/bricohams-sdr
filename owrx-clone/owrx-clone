def repo_openwebrx(so, arch):
    """(línea deb, clave, repositorio extra de OpenWebRX original o None) para este sistema."""
    cn = so['codename']
    es_ubuntu = so['id'] == 'ubuntu' or 'ubuntu' in so['like']
    if es_ubuntu:
        cn = so['ubuntu_codename'] or cn
    clave = 'https://luarvique.github.io/ppa/openwebrx-plus.gpg'
    extra = None
    if cn in ('bookworm', 'trixie', 'noble'):
        ruta = cn
    elif cn == 'bullseye':
        ruta = 'debian'
        extra = 'deb [signed-by=/usr/share/keyrings/openwebrx.gpg] https://repo.openwebrx.de/debian/ bullseye main'
    elif cn == 'jammy':
        ruta = 'ubuntu'
        extra = 'deb [signed-by=/usr/share/keyrings/openwebrx.gpg] https://repo.openwebrx.de/ubuntu/ jammy main'
    else:
        raise Error('sistema %s (%s) sin repositorio de OpenWebRX+: soportados Debian bullseye/bookworm/trixie, '
                    'Ubuntu jammy/noble y Raspberry Pi OS. Instala OpenWebRX+ a mano y repite con --niveles sin «paquetes».' % (so['nombre'], cn or '?'))
    if arch not in ('amd64', 'arm64', 'armhf'):
        raise Error('arquitectura %s sin paquetes de OpenWebRX+ (amd64, arm64, armhf)' % arch)
    return ('deb [signed-by=/etc/apt/trusted.gpg.d/openwebrx-plus.gpg] https://luarvique.github.io/ppa/%s ./' % ruta, clave, extra)


def _bajar(url, destino_gpg):
    ORDENES.append('bajar %s → %s' % (url, destino_gpg))
    if SIMULAR_ORDENES:
        return
    for intento in range(5):
        try:
            datos = urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'owrx-clone/' + VERSION}), timeout=30).read()
            break
        except OSError as e:
            if intento == 4:
                raise Error('no puedo bajar %s: %s' % (url, e))
            time.sleep(3)
    r = subprocess.run(['gpg', '--yes', '--dearmor', '-o', R(destino_gpg)], input=datos, capture_output=True)
    if r.returncode != 0:
        raise Error('la clave de %s no es válida' % url)


def destino_de(e, eq_dest, data_dest, htdocs_dest):
    r = e['ruta']
    if r.startswith('{DATA}/'):
        return data_dest + r[6:]
    if r.startswith('{HTDOCS}/'):
        return htdocs_dest + r[8:]
    return r


def prohibida(n):
    if '/.ssh/' in n + '/' or n.endswith('/.ssh'):
        return True
    return any(n == x or n.startswith(x.rstrip('/') + '/') for x in PROHIBIDAS)


def permitido(e, dest, data_dest, htdocs_dest, md5_dest):
    n = os.path.normpath(dest)
    if not dest.startswith('/') or n != dest.rstrip('/') or '..' in dest.split('/'):
        return False
    dentro = lambda base: n.startswith(base.rstrip('/') + '/')  # noqa: E731
    if e['nivel'] == 'sistema':                 # sus carpetas fijas (alguna cuelga de /etc/systemd)
        return any(dentro(b) for b in RUTAS_SISTEMA)
    if prohibida(n):
        return False
    if e['nivel'] == 'config':
        return dentro(data_dest)
    if e['nivel'] == 'etc':
        return dentro('/etc/openwebrx')
    if e['nivel'] == 'web':
        return dentro(htdocs_dest)
    if e['nivel'] == 'parches':
        return n in md5_dest
    if e['nivel'] == 'extra':
        return True
    return False


def camino_seguro(ruta, base=None):
    """Ninguna carpeta del camino de «ruta» por DEBAJO de «base» es un enlace simbólico (los crearía el
    usuario openwebrx dentro de sus carpetas para desviar una escritura de root). La propia base sí puede
    serlo (p. ej. /var/lib/openwebrx movido a un USB por el administrador). Sin base: todo el camino."""
    d = os.path.dirname(os.path.normpath(R(ruta)))
    tope = os.path.normpath(R(base)) if base else (RAIZ or '/')
    while d and d != tope and d != '/' and d != (RAIZ or '/'):
        if os.path.islink(d):
            return False
        d = os.path.dirname(d)
    return True


def base_de(e, data_dest, htdocs_dest):
    n = e['nivel']
    if n == 'config':
        return data_dest
    if n == 'etc':
        return '/etc/openwebrx'
    if n == 'web':
        return htdocs_dest
    if n == 'sistema':
        return next((b for b in RUTAS_SISTEMA if e['ruta'].startswith(b + '/')), None)
    return None


def escribir_seguro(ruta, datos, modo, dueno, base=None):
    """Escribe con un temporal en la misma carpeta y os.replace (nunca a través de un enlace)."""
    real = R(ruta)
    if not camino_seguro(ruta, base):
        raise Error('%s: hay un enlace simbólico en el camino; no escribo por seguridad' % ruta)
    os.makedirs(os.path.dirname(real), exist_ok=True)
    fd, tmpf = tempfile.mkstemp(dir=os.path.dirname(real), prefix='.owrx-clone-')
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(datos)
        os.chmod(tmpf, modo & 0o7777)
        _chown(tmpf, dueno)
        os.replace(tmpf, real)          # sustituye el fichero (o un enlace) sin seguirlo
    except BaseException:
        try:
            os.unlink(tmpf)
        except OSError:
            pass
        raise


def _lista_niveles(texto, defecto):
    if not texto:
        return list(defecto)
    ns = [x.strip() for x in texto.split(',') if x.strip()]
    malos = [x for x in ns if x not in NIVELES]
    if malos:
        raise Error('niveles desconocidos: %s (valen: %s)' % (', '.join(malos), ', '.join(NIVELES)))
    return [n for n in NIVELES if n in ns]


def importar(a):
    necesita_root()
    m, tmp = abrir_perfil(a.perfil)
    try:
        return _importar(a, m, tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _importar(a, m, tmp):
    eq = equipo()
    o = m['origen']
    disponibles = m['niveles']
    if a.todo:                  # todo menos «extra» (puede escribir en cualquier sitio permitido): ese hay que pedirlo
        niveles = [n for n in disponibles if n != 'extra'] + (['extra'] if a.niveles and 'extra' in a.niveles.split(',') else [])
    else:
        niveles = [n for n in _lista_niveles(a.niveles, NIVELES_DEFECTO_IMPORTAR) if n in disponibles]
    if a.sin_paquetes and 'paquetes' in niveles:
        niveles.remove('paquetes')
    info('Importando el perfil de %s (OpenWebRX+ %s, %s) en %s (%s, %s)' % (
        o['hostname'], o['openwebrx'] or '?', o['arch'], eq['hostname'], eq['so']['nombre'], eq['arch']))
    no_elegidos = [n for n in disponibles if n not in niveles]
    if no_elegidos:
        gris('niveles del perfil que NO se aplican: %s (añádelos con --niveles o --todo)' % ', '.join(no_elegidos))

    # ---- 1. paquetes (antes que los ficheros: deciden dónde está htdocs) ----
    instalar, repo = [], None
    if 'paquetes' in niveles:
        pedidos = [p['nombre'] for p in m['paquetes'] if PATRON_SDR.match(p['nombre'])]
        if 'openwebrx' not in pedidos:
            pedidos.insert(0, 'openwebrx')
        instalar = [p for p in pedidos if p not in eq['paquetes']]
        if not eq['openwebrx'] and not os.path.exists(R('/etc/apt/trusted.gpg.d/openwebrx-plus.gpg')):
            repo = repo_openwebrx(eq['so'], eq['arch'])
    elif not eq['openwebrx']:
        aviso('OpenWebRX+ no está instalado y el nivel «paquetes» no se aplica: solo copio ficheros')

    # ---- 2. plan de ficheros ----
    data_dest = eq['data']
    if 'etc' in niveles:     # si el perfil cambia data_directory, manda el del perfil… si es un sitio razonable
        base = os.path.join(tmp, 'archivos/etc/etc/openwebrx')
        if os.path.isfile(os.path.join(base, 'openwebrx.conf')):
            propuesto = os.path.normpath(conf_openwebrx(base)['data'])
            if propuesto != data_dest:
                ow = _usuario('openwebrx')
                existe = os.path.lexists(R(propuesto))
                bueno = (any(propuesto == b or propuesto.startswith(b) and '/' not in propuesto[len(b):] for b in BASES_DATOS)
                         and not prohibida(propuesto) and not os.path.islink(R(propuesto))
                         and (not existe or (ow and _dueno(R(propuesto)) == ow)))
                if not bueno:
                    raise Error('el perfil pone el directorio de datos en %s. Solo se acepta el de este equipo (%s) '
                                'o uno nuevo /var/lib/openwebrx… o /srv/openwebrx… del usuario openwebrx. '
                                'No lo importo (¿perfil manipulado?)' % (propuesto, data_dest))
                aviso('el perfil usa otro directorio de datos: %s (aquí era %s)' % (propuesto, data_dest))
                data_dest = propuesto
    htdocs_dest = eq['htdocs']
    md5_dest = eq['md5s']
    ver_dest = eq['openwebrx']
    plan, saltados = [], []
    for e in m['ficheros']:
        if e['nivel'] not in niveles:
            continue
        if a.sin_usuarios and e['ruta'] == '{DATA}/users.json':
            saltados.append((e['ruta'], 'sin usuarios (--sin-usuarios)'))
            continue
        if e['nivel'] == 'parches' and not ver_dest:
            saltados.append((e['ruta'], 'OpenWebRX+ aún no está instalado aquí: repite luego con --niveles parches'))
            continue
        if e['nivel'] == 'parches' and not a.forzar_parches and ver_dest != o['openwebrx']:
            saltados.append((e['ruta'], 'parche para %s y aquí hay %s (usa --forzar-parches)' % (o['openwebrx'], ver_dest)))
            continue
        dest = destino_de(e, eq, data_dest, htdocs_dest)
        if not permitido(e, dest, data_dest, htdocs_dest, md5_dest):
            saltados.append((e['ruta'], 'ruta no permitida para el nivel %s' % e['nivel']))
            continue
        if not camino_seguro(dest, base_de(e, data_dest, htdocs_dest)):
            raise Error('hay un enlace simbólico en el camino de %s: no importo nada por seguridad (revísalo a mano)' % dest)
        plan.append((e, dest))
    if not plan and any(e['nivel'] in niveles for e in m['ficheros']):
        raise Error('ningún fichero del perfil se puede aplicar aquí (mira los avisos de arriba)')

    # ---- 3. informe y confirmación ----
    print()
    if repo:
        print('  Repositorio de OpenWebRX+: %s' % repo[0])
    if instalar:
        print('  Paquetes a instalar (%d): %s' % (len(instalar), ', '.join(instalar)))
    elif 'paquetes' in niveles:
        print('  Paquetes: ya están todos')
    por = {}
    for e, d in plan:
        por.setdefault(e['nivel'], []).append(d)
    for n in NIVELES:
        if n in por:
            print('  %-9s %3d fichero(s) · %s' % (n, len(por[n]), DESC_NIVEL[n]))
            if a.simular or a.detalle:
                for d in por[n]:
                    gris(('(nuevo) ' if not os.path.exists(R(d)) else '') + d)
    for r, por_que in saltados:
        aviso('no se aplica %s: %s' % (r, por_que))
    mapas = [x.split('=>', 1) for x in a.mapear]
    if any(len(x) != 2 or not x[0] for x in mapas):
        raise Error('--mapear se escribe «VIEJO=>NUEVO», p. ej. --mapear "serial=00000101=>serial=12345678"')
    for viejo, nuevo in mapas:
        print('  dispositivo: «%s» → «%s»' % (viejo, nuevo))
    print('  Receptores del perfil:')
    for s in m['receptores']:
        print('    %-18s %-10s %s' % (s['nombre'][:18], s['tipo'], _mapear_texto(s['device'], mapas)))
    if 'web' in niveles and por.get('web'):
        aviso('Los plugins de la web son JavaScript que se ejecuta en el navegador de tus oyentes: importa solo perfiles de confianza.')
    if a.simular:
        print()
        info('Simulación: no se ha cambiado nada.')
        return 0
    if not a.si:
        if not sys.stdin.isatty():
            raise Error('falta confirmar: añade --si (o ejecútalo en un terminal)')
        if input('\n¿Aplicar el perfil? Se guarda antes una copia para «owrx-clone deshacer» [s/N] ').strip().lower() not in ('s', 'si', 'sí', 'y', 'yes'):
            info('Cancelado: no se ha cambiado nada.')
            return 1

    # ---- 4. paquetes ----
    if repo:
        info('Repositorio de OpenWebRX+')
        os.makedirs(R('/etc/apt/trusted.gpg.d'), exist_ok=True)
        _bajar(repo[1], '/etc/apt/trusted.gpg.d/openwebrx-plus.gpg')
        os.makedirs(R('/etc/apt/sources.list.d'), exist_ok=True)
        with open(R('/etc/apt/sources.list.d/openwebrx-plus.list'), 'w') as f:
            f.write(repo[0] + '\n')
        if repo[2]:
            os.makedirs(R('/usr/share/keyrings'), exist_ok=True)
            _bajar('https://repo.openwebrx.de/debian/key.gpg.txt', '/usr/share/keyrings/openwebrx.gpg')
            with open(R('/etc/apt/sources.list.d/openwebrx.list'), 'w') as f:
                f.write(repo[2] + '\n')
    if instalar:
        info('Paquetes')
        _apt_update()
        env = dict(os.environ, DEBIAN_FRONTEND='noninteractive')
        r = _apt_install(instalar, env)
        for p in r['fallidos']:
            aviso('no he podido instalar %s (¿no existe en este sistema?)' % p)
        if r['instalados']:
            bien('instalados: %s' % ', '.join(r['instalados']))
        if 'openwebrx' in instalar and 'openwebrx' in r['fallidos']:
            raise Error('no se ha podido instalar openwebrx: mira «apt-get install openwebrx»')
        eq2 = equipo()                   # el paquete recién instalado puede cambiar htdocs
        if eq2['htdocs'] != htdocs_dest:
            plan = [(e, destino_de(e, eq2, data_dest, eq2['htdocs'])) for e, _ in plan]
            htdocs_dest = eq2['htdocs']
        ver_dest = eq2['openwebrx']

    # ---- 5. copia previa (para deshacer): DESPUÉS de apt, así guarda también lo que trae el paquete ----
    copia = copia_previa([(d, base_de(e, data_dest, htdocs_dest)) for e, d in plan])
    bien('copia previa: %s' % copia)

    # ---- 6. ficheros: si algo falla a medias, se apunta lo creado y OpenWebRX+ vuelve a arrancar ----
    info('Ficheros')
    hay_servicio = bool(ver_dest) or SIMULAR_ORDENES
    if hay_servicio:
        servicio('stop')
    creados, hechos = [], 0
    dueno_data = _usuario('openwebrx')                     # los datos de OpenWebRX+ son del usuario openwebrx
    data_nuevo = not os.path.lexists(R(data_dest))
    if not _usuario('openwebrx'):
        aviso('no existe el usuario «openwebrx» (¿falta el paquete?): los datos quedan de root; al instalarlo: sudo chown -R openwebrx: %s' % data_dest)
    try:
        for e, d in plan:
            if not os.path.lexists(R(d)):
                creados.append(d)
            datos = open(os.path.join(tmp, e['arc']), 'rb').read()
            if d == data_dest + '/settings.json' and mapas:
                datos = _mapear_settings(datos, mapas)
            try:
                modo = int(e.get('modo', '0644'), 8)
            except ValueError:
                modo = 0o644
            if e['nivel'] == 'config':
                dueno = dueno_data
            elif e['nivel'] in ('etc', 'web', 'parches', 'sistema'):
                dueno = (0, 0)
            else:
                dueno = _usuario(e.get('dueno')) or (0, 0)
            escribir_seguro(d, datos, modo, dueno, base_de(e, data_dest, htdocs_dest))
            hechos += 1
        if data_nuevo and dueno_data and os.path.isdir(R(data_dest)):    # solo la carpeta que hemos creado nosotros
            _chown(R(data_dest), dueno_data)
    finally:
        _anotar_creados(copia, creados)
        if hechos < len(plan):
            aviso('la importación se ha cortado (%d de %d ficheros): sudo owrx-clone deshacer lo deja como antes' % (hechos, len(plan)))
            if hay_servicio and not a.no_arrancar:
                servicio('start', comprobar=False)
    bien('%d ficheros en su sitio (%d nuevos)' % (len(plan), len(creados)))
    if any(e['nivel'] == 'sistema' for e, _ in plan):
        ejecutar(['udevadm', 'control', '--reload'], comprobar=False)
        ejecutar(['udevadm', 'trigger'], comprobar=False)
        ejecutar(['systemctl', 'daemon-reload'], comprobar=False)
        aviso('Se han tocado reglas udev o módulos: si un SDR no aparece, desenchúfalo y vuelve a enchufarlo (o reinicia)')

    # ---- 7. arrancar y comprobar ----
    if not hay_servicio:
        aviso('OpenWebRX+ no está instalado: ficheros copiados, pero no hay servicio que arrancar (instálalo y: sudo systemctl start openwebrx)')
    elif a.no_arrancar:
        aviso('OpenWebRX+ queda parado (--no-arrancar): sudo systemctl start openwebrx')
    else:
        servicio('enable', comprobar=False)
        servicio('start')
        puerto = conf_openwebrx()['puerto']
        if esperar_web(puerto):
            bien('OpenWebRX+ responde en http://%s:%d/' % (_ip(), puerto))
        else:
            aviso('OpenWebRX+ no responde todavía en el puerto %d: journalctl -u openwebrx -n 50' % puerto)
    usuarios = R(data_dest + '/users.json')
    if 'config' in niveles and (not os.path.isfile(usuarios) or os.path.getsize(usuarios) < 5):
        aviso('No hay usuario de administración (perfil público o --sin-usuarios): sudo openwebrx admin adduser admin')
    _informe_dispositivos(m, mapas)
    if m.get('usuarios') and not a.sin_usuarios and 'config' in niveles:
        aviso('Los usuarios y contraseñas de administración son los del equipo de origen')
    if m['secretos'] == 'quitados':
        aviso('Perfil público: rellena las claves en Ajustes (%s)' % ', '.join(m.get('secretos_quitados', [])[:8]))
    for x in m.get('avisos', []):
        aviso(x)
    print()
    info('Hecho. Para volver atrás: sudo owrx-clone deshacer')
    return 0


def _apt_update():
    ejecutar(['apt-get', 'update'], timeout=900)


def _apt_install(paqs, env):
    hechos, malos = [], []
    base = ['apt-get', 'install', '-y', '--no-install-recommends', '-o', 'Dpkg::Options::=--force-confold']
    ORDENES.append(' '.join(base + paqs))
    if SIMULAR_ORDENES:
        return {'instalados': list(paqs), 'fallidos': []}
    r = subprocess.run(base + paqs, capture_output=True, text=True, env=env)
    if r.returncode == 0:
        return {'instalados': list(paqs), 'fallidos': []}
    for p in paqs:              # uno a uno: que un paquete que no existe aquí no tumbe a los demás
        rr = subprocess.run(base + [p], capture_output=True, text=True, env=env)
        (hechos if rr.returncode == 0 else malos).append(p)
    return {'instalados': hechos, 'fallidos': malos}


def _mapear_texto(t, mapas):
    for v, n in mapas:
        t = t.replace(v, n)
    return t


def _mapear_settings(datos, mapas):
    try:
        j = json.loads(datos)
    except ValueError:
        aviso('settings.json no es JSON: no aplico --mapear')
        return datos
    n = 0
    for s in (j.get('sdrs') or {}).values():
        if isinstance(s.get('device'), str):
            nuevo = _mapear_texto(s['device'], mapas)
            n += nuevo != s['device']
            s['device'] = nuevo
    bien('--mapear: %d dispositivo(s) cambiado(s) en settings.json' % n)
    return json.dumps(j, indent=4, ensure_ascii=False).encode()


def _usuario(nombre):
    try:
        p = pwd.getpwnam(nombre)
        return (p.pw_uid, p.pw_gid)
    except (KeyError, TypeError):
        return None


def _dueno(ruta):
    try:
        st = os.stat(ruta)
        return (st.st_uid, st.st_gid)
    except OSError:
        return None


def _chown(ruta, ug):
    if not ug:
        return
    try:
        os.chown(ruta, ug[0], ug[1])
    except (OSError, PermissionError):
        pass


def _ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(('192.0.2.1', 9))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return '127.0.0.1'


def servicio(accion, comprobar=True):
    ejecutar(['systemctl', accion, 'openwebrx'], comprobar=comprobar and accion != 'stop')


def esperar_web(puerto, segundos=60):
    if SIMULAR_ORDENES:
        return True
    fin = time.time() + segundos
    while time.time() < fin:
        try:
            urllib.request.urlopen('http://127.0.0.1:%d/status.json' % puerto, timeout=3).read()
            return True
        except OSError:
            time.sleep(2)
    return False


def _detectar_sdr():
    """Números de serie de los SDR conectados (SoapySDR y, si no, rtl_test)."""
    if SIMULAR_ORDENES:
        return set(filter(None, os.environ.get('OWRX_CLONE_SERIES', '').split(','))), True
    for orden in (['SoapySDRUtil', '--find'], ['rtl_test', '-t']):
        if shutil.which(orden[0]):
            try:
                r = subprocess.run(orden, capture_output=True, text=True, timeout=25)
                txt = r.stdout + r.stderr
                return set(re.findall(r'serial\s*[=:]\s*([^\s,]+)', txt, re.I) + re.findall(r'SN:\s*(\S+)', txt)), True
            except (OSError, subprocess.TimeoutExpired):
                pass
    return set(), False


def _informe_dispositivos(m, mapas):
    series, pude = _detectar_sdr()
    if not pude:
        aviso('No puedo listar los SDR (falta SoapySDRUtil): revisa los receptores en Ajustes → SDR')
        return
    faltan = []
    for s in m['receptores']:
        dev = _mapear_texto(s['device'], mapas)
        mm = re.search(r'serial=([^,\s]+)', dev)
        serie = mm.group(1) if mm else (dev if re.fullmatch(r'[0-9A-Za-z]{6,}', dev) else None)
        if s['activo'] and serie and serie not in series:
            faltan.append('%s (%s)' % (s['nombre'], serie))
    if faltan:
        aviso('SDR del perfil que no veo conectados: %s. Si son otros, usa --mapear "serial=VIEJO=>serial=NUEVO" '
              'o cámbialos en Ajustes → SDR' % ', '.join(faltan))
    else:
        bien('los SDR con número de serie del perfil están conectados')


