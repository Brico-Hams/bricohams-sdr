# =====================================================================
#  bricohams.env · EA5KAO · BricoHams · Mi QTH (Región de Murcia)
#  PLANTILLA SIN CLAVES. Cópiala a bricohams.env y rellena las claves:
#     cp bricohams.env.example bricohams.env && nano bricohams.env
#  bricohams.env está en .gitignore: NUNCA se sube al git.
# =====================================================================

# --- Estación -------------------------------------------------------
CALLSIGN="EA5KAO"
STATION_LAT="0.0"
STATION_LON="0.0"
STATION_ASL="200"
ADMIN_EMAIL="ae5kao@ea5rcz.es"
OWRX_ADMIN_USER="pi"            # usuario admin de OpenWebRX (si no se restaura users.json, pide contraseña)
HOSTNAME_NEW=""                   # nuevo nombre de la Raspberry en la red ("" = dejar el actual, p. ej. "sdr")

# --- Red WiFi de casa (la Pi prefiere la de 5 GHz; el iGate ESP32 solo ve 2,4 GHz) ---
WIFI_COUNTRY="ES"
WIFI_SSID_1="BiohazardIT-5G"
WIFI_SSID_2="biohazard-it"
WIFI_PASS=""

# --- Claves (las de tu instalación actual) ---------------------------
MAGIC_KEY=""
RECEIVERBOOK_KEY=""
OPENWEATHERMAP_KEY=""
APRS_PASSCODE=""
AEMET_API_KEY=""                  # gratis en https://opendata.aemet.es/centrodedescargas/altaUsuario

# --- SDR ---------------------------------------------------------------
# Series que se graban en cada RTL-SDR con: sudo bricohams-sdr-serials --grabar
SERIAL_HAT="00000101"             # RTL-SDR del HAT HackerGadgets (R860, TCXO) -> SATÉLITES
SERIAL_MINI="00000102"            # Mini RTL-SDR HackerGadgets (R860, TCXO)    -> RADIOAFICIONADOS
SERIAL_V3="00000103"              # RTL-SDR Blog V3 (R820T2)                    -> MULTIPERFIL + HF (muestreo directo)
SERIAL_ADSB="00001090"            # FlightStick de AirNav RadarBox (LNA + filtro 1090) -> ADS-B (fuera de OpenWebRX)
SAT_BIAS_TEE="no"                 # "yes" para alimentar el LNA de satélites por el coaxial (bias-tee 5 V del HAT)
# SDRplay: cuando llegue, pon las dos en "yes" y lanza: sudo bash install.sh --solo sdrplay,configuracion
HF_SDRPLAY="no"                   # "yes": la HF pasa del V3 al SDRplay
INSTALL_SDRPLAY_API="no"
SDRPLAY_ANTENNA=""                # vacío en RSP1A/RSP1B; "Antenna A", "Antenna B" o "Antenna C" en un RSPdx
SDRPLAY_API_URL="https://www.sdrplay.com/software/SDRplay_RSP_API-Linux-3.15.2.run"
PI5_USB_MAX_CURRENT="no"          # "yes" solo con la fuente oficial de 27 W (5 V 5 A). En la caja, los SDR van al hub alimentado

# --- ADS-B (FlightStick de RadarBox) · readsb + rbfeeder + MLAT -------
ADSB_ENABLE="yes"
ADSB_ANT_ALT="205"                # altura de la ANTENA sobre el nivel del mar (m), para MLAT
ADSB_BIAS_TEE="no"                # el FlightStick lleva LNA y filtro internos: no hace falta
ADSB_GAIN="auto"
ADSB_TAR1090="yes"                # mapa propio de aviones en http://<pi>/tar1090
RADARBOX_KEY=""                   # vacío = se genera uno nuevo; para recuperar el tuyo: sudo rbfeeder --showkey

# --- HAT HackerGadgets RTL-SDR/LoRa/GPS/RTC ---------------------------
# Valores de la guía oficial de HackerGadgets para su placa AIO (mismos
# módulos). A VERIFICAR con la documentación del HAT cuando llegue:
# si algo no arranca, cámbialo aquí y vuelve a lanzar: sudo bash install.sh --solo hat,meshtastic
HAT_RTC="pcf85063a"
HAT_DISABLE_PI5_RTC="yes"         # usa el RTC del HAT (tiene pila) en lugar del de la Pi 5
HAT_GPS_DEV="/dev/ttyAMA0"        # UART0 (GPIO 14/15) de la Pi 5
HAT_GPS_BAUD="9600"
HAT_PPS_GPIO="6"
HAT_LORA_SPI="spi1"               # spi1 (overlay spi1-1cs) o spi0
HAT_LORA_SPIDEV="spidev1.0"
HAT_LORA_IRQ="26"
HAT_LORA_BUSY="24"
HAT_LORA_RESET="25"
HAT_LORA_TXEN=""
HAT_LORA_RXEN=""
HAT_POWER_GPIOS=""                # GPIO a poner en alto al arrancar si el HAT tiene interruptores de módulos (p. ej. "27 16 7")

# --- Meshtastic (LoRa del HAT, 868) -------------------------------------
# Configuración con TODOS los canales (QR de la red): SFNarrow (principal), Murcia,
# Cartagena, Test y Alicante; radio EU_868 a 869,618 MHz, BW 62,5 kHz, SF7, CR 4/5,
# saltos 3. Las claves son las públicas por defecto (no es secreto).
MESH_CHANNEL_URL="https://meshtastic.org/e/#Cg8SAQEaCFNGTmFycm93OgAKEhIBARoGTXVyY2lhJQEAAAA6AAoVEgEBGglDYXJ0YWdlbmElAgAAADoAChISAQIaBFRlc3QlAwAAADoCEAEKFBIBARoIQWxpY2FudGUlBAAAADoAEhUYPiAHKAU4A0ADSAFQG2gBdY1nWUQ"
MESH_REGION="EU_868"              # solo se usa si MESH_CHANNEL_URL está vacío
# Canal privado SOLO en el nodo 868 (el 433 no lo lleva). Clave AES-256 en base64 (32 bytes): SECRETO
MESH868_PRIVATE_NAME="BricoHams"
MESH868_PRIVATE_PSK=""
MESH_LONG_NAME="EA5KAO BricoHams Mi QTH"
MESH_SHORT_NAME="BH5K"

# --- LilyGO T3 V1.6.1 (LoRa32 V2.1_1.6, 433 MHz) por USB a la Pi ------
LILYGO_WIFI_SSID="biohazard-it"            # el ESP32 solo usa 2,4 GHz: la red sin "-5G"
LILYGO_WIFI_PASS=""
# Nodo Meshtastic 433
MESH433_LONG_NAME="EA5KAO BricoHams 433"
MESH433_SHORT_NAME="BH43"
MESH433_ROLE="CLIENT"
MESH433_CHANNELS="yes"            # "yes": mismos canales que el nodo 868 (MESH_CHANNEL_URL) pero con radio EU_433 LONG_FAST
# iGate LoRa APRS (firmware CA2RXU/richonguzman), solo recepción
IGATE_CALLSIGN="EA5KAO-10"
IGATE_COMMENT="LoRa APRS iGate BricoHams · Mi QTH (Murcia)"
IGATE_APRSIS_SERVER="euro.aprs2.net"
IGATE_WEB_PASS=""                 # contraseña de la web del iGate (usuario admin); vacío = sin contraseña

# --- Sensor BME280/BMP280 (I2C de la Pi) y estación WX APRS -------------
WX_ENABLE="yes"
WX_SENSOR_HEIGHT="2"              # altura del sensor sobre el suelo (m), para reducir la presión al nivel del mar
WX_TEMP_OFFSET="0.0"              # corrección de temperatura (°C) si la garita lo necesita
WX_APRS="yes"                     # publica el tiempo en APRS-IS (aprs.fi) cada 10 min
WX_APRS_CALLSIGN="EA5KAO-13"
WX_APRS_COMMENT="WX BricoHams Mi QTH · BME280"

# --- v3 · Viento y lluvia (estación WX en la Pi) ---------------------------
WIND_ENABLE="yes"                 # anemómetro + veleta RS485 Modbus (kit de CA2RXU), 10–30 V del bus de 12 V
WIND_PORT="/dev/rs485"            # nombre fijo que crea el instalador para el adaptador USB-RS485
RS485_VID="1a86"                  # CH340 (1a86:7523). FTDI: 0403 / 6001
RS485_PID="7523"
WIND_BAUD="4800"
WIND_ADDR_SPEED="1"               # dirección Modbus del anemómetro
WIND_ADDR_DIR="2"                 # dirección Modbus de la veleta (cambiarla de 1 a 2: manual 19)
WIND_DIR_MODE="sector8"           # sector8: la veleta da 0–7 (×45°). grados: da 0–359
RAIN_ENABLE="yes"                 # pluviómetro de cazoleta con reed (Misol WH-SP-RG)
RAIN_GPIO="17"                    # pin 11 de la cabecera
RAIN_MM="0.2794"                  # mm por vuelco (0,3537 en otros modelos)

# --- v3 · Alternativa: estación WX LoRa en un 3.er LilyGO (firmware de CA2RXU) -----
# sudo bricohams-lilygo wxstation /dev/ttyUSB0   (manual 19). Si los sensores van al
# LilyGO, pon WIND_ENABLE="no" y RAIN_ENABLE="no" arriba: el bus RS485 tiene un solo maestro.
WXLORA_CALLSIGN="EA5KAO-14"
WXLORA_POWER="17"                 # dBm (433,775 MHz, SF12)
WXLORA_BME280="yes"
WXLORA_BH1750="no"                # sensor de luz opcional
WXLORA_WIND="yes"
WXLORA_RAIN="yes"
WXLORA_COMMENT="WX LoRa BricoHams"

# --- v3 · Ventilación de la caja ---------------------------------------------
FAN_ENABLE="yes"
FAN_PWM_GPIOS="12,13"             # pin 32 (entrada) y pin 33 (salida): PWM por hardware
FAN_TACH_GPIOS="22,5"             # pin 15 y pin 29: tacómetros (pull-up a 3,3 V)
FAN_PWM_INVERT="yes"              # "yes" con el MOSFET 2N7002 del esquema 13 (invierte la señal)
W1_GPIO="4"                       # pin 7: DS18B20 del interior de la caja
FAN_T_CPU_MIN="55"                # °C de CPU a los que arrancan
FAN_T_CPU_MAX="75"                # °C de CPU a los que van al 100 %
FAN_T_CAJA_MIN="35"               # °C del aire de la caja a los que arrancan
FAN_T_CAJA_MAX="45"
FAN_DUTY_MIN="30"                 # % mínimo (por debajo se paran)
FAN_HIST="3"                      # histéresis en °C
FAN_DS18B20_ID=""                 # vacío = el primer DS18B20 que aparezca

# --- v3 · Cámara: CSI (rpi) o cámara IP (rtsp) ------------------------------
CAM_SOURCE="rpi"                  # rpi = WPI408/Camera Module por CSI · rtsp = cámara IP (recomendada en el mástil)
CAM_RTSP_URL=""                   # p. ej. rtsp://usuario:clave@192.168.1.60:554/h264Preview_01_main (lleva clave: solo en bricohams.env)

# --- Cámara del mástil (Whadda/Velleman WPI408: OV5647 + 2 IR) ----------
CAM_WIDTH="1280"
CAM_HEIGHT="720"
CAM_FPS="10"                      # la Pi 5 no tiene codificador H.264 por hardware: se codifica por CPU
CAM_BITRATE="1500000"
CAM_HFLIP="false"
CAM_VFLIP="false"
CAM_TUNING=""                     # si los colores de día salen rosados (sin filtro IR): /usr/share/libcamera/ipa/rpi/pisp/ov5647_noir.json
CAM_SNAPSHOT_SECONDS="60"
CAM_LABEL="EA5KAO · Mi QTH (Murcia) · BricoHams"

# --- Meteo -------------------------------------------------------------
# Estaciones AEMET (indicativo:nombre), de la más cercana a la más lejana
METEO_STATIONS="7158X:Archena,7237E:Molina de Segura (Los Valientes),7228:Alcantarilla Base Aérea,7178I:Murcia"
